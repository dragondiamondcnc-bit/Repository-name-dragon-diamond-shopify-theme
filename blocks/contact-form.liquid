
{% capture submit_button %}
  {% content_for 'block', type: 'contact-form-submit-button', id: 'submit-button' %}
{% endcapture %}

<div
  class="
    contact-form
    spacing-style size-style
    {% if block.settings.inherit_color_scheme == false %}color-{{ block.settings.color_scheme }}{% endif %}
  "
  style="
    {% render 'spacing-style', settings: block.settings %}
    {% render 'size-style', settings: block.settings %}
  "
  {{ block.shopify_attributes }}
>
  {% assign form_id = block.id | default: section.id | prepend: 'ContactForm-' %}
  <script>
    if (new URLSearchParams(window.location.search).get('contact_posted') === 'true') {
      document.currentScript.parentElement.classList.add('contact-form--posted');
    }
  </script>

  <div class="contact-form__confirmation" aria-live="polite">
    <span class="contact-form__confirmation-eyebrow">INQUIRY RECEIVED</span>
    <h2 class="contact-form__confirmation-heading">Inquiry Submitted Successfully</h2>
    <div class="contact-form__confirmation-copy">
      <p>Thank you for your project inquiry.</p>
      <p>Our engineering team has received your requirements and will review your application details.</p>
      <p>We will contact you within 24–48 hours with the next steps.</p>
    </div>

    <div class="contact-form__status">
      <h3>PROJECT INQUIRY STATUS</h3>
      <dl>
        <div>
          <dt>STATUS</dt>
          <dd>RECEIVED</dd>
        </div>
        <div>
          <dt>NEXT STEP</dt>
          <dd>Engineering Review</dd>
        </div>
        <div>
          <dt>RESPONSE TIME</dt>
          <dd>24–48 Hours</dd>
        </div>
      </dl>
    </div>

    <div class="contact-form__confirmation-actions">
      <a class="button contact-form__confirmation-primary" href="{{ routes.root_url }}">
        Explore Production Systems <span aria-hidden="true">&rarr;</span>
      </a>
      <a
        class="contact-form__confirmation-whatsapp"
        href="https://wa.me/YOUR_NUMBER"
        target="_blank"
        rel="noopener noreferrer"
      >
        Contact via WhatsApp <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>

  <h2 class="contact-form__heading">Discuss Your Production Project</h2>

  {%- form 'contact', id: form_id, class: 'contact-form__form' -%}
    <input
      name="contact[id]"
      type="hidden"
      value="{{ form_id }}"
    >

    {%- if form.errors and form.id == form_id -%}
      <div
        class="contact-form__error"
        tabindex="-1"
        autofocus
      >
        {{- 'icon-error.svg' | inline_asset_content -}}

        {{- form.errors.translated_fields.email | capitalize }}
        {{ form.errors.messages.email -}}
      </div>
    {%- endif -%}

    {%- if form.posted_successfully? -%}
      <div
        class="contact-form__success"
        tabindex="-1"
        autofocus
      >
        {{- 'icon-checkmark.svg' | inline_asset_content -}}
        <div>
          <p>Thank you for your project inquiry.</p>
          <p>Our engineering team will review your requirements and contact you within 24-48 hours.</p>
          <p>For urgent questions, you can also contact us directly via WhatsApp.</p>
        </div>
      </div>
    {%- endif -%}

    <div class="contact-form__form-row">
      <label class="visually-hidden" for="ContactForm-name">{{ 'blocks.contact_form.name' | t }}</label>
      <input type="text" id="ContactForm-name" class="contact-form__input" autocomplete="name" name="contact[name]" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" placeholder="Your name *">

      <label class="visually-hidden" for="ContactForm-email">{{ 'blocks.contact_form.email' | t }}</label>
      <input type="email" id="ContactForm-email" class="contact-form__input" autocomplete="email" name="contact[email]" spellcheck="false" autocapitalize="off" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" aria-required="true" placeholder="Business email address *">
    </div>

    <div class="contact-form__form-row">
      <label class="visually-hidden" for="ContactForm-company">Company Name</label>
      <input type="text" id="ContactForm-company" class="contact-form__input" autocomplete="organization" name="contact[company]" placeholder="Company / organization">

      <label class="visually-hidden" for="ContactForm-country">Country / Region</label>
      <input type="text" id="ContactForm-country" class="contact-form__input" autocomplete="country-name" name="contact[country]" placeholder="Project country / region *">
    </div>

    <div class="contact-form__form-row">
      <label class="visually-hidden" for="ContactForm-phone">{{ 'blocks.contact_form.phone' | t }}</label>
      <input type="tel" id="ContactForm-phone" class="contact-form__input" autocomplete="tel" name="contact[phone]" value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}" placeholder="Phone / WhatsApp number with country code *">

      <label class="visually-hidden" for="ContactForm-system">Interested System</label>
      <select id="ContactForm-system" class="contact-form__input" name="contact[Interested System]">
        <option value="" disabled selected>Interested system</option>
        <option value="Laser Cutting System">Laser Cutting System</option>
        <option value="Laser Engraving System">Laser Engraving System</option>
        <option value="Laser Marking System">Laser Marking System</option>
        <option value="Laser Welding System">Laser Welding System</option>
        <option value="Customized Automation System">Customized Automation System</option>
        <option value="Not Sure - Engineering Advice Needed">Not Sure - Engineering Advice Needed</option>
      </select>
    </div>

    <label class="visually-hidden" for="ContactForm-application">Main Application</label>
    <select id="ContactForm-application" class="contact-form__input" name="contact[Main Application]">
      <option value="" disabled selected>Main application / production process</option>
      <option value="Cutting">Cutting</option>
      <option value="Engraving">Engraving</option>
      <option value="Marking and Coding">Marking and Coding</option>
      <option value="Welding">Welding</option>
      <option value="Cleaning">Cleaning</option>
      <option value="Other">Other</option>
    </select>

    <label class="visually-hidden" for="ContactForm-material-thickness">Material &amp; Thickness</label>
    <textarea rows="4" id="ContactForm-material-thickness" class="contact-form__input contact-form__input--textarea" name="contact[Material and Thickness]" placeholder="Material &amp; thickness (for example: 3 mm stainless steel, 10 mm acrylic, or 18 mm MDF)"></textarea>

    <label class="visually-hidden" for="ContactForm-body">{{ 'blocks.contact_form.comment' | t }}</label>
    <textarea rows="6" id="ContactForm-body" class="contact-form__input contact-form__input--textarea" name="contact[body]" placeholder="Describe your production requirements, target output, part dimensions, tolerances, and project timeline">{{- form.body -}}</textarea>

    {{ submit_button }}
  {%- endform -%}
</div>

{% stylesheet %}
  .contact-form__confirmation {
    display: none;
  }

  .contact-form--posted .contact-form__confirmation {
    display: block;
  }

  .contact-form--posted > .contact-form__heading,
  .contact-form--posted > .contact-form__form {
    display: none;
  }

  .contact-form__confirmation-eyebrow {
    display: block;
    margin-block-end: var(--gap-sm);
    color: var(--color-foreground);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .contact-form__confirmation-heading {
    margin: 0;
    max-width: 14ch;
  }

  .contact-form__confirmation-copy {
    margin-block-start: var(--gap-lg);
    max-width: 42rem;
  }

  .contact-form__confirmation-copy p {
    margin: 0;
  }

  .contact-form__confirmation-copy p + p {
    margin-block-start: var(--gap-sm);
  }

  .contact-form__status {
    margin-block-start: var(--gap-xl);
    border: 1px solid var(--color-border);
  }

  .contact-form__status h3 {
    margin: 0;
    padding: var(--padding-md) var(--padding-lg);
    border-block-end: 1px solid var(--color-border);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
  }

  .contact-form__status dl {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
  }

  .contact-form__status dl > div {
    min-width: 0;
    padding: var(--padding-lg);
  }

  .contact-form__status dl > div + div {
    border-inline-start: 1px solid var(--color-border);
  }

  .contact-form__status dt {
    margin-block-end: var(--gap-xs);
    color: var(--color-foreground);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .contact-form__status dd {
    margin: 0;
    overflow-wrap: anywhere;
    font-weight: 600;
  }

  .contact-form__confirmation-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-lg);
    align-items: center;
    margin-block-start: var(--gap-xl);
  }

  .contact-form__confirmation-primary {
    --button-color: #0f1115;
    --button-background-color: #00a3ad;
    --button-border-color: #00a3ad;

    text-decoration: none;
  }

  .contact-form__confirmation-primary:hover {
    --button-color: #ffffff;
    --button-background-color: #007e86;
    --button-border-color: #007e86;
  }

  .contact-form__confirmation-whatsapp {
    color: inherit;
    font-weight: 600;
    text-underline-offset: 0.3em;
  }

  .contact-form__heading {
    margin-block: 0 var(--gap-lg);
  }

  .contact-form__form {
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
  }

  .contact-form__form-row {
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);

    @media screen and (min-width: 750px) {
      flex-direction: row;
      align-items: center;
    }
  }

  .contact-form__input {
    width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--color-input-text);
    background-color: var(--color-input-background);
    padding: var(--padding-lg) var(--padding-xl);
    border-radius: var(--style-border-radius-inputs);
    border: var(--style-border-width-inputs) solid var(--color-input-border);
    -webkit-font-smoothing: antialiased;
  }
  
  select.contact-form__input {
    appearance: none;
    background-image: url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='16' height='16' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M4 6l4 4 4-4'/%3E%3C/svg%3E");
    background-repeat: no-repeat;
    background-position: right 1rem center;
    padding-right: 2.5rem;
  }

  .contact-form__input--textarea {
    resize: vertical;
    min-height: var(--input-textarea-min-height);
  }

  .contact-form__error,
  .contact-form__success {
    display: flex;
    align-items: flex-start;
    gap: var(--gap-xs);
  }

  .contact-form__success p {
    margin: 0;
  }

  .contact-form__success p + p {
    margin-block-start: var(--gap-xs);
  }

  @media screen and (max-width: 749px) {
    .contact-form__status dl {
      grid-template-columns: 1fr;
    }

    .contact-form__status dl > div + div {
      border-block-start: 1px solid var(--color-border);
      border-inline-start: 0;
    }

    .contact-form__confirmation-actions {
      align-items: stretch;
      flex-direction: column;
    }

    .contact-form__confirmation-primary {
      width: 100%;
      white-space: normal;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.contact_form",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width_desktop",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fit-content"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "t:settings.width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:settings.width_mobile",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fit-content"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "t:settings.width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "t:settings.inherit_color_scheme",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1",
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.contact_form",
      "category": "t:categories.forms"
    }
  ]
}
{% endschema %}
