{% liquid
assign form_id = 'Co2Inquiry-' | append: section.id
assign machine_names = 'LZ-1390 for acrylic and wood,LZ-1816L for printed fabrics and textiles' | split: ','
assign featured_handles = 'lz-1390-industrial-co2-laser-cutting-machine,lz-1816l-panoramic-vision-fabric-laser-cutting-machine' | split: ','

%}<div class="dd-co2"><section class="dd-co2__hero"><div class="dd-co2__wrap"><nav class="dd-co2__crumb" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a><span>/</span><span>CO2 Laser Cutting Machines</span></nav><div class="dd-co2__split"><div><p class="dd-co2__eyebrow">SELECT BY MATERIAL &amp; PRODUCTION NEED</p><h1>CO2 Laser Cutting Machines for Acrylic, Wood &amp; Fabric</h1><p class="dd-co2__lead">Choose a cutting setup for signs and crafts, or panoramic vision cutting for printed textiles. Compare the LZ-1390 and LZ-1816L, then confirm your application with a free sample test.</p><div class="dd-co2__actions"><a class="dd-co2__button" href="#Co2Machines">Explore the Machines</a><a href="#Co2Contact">Get Equipment Advice →</a></div><p class="dd-co2__note">CO2 equipment manufacturing · Sample testing · Training &amp; technical support</p></div><figure><img src="{{ 'lz-1390-cutout-v1.png' | asset_url }}" width="1000" height="1000" loading="eager" fetchpriority="high" alt="LZ-1390 CO2 laser cutting machine"><figcaption>LZ-1390 for signs, display components and suitable wood-based crafts.</figcaption></figure></div></div></section>
<section class="dd-co2__section"><div class="dd-co2__wrap"><h2>Start with what you want to make</h2><div class="dd-co2__two"><div class="dd-co2__panel"><h3>Acrylic signs &amp; wooden crafts</h3><p>Evaluate the LZ-1390 for rigid sheet-material work. Match the power and optional features to your material, thickness and finished part.</p><a href="#Model1390">Explore LZ-1390 →</a></div><div class="dd-co2__panel"><h3>Printed fabric &amp; textile panels</h3><p>Evaluate the LZ-1816L for panoramic vision contour cutting and conveyor handling. Review roll feeding needs separately.</p><a href="#Model1816">Explore LZ-1816L →</a></div></div></div></section>
<section class="dd-co2__section dd-co2__tint" id="Co2Machines"><div class="dd-co2__wrap"><h2>Compare Our Featured CO2 Laser Cutters</h2><div class="dd-co2__grid co2-machines">{% for handle in featured_handles %}{% assign machine = all_products[handle] %}{% if machine != blank %}<article class="dd-co2__card" id="{% if forloop.first %}Model1390{% else %}Model1816{% endif %}"><a href="{{ machine.url }}">{% if forloop.first %}<img src="{{ 'lz-1390-cutout-v1.png' | asset_url }}" width="1000" height="1000" loading="lazy" alt="LZ-1390 CO2 laser cutting machine">{% else %}{{ machine.featured_image | image_url: width: 850 | image_tag: loading: 'lazy', alt: machine.featured_image.alt }}{% endif %}</a><div class="dd-co2__body">{% if forloop.first %}<p class="co2-need">SIGNS · DISPLAYS · CRAFTS</p><h3 class="co2-model">LZ-1390</h3><p>CO2 laser cutting for acrylic and suitable wood-based materials.</p><ul class="co2-specs"><li>150W CO2 laser.</li><li>Blade table and S&amp;A CW5200 chiller.</li><li>Optional camera, lifting platform and rotary attachment.</li></ul>{% else %}<p class="co2-need">PRINTED FABRICS · TEXTILE PANELS</p><h3 class="co2-model">LZ-1816L</h3><p>Panoramic vision fabric cutting with dual-track asynchronous heads.</p><ul class="co2-specs"><li>1800 × 1600 mm · 150W × 2.</li><li>Panoramic vision and conveyor table included.</li><li>Separate automatic roll fabric feeder optional.</li></ul>{% endif %}<a class="dd-co2__button" href="{{ machine.url }}">View Machine &amp; Get a Quote</a></div></article>{% endif %}{% endfor %}</div></div></section>
<section class="dd-co2__section"><div class="dd-co2__wrap"><h2>Key Configuration Differences</h2><p>Compare the production roles first. The configuration with more power or more heads is not automatically the best choice for your job.</p><div class="dd-co2__compare" tabindex="0" role="region" aria-label="Machine comparison. Scroll horizontally on small screens."><table><caption>Standard configurations and main options</caption><thead><tr><th scope="col">Selection point</th><th scope="col">LZ-1390</th><th scope="col">LZ-1816L</th></tr></thead><tbody><tr><th scope="row">Main application</th><td>Acrylic signs, display components and wood-based crafts</td><td>Printed fabric panels and suitable textile components</td></tr><tr><th scope="row">Laser power</th><td>150W</td><td>150W × 2</td></tr><tr><th scope="row">Cutting setup</th><td>CO2 laser cutting; optional camera for printed contours</td><td>Dual-track asynchronous heads with panoramic vision</td></tr><tr><th scope="row">Standard table</th><td>Blade table</td><td>Conveyor feeding table</td></tr><tr><th scope="row">Camera positioning</th><td>Optional camera</td><td>Panoramic vision included</td></tr><tr><th scope="row">Main options</th><td>Camera, lifting platform, rotary attachment</td><td>Separate automatic roll fabric feeder</td></tr><tr><th scope="row">Selection details</th><td>Material, thickness, part size and required finish</td><td>Fabric composition, print layout, panel size and roll handling</td></tr></tbody></table></div><p class="dd-co2__note">Final accessories and supplied configuration are specified in your quotation. Printed designs require a suitable positioning workflow; printing is a separate process.</p></div></section>
<section class="dd-co2__section dd-co2__tint"><div class="dd-co2__wrap"><h2>Explore Applications &amp; Cutting Samples</h2><div class="dd-co2__grid"><article class="dd-co2__card">{{ images['laser-sample-acrylic-letters.jpg'] | image_url: width: 650 | image_tag: loading: 'lazy', alt: 'Acrylic letters cut for signage applications' }}<div class="dd-co2__body"><h3>Acrylic letters and signage</h3><a href="{{ routes.root_url }}pages/industry-sign">Explore the Application →</a></div></article><article class="dd-co2__card">{{ images['laser-sample-wood-dice-panels.jpg'] | image_url: width: 650 | image_tag: loading: 'lazy', alt: 'Cut wooden dice panels before assembly' }}<div class="dd-co2__body"><h3>Wood-based craft components</h3><a href="{{ routes.root_url }}pages/industry-crafts">Explore the Application →</a></div></article><article class="dd-co2__card">{{ images['lz-1816l-printed-garment-panels.jpg'] | image_url: width: 650 | image_tag: loading: 'lazy', alt: 'Printed garment panels on a laser conveyor table' }}<div class="dd-co2__body"><h3>Printed fabric panels</h3><a href="{{ routes.root_url }}pages/industry-textile">Explore the Application →</a></div></article></div><p class="dd-co2__note">Material composition, coatings, artwork and required edge finish must be assessed. These sample images do not guarantee results for every material.</p></div></section>
{% if collection.products_count > 2 %}<section class="dd-co2__section"><div class="dd-co2__wrap"><h2>More CO2 Laser Cutting Machines</h2>{% paginate collection.products by 24 %}<div class="dd-co2__grid co2-additional">{% for machine in collection.products %}{% unless featured_handles contains machine.handle %}<article class="dd-co2__card"><a href="{{ machine.url }}">{{ machine.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: machine.featured_image.alt }}<div class="dd-co2__body"><h3>{{ machine.title | escape }}</h3><span>View Machine →</span></div></a></article>{% endunless %}{% endfor %}</div>{{ paginate | default_pagination }}{% endpaginate %}</div></section>{% endif %}
<section class="dd-co2__section"><div class="dd-co2__wrap dd-co2__split"><div><h2>Confirm the machine with a sample test</h2><p>Send material details, artwork, finished dimensions and your output target. We review the job, test a sample and recommend the equipment and options around the result.</p><p>English manuals, videos, remote installation training, equipment-specific spare parts and technical support are available. On-site support can be arranged. Delivery timing is agreed for each order.</p><a class="dd-co2__button" href="#Co2Contact">Request a Free Sample Test</a></div><div class="dd-co2__faq"><h2>CO2 Laser Selection Questions</h2><details><summary>Which CO2 laser should I choose for acrylic or wood crafts?</summary><p>Start with the LZ-1390 for acrylic signage, display components and suitable wood-based crafts. Share material composition, thickness and part dimensions so we can confirm the configuration through a sample test.</p></details><details><summary>Which model is designed for printed fabric cutting?</summary><p>The LZ-1816L combines a 1800 × 1600 mm working area, 150W × 2 heads, panoramic vision and a conveyor table. It is designed around fabric cutting and printed-pattern contour positioning.</p></details><details><summary>Is camera positioning standard on both models?</summary><p>No. The LZ-1390 camera is optional. Panoramic vision is included on the LZ-1816L. Match the camera workflow to the actual artwork and material during testing.</p></details><details><summary>Is automatic roll feeding included with the LZ-1816L?</summary><p>The conveyor feeding table is standard. The separate automatic roll fabric feeder is optional. Your quotation states the feeding equipment and accessories included.</p></details><details><summary>Can you test my material before I choose a machine?</summary><p>Yes. We provide a free sample test. Send material composition, thickness or fabric details, artwork, finished dimensions and output requirements. Any sample shipping is agreed separately.</p></details></div></div></section>  <section class="dd-co2__section" id="Co2Contact"><div class="dd-co2__wrap dd-co2__split"><div><p class="dd-co2__eyebrow">TELL US WHAT YOU WANT TO MAKE</p><h2>Get an equipment proposal for your CO2 laser application</h2><p>Share your material, thickness, finished size and production requirements. We will help you plan the equipment and a free sample test.</p><p><a href="mailto:info@gzcnc-laser.com">info@gzcnc-laser.com</a><br><a href="https://wa.me/8618988946615">WhatsApp: +86 189 8894 6615</a></p><p class="dd-co2__note">Need to share artwork or photos? Send them by email or WhatsApp. Name, email and message are required.</p></div>
    {% form 'contact', id: form_id %}
      <input type="hidden" name="contact[Source]" value="CO2 laser cutting machine category">
      {% if form.posted_successfully? %}<div class="dd-co2__success" role="status" tabindex="-1" data-co2-success><strong>Thank you — your inquiry has been sent.</strong><p>Our team will review your requirements and contact you by email. You do not need to submit the same inquiry again.</p></div><dialog data-co2-dialog aria-labelledby="Co2SuccessTitle"><h2 id="Co2SuccessTitle">Inquiry sent successfully</h2><p>Thank you for contacting Dragon Diamond. Our team will review your requirements and contact you by email.</p><button type="button" class="dd-co2__button" data-co2-close>Got it</button></dialog>{% endif %}
      {% if form.errors %}<div role="alert">{{ form.errors | default_errors }}</div>{% endif %}
      <div class="dd-co2__fields"><div><label for="SignName-{{ section.id }}">Name *</label><input id="SignName-{{ section.id }}" name="contact[name]" autocomplete="name" value="{{ form.name | escape }}" required></div><div><label for="SignEmail-{{ section.id }}">Email *</label><input id="SignEmail-{{ section.id }}" name="contact[email]" type="email" autocomplete="email" value="{{ form.email | escape }}" required></div><div><label for="SignCompany-{{ section.id }}">Company</label><input id="SignCompany-{{ section.id }}" name="contact[Company]" autocomplete="organization" value="{{ form.Company | escape }}"></div><div><label for="SignWA-{{ section.id }}">WhatsApp</label><input id="SignWA-{{ section.id }}" name="contact[WhatsApp]" type="tel" autocomplete="tel" value="{{ form.WhatsApp | escape }}"></div></div>
      <label for="SignProduct-{{ section.id }}">Product Interested</label><select id="SignProduct-{{ section.id }}" name="contact[Product Interested]"><option>CO2 laser selection / need advice</option>{% for name in machine_names %}<option>{{ name }}</option>{% endfor %}<option>Other CO2 cutting requirements</option></select>
      <label for="SignMessage-{{ section.id }}">Message *</label><textarea id="SignMessage-{{ section.id }}" name="contact[body]" rows="5" placeholder="Material, thickness, finished size, production needs and destination country..." required>{{ form.body | escape }}</textarea><button type="submit" class="dd-co2__button">Send Inquiry</button>
    {% endform %}
  </div></section></div>
<script type="application/ld+json">{"@context":"https://schema.org","@type":"CollectionPage","@id":{{ canonical_url | append: '#collection' | json }},"url":{{ canonical_url | json }},"name":{{ collection.title | json }},"description":{{ collection.description | strip_html | json }}}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":{{ request.origin | append: routes.root_url | json }}},{"@type":"ListItem","position":2,"name":{{ collection.title | json }},"item":{{ canonical_url | json }}}]}</script>{% stylesheet %}
.dd-co2{color:#163237;background:#fff;font-family:Arial,sans-serif;font-size:17px;line-height:1.65}.dd-co2 *{box-sizing:border-box}.dd-co2__wrap{max-width:1280px;margin:auto;padding:0 32px}.dd-co2__section{padding:76px 0}.dd-co2__tint{background:#eff5f4}.dd-co2__hero{background:#14373b;color:#fff;padding:135px 0 64px}.dd-co2__crumb{display:flex;gap:12px;flex-wrap:wrap;font-size:13px;margin-bottom:44px}.dd-co2 .dd-co2__hero a{color:#80e0d7}.dd-co2__split{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:start}.dd-co2__hero .dd-co2__split{align-items:center}.dd-co2 h1,.dd-co2 h2,.dd-co2 h3{font-family:var(--font-heading--family,Arial,sans-serif);color:inherit;letter-spacing:-.025em;line-height:1.16;margin:0 0 20px}.dd-co2 h1{font-size:clamp(36px,3.4vw,54px)}.dd-co2 h2{font-size:clamp(28px,2.6vw,38px)}.dd-co2 h3{font-size:23px;margin-bottom:14px}.dd-co2 p{margin:0 0 20px}.dd-co2__eyebrow{font-size:12px;font-weight:700;letter-spacing:2px;color:#087d83}.dd-co2__hero .dd-co2__eyebrow{color:#80e0d7}.dd-co2__lead{font-size:19px}.dd-co2__intro{max-width:800px}.dd-co2__actions{display:flex;align-items:center;gap:22px;flex-wrap:wrap;margin:28px 0}.dd-co2 a{color:#08777b;text-underline-offset:4px}.dd-co2__button{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:13px 20px;background:#087c80;color:#fff!important;border:0;border-radius:4px;font:700 15px/1.4 Arial,sans-serif;text-decoration:none;cursor:pointer;text-align:center}.dd-co2__hero .dd-co2__button{background:#74dfd3;color:#10383b!important}.dd-co2 figure{margin:0}.dd-co2 img{display:block;width:100%;height:auto}.dd-co2__hero img{aspect-ratio:4/3;object-fit:cover;border-radius:10px}.dd-co2 figcaption,.dd-co2__note{font-size:14px;margin-top:18px!important}.dd-co2__hero figcaption{color:#c4dcde}.dd-co2__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;margin-top:30px}.dd-co2__two{display:grid;grid-template-columns:1fr 1fr;gap:26px;margin-top:30px}.dd-co2__card{border:1px solid #d6e2e2;border-radius:8px;overflow:hidden;background:#fff;display:flex;flex-direction:column}.dd-co2__card img{aspect-ratio:16/10;object-fit:cover}.dd-co2__body{padding:24px;flex:1;display:flex;flex-direction:column}.dd-co2__body>a:last-child{margin-top:auto}.dd-co2__body ul{padding-left:20px;margin:0 0 24px;font-size:15px}.dd-co2__machine>a{background:#e8f0ef}.dd-co2__machine img{object-fit:contain;padding:18px;aspect-ratio:4/3}.dd-co2__panel{padding:26px;background:#fff;border-radius:8px;border-top:3px solid #087f82}.dd-co2__panel p{margin:0}.dd-co2__steps{list-style:none;margin:0;padding:0;border-left:2px solid #83c9c5}.dd-co2__steps li{padding:0 0 20px 26px}.dd-co2__steps li:last-child{padding-bottom:0}.dd-co2__steps h3{font-size:21px}.dd-co2__faq details{border-bottom:1px solid #b9cecc}.dd-co2__faq summary{padding:18px 0;min-height:48px;cursor:pointer;font-weight:700}.dd-co2__faq details p{padding:0 0 16px}.dd-co2__fields{display:grid;grid-template-columns:1fr 1fr;gap:0 18px}.dd-co2 label{display:block;margin-bottom:6px;font-size:15px;font-weight:700}.dd-co2 input,.dd-co2 textarea,.dd-co2 select{display:block;width:100%;max-width:100%;min-height:48px;padding:12px;border:1px solid #a8c0c0;border-radius:4px;background:#fff;color:#163237;font:16px/1.4 Arial,sans-serif;margin-bottom:18px}.dd-co2 textarea{resize:vertical}.dd-co2 [id]{scroll-margin-top:125px}.dd-co2 :focus-visible{outline:3px solid #d18b24;outline-offset:4px}.dd-co2__success{padding:20px;background:#e0f5ee;border:2px solid #087c80;margin-bottom:24px;border-radius:6px}.dd-co2 dialog{max-width:520px;width:calc(100% - 32px);padding:30px;border:0;border-radius:10px;color:#163237}.dd-co2 dialog::backdrop{background:#082429b3}.dd-co2__two img{object-fit:contain;background:#edf3f2}.dd-co2 a{overflow-wrap:anywhere}@media(max-width:899px){.dd-co2__wrap{padding:0 22px}.dd-co2__split{grid-template-columns:1fr;gap:32px}.dd-co2__grid{grid-template-columns:1fr}.dd-co2__section{padding:48px 0}.dd-co2__hero{padding-top:105px}.dd-co2__crumb{margin-bottom:28px}.dd-co2__hero img{aspect-ratio:16/10}.dd-co2__machine img{max-height:310px}.dd-co2__two{grid-template-columns:1fr}.dd-co2__body{padding:22px}.dd-co2__actions{align-items:flex-start;flex-direction:column}.dd-co2__fields{grid-template-columns:1fr}}
.dd-co2__compare{overflow-x:auto}.dd-co2 table{width:100%;border-collapse:collapse;font-size:16px}.dd-co2 th,.dd-co2 td{text-align:left;vertical-align:top;border:1px solid #c3d4d4;padding:16px}.dd-co2 th{background:#edf4f3}.dd-co2 .co2-machines{grid-template-columns:repeat(2,minmax(0,1fr))}.dd-co2 .co2-machines img{height:330px;object-fit:contain;padding:18px;background:#edf3f3}.dd-co2 .dd-co2__hero img{aspect-ratio:4/3;object-fit:contain}.dd-co2 .co2-model{font-size:28px;margin-bottom:12px}.dd-co2 .co2-need{font-weight:700;color:#087f82}.dd-co2 .co2-specs{font-size:15px}.dd-co2 .co2-additional{grid-template-columns:repeat(3,minmax(0,1fr))}@media(max-width:700px){.dd-co2 .co2-machines,.dd-co2 .co2-additional{grid-template-columns:1fr}.dd-co2 table{min-width:610px}.dd-co2 .co2-machines img{height:290px}}{% endstylesheet %}
{% javascript %}
function initCo2Feedback(){document.querySelectorAll('[data-co2-dialog]').forEach(dialog=>{if(dialog.dataset.ready)return;dialog.dataset.ready='true';const status=dialog.closest('form').querySelector('[data-co2-success]');dialog.querySelector('[data-co2-close]').addEventListener('click',()=>dialog.close());dialog.addEventListener('close',()=>status.focus());if(typeof dialog.showModal==='function')dialog.showModal();else status.focus();});}
initCo2Feedback();document.addEventListener('shopify:section:load',initCo2Feedback);
{% endjavascript %}
