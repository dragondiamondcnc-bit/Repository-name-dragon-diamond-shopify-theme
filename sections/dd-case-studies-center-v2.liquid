{% assign form_id = 'CaseIndexInquiry-' | append: section.id %}{% assign machine_names = 'CO2 Laser Cutting Machine,CNC Router,Custom Equipment Proposal' | split: ',' %}<div class="dd-caseview dd-caseindex"><section class="dd-caseview__hero"><div class="dd-caseview__wrap"><p class="dd-caseview__eyebrow">CUSTOMER PROJECTS · DRAGON DIAMOND</p><h1>Laser Cutting &amp; CNC Router Customer Case Studies</h1><p class="dd-caseview__lead">Explore customer projects in signage, event decoration and furniture production. See application photographs, factory visits, equipment preparation and delivery records from Uganda, Ethiopia, Israel and Georgia.</p><div class="dd-caseview__actions"><a class="dd-caseview__button" href="#CaseviewContact">Discuss Your Project</a><a href="#customer-projects">Explore Customer Projects →</a></div></div></section><section class="dd-caseview__section" id="customer-projects"><div class="dd-caseview__wrap"><h2>Find a project related to your application</h2><div class="caseindex-filters" aria-label="Filter customer cases by application"><button type="button" data-case-filter="all" aria-pressed="true">All Projects</button><button type="button" data-case-filter="signage" aria-pressed="false">Signage</button><button type="button" data-case-filter="display" aria-pressed="false">Event Decoration</button><button type="button" data-case-filter="furniture" aria-pressed="false">Furniture</button></div><p class="dd-caseview__note" data-case-count aria-live="polite">4 customer projects</p><div class="caseindex-grid"><article class="caseindex-card" data-case-group="signage"><a href="{{ routes.root_url }}pages/case-uganda-sign-factory" aria-label="Read Uganda customer case"><img src="{{ 'case-evidence-A6f78a48ea0b94f928b5b9aad833cd2a87.jpg' | asset_img_url: '800x' }}" width="800" height="800" loading="lazy" alt="Namirembe Pharmacy signage in Uganda" ></a><div class="caseindex-content"><p class="dd-caseview__eyebrow">Uganda · Signage</p><h3><a href="{{ routes.root_url }}pages/case-uganda-sign-factory">Acrylic signage for schools and businesses</a></h3><p><strong>Project equipment:</strong> LZ-1390 CO2 laser</p><p>Factory discussions, equipment preparation and customer-shared signage projects.</p><a class="dd-caseview__button" href="{{ routes.root_url }}pages/case-uganda-sign-factory">View Case Study</a><div class="caseindex-links"><a href="{{ routes.root_url }}pages/industry-sign">Industry Solution →</a><a href="{{ routes.root_url }}products/lz-1390-industrial-co2-laser-cutting-machine">Current Equipment →</a></div></div></article><article class="caseindex-card" data-case-group="signage"><a href="{{ routes.root_url }}pages/case-study-ethiopia" aria-label="Read Ethiopia customer case"><img src="{{ 'ethiopia-customer-storefront-sign.png' | asset_img_url: '800x' }}" width="800" height="800" loading="lazy" alt="Customer storefront signage in Ethiopia" ></a><div class="caseindex-content"><p class="dd-caseview__eyebrow">Ethiopia · Signage</p><h3><a href="{{ routes.root_url }}pages/case-study-ethiopia">Sign-making equipment, training and delivery</a></h3><p><strong>Project equipment:</strong> CO2 laser + CNC router</p><p>Factory demonstrations, operator training and customer-observed container loading.</p><a class="dd-caseview__button" href="{{ routes.root_url }}pages/case-study-ethiopia">View Case Study</a><div class="caseindex-links"><a href="{{ routes.root_url }}pages/industry-sign">Industry Solution →</a><a href="{{ routes.root_url }}products/lz-1390-industrial-co2-laser-cutting-machine">Current Equipment →</a></div></div></article><article class="caseindex-card" data-case-group="display"><a href="{{ routes.root_url }}pages/case-study-israel" aria-label="Read Israel customer case"><img src="{{ 'israel-application-bat-mitzvah.jpg' | asset_img_url: '800x' }}" width="800" height="800" loading="lazy" alt="Customer event decoration installation in Israel" style="object-position:center 25%"></a><div class="caseindex-content"><p class="dd-caseview__eyebrow">Israel · Event decoration</p><h3><a href="{{ routes.root_url }}pages/case-study-israel">Decorative panels for themed events</a></h3><p><strong>Project equipment:</strong> LZ-1325 CNC router</p><p>From factory sample review to printed-panel processing and finished event installations.</p><a class="dd-caseview__button" href="{{ routes.root_url }}pages/case-study-israel">View Case Study</a><div class="caseindex-links"><a href="{{ routes.root_url }}pages/industry-display">Industry Solution →</a><a href="{{ routes.root_url }}products/lz-1325-cnc-router">Current Equipment →</a></div></div></article><article class="caseindex-card" data-case-group="furniture"><a href="{{ routes.root_url }}pages/case-study-georgia" aria-label="Read Georgia customer case"><img src="{{ 'case-evidence-georgia-product-cart.jpg' | asset_img_url: '800x' }}" width="800" height="800" loading="lazy" alt="Decorated wooden storage cart shared by the Georgia customer" ></a><div class="caseindex-content"><p class="dd-caseview__eyebrow">Georgia · Furniture</p><h3><a href="{{ routes.root_url }}pages/case-study-georgia">Custom wood products and a repeat equipment order</a></h3><p><strong>Project equipment:</strong> Custom CNC router</p><p>Machine preparation, customer furniture applications and a later expansion order.</p><a class="dd-caseview__button" href="{{ routes.root_url }}pages/case-study-georgia">View Case Study</a><div class="caseindex-links"><a href="{{ routes.root_url }}pages/industry-furniture">Industry Solution →</a><a href="{{ routes.root_url }}products/lz-1325-cnc-router">Current Equipment →</a></div></div></article></div><p class="dd-caseview__note">Case photographs show historical customer projects. Equipment and accessories may differ from current standard configurations. Confirm materials, options and final specifications for your own order.</p></div></section><section class="dd-caseview__section dd-caseview__tint"><div class="dd-caseview__wrap"><h2>From a customer example to your own equipment plan</h2><div class="dd-caseview__grid"><div class="dd-caseview__panel"><h3>1. Share your application</h3><p>Send your materials, dimensions, artwork and production requirements.</p></div><div class="dd-caseview__panel"><h3>2. Review the process</h3><p>Discuss suitable equipment and request a free sample test on your material.</p></div><div class="dd-caseview__panel"><h3>3. Confirm your configuration</h3><p>Agree equipment options, packing, delivery and technical support in your quotation.</p></div></div><p><a href="#CaseviewContact">Request a Free Sample Test →</a></p></div></section><section class="dd-caseview__section" id="CaseviewContact"><div class="dd-caseview__wrap dd-caseview__split"><div><p class="dd-caseview__eyebrow">TELL US WHAT YOU WANT TO MAKE</p><h2>Get an equipment proposal for your production project</h2><p>Share your material, thickness, finished size and production requirements. We will help you plan the equipment and a free sample test.</p><p><a href="mailto:info@gzcnc-laser.com">info@gzcnc-laser.com</a><br><a href="https://wa.me/8618988946615">WhatsApp: +86 189 8894 6615</a></p><p class="dd-caseview__note">Need to share artwork or photos? Send them by email or WhatsApp. Name, email and message are required.</p></div>
    {% form 'contact', id: form_id %}<p class="dd-caseview__note">This inquiry relates to {{ page.title | escape }}.</p>
      <input type="hidden" name="contact[Source]" value="Customer case study">
      {% if form.posted_successfully? %}<div class="dd-caseview__success" role="status" tabindex="-1" data-caseview-success><strong>Thank you — your inquiry has been sent.</strong><p>Our team will review your requirements and contact you by email. You do not need to submit the same inquiry again.</p></div><dialog data-caseview-dialog aria-labelledby="CaseviewSuccessTitle"><h2 id="CaseviewSuccessTitle">Inquiry sent successfully</h2><p>Thank you for contacting Dragon Diamond. Our team will review your requirements and contact you by email.</p><button type="button" class="dd-caseview__button" data-caseview-close>Got it</button></dialog>{% endif %}
      {% if form.errors %}<div role="alert">{{ form.errors | default_errors }}</div>{% endif %}
      <div class="dd-caseview__fields"><div><label for="CaseviewName-{{ section.id }}">Name *</label><input id="CaseviewName-{{ section.id }}" name="contact[name]" autocomplete="name" value="{{ form.name | escape }}" required></div><div><label for="CaseviewEmail-{{ section.id }}">Email *</label><input id="CaseviewEmail-{{ section.id }}" name="contact[email]" type="email" autocomplete="email" value="{{ form.email | escape }}" required></div><div><label for="CaseviewCompany-{{ section.id }}">Company</label><input id="CaseviewCompany-{{ section.id }}" name="contact[Company]" autocomplete="organization" value="{{ form.Company | escape }}"></div><div><label for="CaseviewWA-{{ section.id }}">WhatsApp</label><input id="CaseviewWA-{{ section.id }}" name="contact[WhatsApp]" type="tel" autocomplete="tel" value="{{ form.WhatsApp | escape }}"></div></div>
      <label for="CaseviewProduct-{{ section.id }}">Product Interested</label><select id="CaseviewProduct-{{ section.id }}" name="contact[Product Interested]"><option>Similar project / need advice</option>{% for name in machine_names %}<option>{{ name }}</option>{% endfor %}<option>Other production requirements</option></select>
      <label for="CaseviewMessage-{{ section.id }}">Message *</label><textarea id="CaseviewMessage-{{ section.id }}" name="contact[body]" rows="5" placeholder="Material, part size, application, equipment requirements and destination country..." required>{{ form.body | escape }}</textarea><button type="submit" class="dd-caseview__button">Send Inquiry</button>
    {% endform %}
