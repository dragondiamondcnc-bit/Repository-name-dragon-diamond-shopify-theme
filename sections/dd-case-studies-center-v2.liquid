function initCaseviewFeedback(){document.querySelectorAll('[data-caseview-dialog]').forEach(dialog=>{if(dialog.dataset.ready)return;dialog.dataset.ready='true';const status=dialog.closest('form').querySelector('[data-caseview-success]');dialog.querySelector('[data-caseview-close]').addEventListener('click',()=>dialog.close());dialog.addEventListener('close',()=>status.focus());if(typeof dialog.showModal==='function')dialog.showModal();else status.focus();});}
initCaseviewFeedback();document.addEventListener('shopify:section:load',initCaseviewFeedback);

document.querySelectorAll('.dd-caseindex').forEach(root=>{root.querySelectorAll('[data-case-filter]').forEach(button=>button.addEventListener('click',()=>{const selected=button.dataset.caseFilter;root.querySelectorAll('[data-case-filter]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));let count=0;root.querySelectorAll('[data-case-group]').forEach(card=>{card.hidden=selected!=='all'&&card.dataset.caseGroup!==selected;if(!card.hidden)count++;});root.querySelector('[data-case-count]').textContent=count+' customer project'+(count===1?'':'s');}));});
