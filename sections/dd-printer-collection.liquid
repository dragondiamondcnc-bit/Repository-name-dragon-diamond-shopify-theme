<div class="dd-printer-category"><div class="dd-printer-category__wrap"><nav aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a> / <span>{{ collection.title | escape }}</span></nav><h1>{{ collection.title | escape }}</h1><div class="rte">{{ collection.description }}</div><nav class="dd-printer-category__types" aria-label="Printer categories"><a href="{{ routes.collections_url }}/printers">All Printers</a><a href="{{ routes.collections_url }}/uv-flatbed-printers">UV Flatbed Printers</a></nav>{% paginate collection.products by 12 %}<div class="dd-printer-category__grid">{% for product in collection.products %}<article><a href="{{ product.url }}">{% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'eager', widths: '400, 600, 900', sizes: '(min-width: 900px) 33vw, 100vw', alt: product.featured_image.alt }}{% endif %}<h2>{{ product.title | escape }}</h2></a><p>{{ product.description | split: '</p>' | first | strip_html }}</p><a class="dd-printer-category__button" href="{{ product.url }}">View Product &amp; Get a Quote</a></article>{% endfor %}</div>{{ paginate | default_pagination }}{% endpaginate %}<section class="dd-uv-category-samples"><h2>UV Printing Applications &amp; Samples</h2><p>Explore material and design ideas for your printing project.</p><div class="dd-uv-sample-grid"><figure><a href="{{ 'uv-print-sample-wood.png' | asset_url }}" target="_blank" rel="noopener" aria-label="View Wood printing sample"><img src="{{ 'uv-print-sample-wood.png' | asset_img_url: '700x' }}" width="1254" height="1254" loading="lazy" alt="Colorful animal artwork printed on a wood panel"></a><figcaption><h3>Wood</h3></figcaption></figure><figure><a href="{{ 'uv-print-sample-leather.png' | asset_url }}" target="_blank" rel="noopener" aria-label="View Leather printing sample"><img src="{{ 'uv-print-sample-leather.png' | asset_img_url: '700x' }}" width="1254" height="1254" loading="lazy" alt="Mountain landscape artwork on a leather notebook cover"></a><figcaption><h3>Leather</h3></figcaption></figure><figure><a href="{{ 'uv-print-sample-stainless-steel.png' | asset_url }}" target="_blank" rel="noopener" aria-label="View Stainless Steel printing sample"><img src="{{ 'uv-print-sample-stainless-steel.png' | asset_img_url: '700x' }}" width="1254" height="1254" loading="lazy" alt="Colorful landscape designs on stainless steel drinkware"></a><figcaption><h3>Stainless Steel</h3><p>Curved items require confirmation of compatible accessories and the printing method.</p></figcaption></figure><figure><a href="{{ 'uv-print-sample-phone-case.png' | asset_url }}" target="_blank" rel="noopener" aria-label="View Phone Cases printing sample"><img src="{{ 'uv-print-sample-phone-case.png' | asset_img_url: '700x' }}" width="1254" height="1254" loading="lazy" alt="Coastal landscape artwork on a phone case"></a><figcaption><h3>Phone Cases</h3></figcaption></figure><figure><a href="{{ 'uv-print-sample-acrylic.png' | asset_url }}" target="_blank" rel="noopener" aria-label="View Acrylic printing sample"><img src="{{ 'uv-print-sample-acrylic.png' | asset_img_url: '700x' }}" width="1254" height="1254" loading="lazy" alt="Colorful racing car artwork on an acrylic display panel"></a><figcaption><h3>Acrylic</h3></figcaption></figure><figure><a href="{{ 'uv-print-sample-ballpoint-pens.png' | asset_url }}" target="_blank" rel="noopener" aria-label="View ballpoint pen printing sample"><img src="{{ 'uv-print-sample-ballpoint-pens.png' | asset_img_url: '700x' }}" width="1448" height="1086" loading="lazy" alt="Colorful ballpoint pens with printed logos and promotional designs"></a><figcaption><h3>Ballpoint Pens</h3><p>Confirm pen dimensions, positioning fixtures and the printable area with a sample test.</p></figcaption></figure></div><p class="dd-uv-sample-note">Application examples. Confirm ink adhesion, surface preparation and the required finish with a sample test on your actual material. Images do not define the standard machine configuration.</p><p><a href="{{ routes.root_url }}products/lz-6090uv-uv-flatbed-printer">Explore LZ-6090UV &amp; Request a Sample Test →</a></p></section><aside><h2>Plan Your Printing Setup</h2><p>Send your substrate, artwork, print size and production requirements. We provide free sample testing and help select the appropriate configuration.</p><a class="dd-printer-category__button" href="https://wa.me/8618988946615">Discuss Your Application</a><p><a href="mailto:info@gzcnc-laser.com">info@gzcnc-laser.com</a></p></aside></div></div>
<script type="application/ld+json">{"@context":"https://schema.org","@type":"CollectionPage","name":{{ collection.title | json }},"url":{{ canonical_url | json }},"description":{{ collection.description | strip_html | json }}}</script>
<script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":{{ request.origin | json }}},{"@type":"ListItem","position":2,"name":"Printers","item":{{ request.origin | append: '/collections/printers' | json }}}{% if collection.handle != 'printers' %},{"@type":"ListItem","position":3,"name":{{ collection.title | json }},"item":{{ canonical_url | json }}}{% endif %}]}</script>
{% stylesheet %}
.dd-printer-category{padding:145px 0 70px;background:#eff4f3;color:#183234;line-height:1.65;font-family:Arial,sans-serif}.dd-printer-category__wrap{max-width:1240px;margin:auto;padding:0 28px}.dd-printer-category h1{font-size:clamp(34px,4vw,52px);line-height:1.15;margin:28px 0}.dd-printer-category a{color:inherit}.dd-printer-category__types{display:flex;flex-wrap:wrap;gap:12px;margin:32px 0}.dd-printer-category__types a{padding:10px 16px;border:1px solid #829e9f;border-radius:4px}.dd-printer-category__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}.dd-printer-category article{padding:24px;background:white;border-radius:8px;display:flex;flex-direction:column}.dd-printer-category article>a{text-decoration:none}.dd-printer-category article img{width:100%;height:320px;object-fit:contain}.dd-printer-category h2{font-size:23px;line-height:1.3}.dd-printer-category article p{flex:1}.dd-printer-category .dd-printer-category__button{display:inline-block;padding:14px 20px;background:#0b666b;color:white;border-radius:4px;text-decoration:none;font-weight:700}.dd-printer-category aside{margin-top:50px;padding:32px;background:#dfeae8}.dd-printer-category :focus-visible{outline:3px solid #007e83;outline-offset:4px}@media(max-width:749px){.dd-printer-category{padding-top:110px}.dd-printer-category__wrap{padding:0 20px}.dd-printer-category__grid{grid-template-columns:1fr}.dd-printer-category article img{height:300px}.dd-printer-category aside{padding:24px}.dd-printer-category__button{box-sizing:border-box;width:100%;text-align:center}}
.dd-uv-sample-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;margin:24px 0}.dd-uv-sample-grid figure{margin:0;min-width:0}.dd-uv-sample-grid img{display:block;width:100%;height:auto;aspect-ratio:1;object-fit:contain;border-radius:8px}.dd-uv-sample-grid h3{font-size:19px;margin:12px 0 6px}.dd-uv-sample-grid p,.dd-uv-sample-note{font-size:14px;line-height:1.6}.dd-uv-sample-grid a:focus-visible{outline:3px solid #00858a;outline-offset:3px}.dd-uv-category-samples{margin-top:48px}@media(max-width:749px){.dd-uv-sample-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:18px 12px}.dd-uv-sample-grid h3{font-size:17px}}{% endstylesheet %}
