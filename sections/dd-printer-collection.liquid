{% javascript %}
function initPrintselectFeedback(){document.querySelectorAll('[data-printselect-dialog]').forEach(dialog=>{if(dialog.dataset.ready)return;dialog.dataset.ready='true';const status=dialog.closest('form').querySelector('[data-printselect-success]');dialog.querySelector('[data-printselect-close]').addEventListener('click',()=>dialog.close());dialog.addEventListener('close',()=>status.focus());if(typeof dialog.showModal==='function')dialog.showModal();else status.focus();});}
initPrintselectFeedback();document.addEventListener('shopify:section:load',initPrintselectFeedback);
