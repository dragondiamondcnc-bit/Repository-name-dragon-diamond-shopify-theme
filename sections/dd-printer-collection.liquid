{% if collection.handle == 'printers' %}
{% liquid
assign form_id = 'PrintselectInquiry-' | append: section.id
assign machine_names = 'LZ-6090UV UV Flatbed Printer' | split: ','
assign machine = all_products['lz-6090uv-uv-flatbed-printer']
%}<div class="dd-printselect"><section class="dd-printselect__hero"><div class="dd-printselect__wrap"><nav class="dd-printselect__crumb" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a><span>/</span><span>Printers</span></nav><div class="dd-printselect__split"><div><p class="dd-printselect__eyebrow">MATCH THE PRINTING SETUP TO YOUR PRODUCTS</p><h1>Printing Equipment for Signs, Displays &amp; Personalized Products</h1><p class="dd-printselect__lead">Explore the LZ-6090UV flatbed printer for your material, artwork and production needs. Confirm the printhead and ink configuration through sample testing.</p><div class="dd-printselect__actions"><a class="dd-printselect__button" href="{{ machine.url }}">View LZ-6090UV</a><a href="#PrintselectContact">Get Printing Advice →</a></div><p class="dd-printselect__note">600 × 900 mm print area · Printhead options · Free sample testing</p></div><figure>{{ machine.featured_image | image_url: width: 1000 | image_tag: widths: '400,700,1000', sizes: '(min-width:900px) 46vw, 100vw', loading: 'eager', fetchpriority: 'high', alt: 'LZ-6090UV flatbed printer for signs and personalized products' }}<figcaption>LZ-6090UV. Final printhead, ink and accessory configuration is confirmed in your quotation.</figcaption></figure></div></div></section>
<section class="dd-printselect__section"><div class="dd-printselect__wrap"><h2>What do you want to print?</h2><div class="dd-printselect__grid"><article class="dd-printselect__panel"><h3>Signs & display panels</h3><p>Plan artwork for acrylic signs and display panels. Check the item size, viewing side and color or white-ink requirements.</p></article><article class="dd-printselect__panel"><h3>Personalized gifts</h3><p>Discuss designs for phone cases, leather covers, pens and keepsakes. Confirm the substrate, printable area and positioning.</p></article><article class="dd-printselect__panel"><h3>Decorative products</h3><p>Review artwork for wood panels and other decorative surfaces. Use your actual material to assess preparation and the required finish.</p></article></div></div></section>
<section class="dd-printselect__section dd-printselect__tint"><div class="dd-printselect__wrap"><p class="dd-printselect__eyebrow">FEATURED MODEL</p><h2>LZ-6090UV: configure around the print job</h2><div class="dd-printselect__grid"><article class="dd-printselect__panel"><h3>600 × 900 mm</h3><p>Confirm the print area and full item dimensions, including room needed for positioning fixtures.</p></article><article class="dd-printselect__panel"><h3>XP600 / I1600 / I3200</h3><p>Choose the printhead setup around your artwork, production target and required finish.</p></article><article class="dd-printselect__panel"><h3>Ink & accessories</h3><p>Confirm ink channels, white-ink layers, surface preparation and any item-specific accessories in the quotation.</p></article></div><p><a class="dd-printselect__button" href="{{ machine.url }}">View Specifications &amp; Get a Quote</a></p></div></section>
<section class="dd-printselect__section"><div class="dd-printselect__wrap"><h2>UV Printing Applications &amp; Samples</h2><p>Explore printing ideas for six materials and product types.</p><div class="dd-uv-sample-grid"><figure><a href="{{ 'uv-print-sample-wood.png' | asset_url }}" target="_blank" rel="noopener" aria-label="View Wood printing sample"><img src="{{ 'uv-print-sample-wood.png' | asset_img_url: '700x' }}" width="1254" height="1254" loading="lazy" alt="Colorful animal artwork printed on a wood panel"></a><figcaption><h3>Wood</h3><p>Print colorful artwork on wooden signs, decorative panels and personalized gifts. Confirm the surface finish and preparation with your actual wood sample.</p></figcaption></figure><figure><a href="{{ 'uv-print-sample-leather.png' | asset_url }}" target="_blank" rel="noopener" aria-label="View Leather printing sample"><img src="{{ 'uv-print-sample-leather.png' | asset_img_url: '700x' }}" width="1254" height="1254" loading="lazy" alt="Mountain landscape artwork on a leather notebook cover"></a><figcaption><h3>Leather</h3><p>Add custom artwork to notebook covers, accessories and leather gifts. Test ink adhesion and flexibility on the selected leather before production.</p></figcaption></figure><figure><a href="{{ 'uv-print-sample-stainless-steel.png' | asset_url }}" target="_blank" rel="noopener" aria-label="View Stainless Steel printing sample"><img src="{{ 'uv-print-sample-stainless-steel.png' | asset_img_url: '700x' }}" width="1254" height="1254" loading="lazy" alt="Colorful landscape designs on stainless steel drinkware"></a><figcaption><h3>Stainless Steel</h3><p>Create personalized designs on stainless steel drinkware and gifts. Curved items require confirmation of compatible accessories and the printing method.</p></figcaption></figure><figure><a href="{{ 'uv-print-sample-phone-case.png' | asset_url }}" target="_blank" rel="noopener" aria-label="View Phone Cases printing sample"><img src="{{ 'uv-print-sample-phone-case.png' | asset_img_url: '700x' }}" width="1254" height="1254" loading="lazy" alt="Coastal landscape artwork on a phone case"></a><figcaption><h3>Phone Cases</h3><p>Print photos, patterns and branding on phone cases for personalized gifts and merchandise. Confirm the case material, shape and positioning fixture.</p></figcaption></figure><figure><a href="{{ 'uv-print-sample-acrylic.png' | asset_url }}" target="_blank" rel="noopener" aria-label="View Acrylic printing sample"><img src="{{ 'uv-print-sample-acrylic.png' | asset_img_url: '700x' }}" width="1254" height="1254" loading="lazy" alt="Colorful racing car artwork on an acrylic display panel"></a><figcaption><h3>Acrylic</h3><p>Print colorful artwork on acrylic signs, display panels and keepsakes. Confirm the viewing side, ink layers and required finish through sample testing.</p></figcaption></figure><figure><a href="{{ 'uv-print-sample-ballpoint-pens.png' | asset_url }}" target="_blank" rel="noopener" aria-label="View ballpoint pen printing sample"><img src="{{ 'uv-print-sample-ballpoint-pens.png' | asset_img_url: '700x' }}" width="1448" height="1086" loading="lazy" alt="Colorful ballpoint pens with printed logos and promotional designs"></a><figcaption><h3>Ballpoint Pens</h3><p>Add logos and promotional designs to ballpoint pens. Confirm pen dimensions, positioning fixtures and the printable area with a sample test.</p></figcaption></figure></div><p class="dd-uv-sample-note">Application examples. Confirm ink adhesion, surface preparation and the required finish with a sample test on your actual material. Images do not define the standard machine configuration.</p></div></section>
<section class="dd-printselect__section dd-printselect__tint"><div class="dd-printselect__wrap"><h2>Four details for a useful printing proposal</h2><div class="dd-printselect__two"><article class="dd-printselect__panel"><h3>01 · Material & surface</h3><p>Specify the substrate, existing coating and finish. Sample testing checks ink adhesion and preparation needs.</p></article><article class="dd-printselect__panel"><h3>02 · Item size & shape</h3><p>Send the item dimensions, printable area and photos. Identify curved surfaces or parts that need positioning fixtures.</p></article><article class="dd-printselect__panel"><h3>03 · Artwork & appearance</h3><p>Provide representative artwork and explain color, white layers, viewing side and finish requirements.</p></article><article class="dd-printselect__panel"><h3>04 · Output & installation</h3><p>Share quantities, production schedule, destination and site electrical supply so the proposal covers equipment and support.</p></article></div><p><a class="dd-printselect__button" href="#PrintselectContact">Request a Free Sample Test</a></p></div></section>
<section class="dd-printselect__section"><div class="dd-printselect__wrap dd-printselect__split"><div><h2>Plan the complete production process</h2><p>For printed signs and displays, coordinate printing with material preparation, cutting and assembly.</p><p><a href="{{ routes.root_url }}pages/industry-sign">Signage Production →</a><br><a href="{{ routes.root_url }}pages/industry-display">Display Production →</a><br><a href="{{ routes.root_url }}pages/industry-crafts">Crafts &amp; Personalized Products →</a></p><p>We provide English manuals and videos, remote training, equipment-specific spare parts and technical support. On-site support can be arranged. Delivery timing is agreed for each order.</p></div><div class="dd-printselect__faq"><h2>Printing Equipment Questions</h2><details><summary>What is the LZ-6090UV printing area?</summary><p>The printing area is 600 × 900 mm. Share the complete item dimensions and required print area so we can check placement and any fixture requirements.</p></details><details><summary>Which printhead should I choose?</summary><p>XP600, I1600 and I3200 options are available. The recommended printhead count and ink-channel configuration depend on the artwork, output target and required finish. Confirm the setup in your quotation.</p></details><details><summary>Can it print on all the materials shown?</summary><p>The samples illustrate application ideas. Test ink adhesion, surface preparation and finish on your actual substrate. Curved drinkware and small items such as pens require confirmation of the printing method and compatible fixtures or accessories.</p></details><details><summary>Can it print on transparent acrylic?</summary><p>A suitable white-ink configuration supports layered printing on transparent panels. Confirm the viewing side, color and white layer order, and required appearance during sample testing.</p></details><details><summary>How do I request a sample test and equipment proposal?</summary><p>Send your artwork, substrate, item dimensions, print area and production requirements. We offer free sample testing; sample shipping is agreed separately. The quotation defines printheads, ink configuration, accessories, delivery and support.</p></details></div></div></section>
  <section class="dd-printselect__section" id="PrintselectContact"><div class="dd-printselect__wrap dd-printselect__split"><div><p class="dd-printselect__eyebrow">TELL US WHAT YOU WANT TO MAKE</p><h2>Get an equipment proposal for your printing application</h2><p>Share your material, item dimensions, print size and production requirements. We will help you plan the equipment and a free sample test.</p><p><a href="mailto:info@gzcnc-laser.com">info@gzcnc-laser.com</a><br><a href="https://wa.me/8618988946615">WhatsApp: +86 189 8894 6615</a></p><p class="dd-printselect__note">Need to share artwork or photos? Send them by email or WhatsApp. Name, email and message are required.</p></div>
    {% form 'contact', id: form_id %}
      <input type="hidden" name="contact[Source]" value="Printing equipment category">
      {% if form.posted_successfully? %}<div class="dd-printselect__success" role="status" tabindex="-1" data-printselect-success><strong>Thank you — your inquiry has been sent.</strong><p>Our team will review your requirements and contact you by email. You do not need to submit the same inquiry again.</p></div><dialog data-printselect-dialog aria-labelledby="PrintselectSuccessTitle"><h2 id="PrintselectSuccessTitle">Inquiry sent successfully</h2><p>Thank you for contacting Dragon Diamond. Our team will review your requirements and contact you by email.</p><button type="button" class="dd-printselect__button" data-printselect-close>Got it</button></dialog>{% endif %}
      {% if form.errors %}<div role="alert">{{ form.errors | default_errors }}</div>{% endif %}
      <div class="dd-printselect__fields"><div><label for="PrintselectName-{{ section.id }}">Name *</label><input id="PrintselectName-{{ section.id }}" name="contact[name]" autocomplete="name" value="{{ form.name | escape }}" required></div><div><label for="PrintselectEmail-{{ section.id }}">Email *</label><input id="PrintselectEmail-{{ section.id }}" name="contact[email]" type="email" autocomplete="email" value="{{ form.email | escape }}" required></div><div><label for="PrintselectCompany-{{ section.id }}">Company</label><input id="PrintselectCompany-{{ section.id }}" name="contact[Company]" autocomplete="organization" value="{{ form.Company | escape }}"></div><div><label for="PrintselectWA-{{ section.id }}">WhatsApp</label><input id="PrintselectWA-{{ section.id }}" name="contact[WhatsApp]" type="tel" autocomplete="tel" value="{{ form.WhatsApp | escape }}"></div></div>
      <label for="PrintselectProduct-{{ section.id }}">Product Interested</label><select id="PrintselectProduct-{{ section.id }}" name="contact[Product Interested]"><option>Printing equipment / need advice</option>{% for name in machine_names %}<option>{{ name }}</option>{% endfor %}<option>Other printing requirements</option></select>
      <label for="PrintselectMessage-{{ section.id }}">Message *</label><textarea id="PrintselectMessage-{{ section.id }}" name="contact[body]" rows="5" placeholder="Material, item dimensions, print size, artwork, required finish, output target and destination country..." required>{{ form.body | escape }}</textarea><button type="submit" class="dd-printselect__button">Send Inquiry</button>
    {% endform %}
