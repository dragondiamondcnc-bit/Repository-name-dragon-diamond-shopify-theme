{% comment %}
  Dragon Diamond Header V4.9 - Products Architecture V1
  Layer 1: Top Utility Bar (Trust + Global Access)
  Layer 2: Main Header (Logo + Decision Navigation with Dropdown)
{% endcomment %}

<header class="dd-header-v4-9">
  
  <!-- LAYER 1: TOP UTILITY BAR (Trust & Global Access) -->
  <!-- LAYER 2: MAIN HEADER -->
  <div class="dd-main-header">
    <div class="dd-container">
      <div class="dd-main-inner">
        <!-- Logo Area -->
        <div class="dd-brand-identity">
          <a href="{{ routes.root_url }}" class="dd-brand-main">
            <div class="dd-brand-icon">
              <img src="{{ 'dragon-mark-transparent.png' | asset_url }}" alt="Dragon Diamond dragon mark" width="62" height="62">
            </div>
            <div class="dd-brand-text">
              <span class="dd-brand-name">DRAGON DIAMOND</span>
              <span class="dd-brand-slogan">Global Laser Solution</span>
            </div>
          </a>
        </div>

        <!-- Navigation with Product Dropdown -->
        <nav class="dd-nav-center" id="DDB2BNavigation">
<a href="{{ routes.root_url }}">{{ 'dd_home.home' | t }}</a>
<div class="dd-nav-dropdown-wrap"><a href="{{ routes.root_url }}#HomeCategories" class="dd-nav-trigger">{{ 'dd_home.footer_products' | t }}</a><div class="dd-dropdown-panel"><div class="dd-dropdown-grid">{% for i in (1..6) %}{% assign key = 'dd_home.category_' | append: i %}<a class="dd-drop-item" href="{% if i == 1 %}{{ routes.collections_url }}/co2-laser{% elsif i == 2 %}{{ routes.collections_url }}/cnc-router{% elsif i == 3 %}{{ routes.collections_url }}/laser-marking{% elsif i == 4 %}{{ routes.collections_url }}/fiber-laser-cutting{% elsif i == 5 %}{{ routes.collections_url }}/laser-welding{% elsif i == 6 %}{{ routes.collections_url }}/printers{% else %}{{ routes.root_url }}#HomeCategory-{{ i }}{% endif %}"><span class="dd-drop-title">{{ key | t }}</span></a>{% endfor %}</div></div></div>
<a href="{{ routes.root_url }}#HomeIndustries">{{ 'dd_home.industries' | t }}</a><a href="{{ routes.root_url }}#HomeCases">{{ 'dd_home.cases' | t }}</a><a href="{{ routes.root_url }}pages/factory">{{ 'dd_home.factory' | t }}</a><a href="{{ routes.root_url }}#HomeFAQ">{{ 'dd_home.faq' | t }}</a><a href="{{ routes.root_url }}#HomeContact">{{ 'dd_home.contact' | t }}</a>
</nav>

        <div class="dd-header-locale"><a class="dd-nav-quote" href="{{ routes.root_url }}#HomeContact">{{ 'dd_home.quote' | t }}</a></div>

        <!-- Mobile Toggle -->
        <button class="dd-toggle-v3" type="button" aria-label="{{ 'dd_home.menu' | t }}" aria-expanded="false" aria-controls="DDB2BNavigation">
          <span></span><span></span>
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  (() => {
    const header = document.querySelector('.dd-header-v4-9');
    if (!header) return;
    const toggle = header.querySelector('.dd-toggle-v3');
    const nav = header.querySelector('.dd-nav-center');
    const closeMenu = () => { header.classList.remove('menu-open'); toggle.setAttribute('aria-expanded', 'false'); };
    toggle.addEventListener('click', () => { const open = header.classList.toggle('menu-open'); toggle.setAttribute('aria-expanded', String(open)); });
    nav.addEventListener('click', event => { if(event.target.closest('a')) closeMenu(); });
    document.addEventListener('keydown', event => { if(event.key === 'Escape' && header.classList.contains('menu-open')) { closeMenu(); toggle.focus(); } });
    window.matchMedia('(min-width: 1025px)').addEventListener('change', closeMenu);

    const syncHeaderState = () => {
      header.classList.toggle('is-scrolled', window.scrollY > 30);
    };

    syncHeaderState();
    window.addEventListener('scroll', syncHeaderState, { passive: true });
  })();
</script>

<style>
  :root {
    --dd-dark: #0F1115;
    --dd-cyan: #00A3AD;
    --dd-border: rgba(15, 17, 21, 0.08);
  }

  .dd-header-v4-9 {
    width: 100%;
    position: fixed;
    top: 0;
    left: 0;
    z-index: 3000;
    background: linear-gradient(180deg, rgba(0,0,0,0.62) 0%, rgba(0,0,0,0.22) 66%, rgba(0,0,0,0) 100%);
    backdrop-filter: blur(1.5px);
    -webkit-backdrop-filter: blur(1.5px);
    border: 0;
    transition: background 0.28s ease, backdrop-filter 0.28s ease;
  }

  .dd-header-v4-9.is-scrolled {
    background: rgba(0,0,0,0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  /* LAYER 1: TOP UTILITY BAR */
  .dd-top-utility { display: none; }
  .dd-top-utility .dd-container { max-width: 1240px; width: 100%; margin: 0 auto; padding: 0 32px; }
  .dd-top-utility-inner { display: flex; justify-content: space-between; align-items: center; width: 100%; }
  
  .dd-top-social { display: flex; gap: 20px; align-items: center; }
  .dd-top-social svg { width: 18px; height: 18px; fill: rgba(255,255,255,0.4); transition: fill 0.3s; }
  .dd-top-social a:hover svg { fill: var(--dd-cyan); }

  .dd-top-right-group { display: flex; gap: 24px; align-items: center; }
  .dd-top-lang { display: flex; gap: 10px; align-items: center; font-family: 'Archivo Narrow', sans-serif; }
  .dd-top-lang a { font-size: 11px; font-weight: 800; color: rgba(255,255,255,0.5); text-decoration: none; transition: color 0.3s; letter-spacing: 0.5px; }
  .dd-top-lang a:hover, .dd-top-lang a.active { color: var(--dd-cyan); }
  .dd-top-lang .sep { font-size: 10px; color: rgba(255,255,255,0.1); font-weight: 300; }
  .dd-top-search svg { width: 18px; height: 18px; color: rgba(255,255,255,0.4); transition: color 0.3s; display: block; }
  .dd-top-search a:hover svg { color: var(--dd-cyan); }

  /* LAYER 2: MAIN HEADER */
  .dd-main-header { background: transparent; border: 0; }
  .dd-main-header .dd-container { max-width: 1360px; width: 100%; margin: 0 auto; padding: 0 32px; }
  .dd-main-inner {
    height: 106px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: relative;
    transition: height 0.28s ease;
  }
  .dd-header-v4-9.is-scrolled .dd-main-inner { height: 92px; }

  /* Brand Identity */
  .dd-brand-main { display: flex; align-items: center; gap: 14px; text-decoration: none; transition: opacity 0.3s; }
  .dd-brand-main:hover { opacity: 0.82; }
  .dd-brand-icon { width: 62px; height: 62px; border-radius: 0; overflow: visible; background: transparent; flex-shrink: 0; }
  .dd-brand-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 0 10px rgba(0, 216, 230, 0.35)) drop-shadow(0 2px 8px rgba(0, 0, 0, 0.55));
  }
  .dd-brand-text { display: flex; flex-direction: column; gap: 2px; }
  .dd-brand-name { font-size: 25px; font-weight: 800; color: #FFFFFF; letter-spacing: 0.2px; line-height: 1; font-family: 'Archivo Narrow', sans-serif; }
  .dd-brand-slogan { display: none; }

  /* Navigation Center */
  .dd-nav-center { 
    display: flex; 
    gap: 38px;
    margin-left: auto; 
    margin-right: 36px;
    align-items: center;
  }
  .dd-nav-center > a, .dd-nav-trigger {
    font-size: 13px; font-weight: 800; color: #FFFFFF; text-decoration: none; letter-spacing: 0.4px;
    opacity: 0.92; transition: opacity 0.3s, color 0.3s; position: relative; padding: 10px 0; white-space: nowrap; cursor: pointer;
  }
  .dd-nav-center > a:hover, .dd-nav-center > a.active, .dd-nav-trigger:hover { opacity: 1; color: var(--dd-cyan); }
  
  /* Dropdown Logic */
  .dd-nav-dropdown-wrap { position: relative; display: flex; align-items: center; }
  .dd-dropdown-panel {
    position: absolute; top: 100%; left: 0; width: 600px;
    background: rgba(0,0,0,0.88); border: 0;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    padding: 30px; box-sizing: border-box;
    opacity: 0; visibility: hidden; transform: translateY(10px);
    transition: all 0.4s cubic-bezier(0.19, 1, 0.22, 1);
    z-index: 100;
  }
  .dd-nav-dropdown-wrap:hover .dd-dropdown-panel { opacity: 1; visibility: visible; transform: translateY(0); }
  
  .dd-dropdown-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .dd-drop-item { text-decoration: none; border-left: 1.5px solid #EEE; padding-left: 15px; display: flex; flex-direction: column; gap: 4px; transition: 0.3s; }
  .dd-drop-item:hover { border-left-color: var(--dd-cyan); }
  .dd-drop-title { font-size: 13px; font-weight: 800; color: #FFFFFF; text-transform: uppercase; display: block; }
  .dd-drop-desc { font-size: 10px; color: rgba(255,255,255,0.62); display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  /* Underline Feedback */
  .dd-nav-center a:after, .dd-nav-trigger:after {
    content: ''; position: absolute; bottom: -5px; left: 0; width: 0; height: 2px;
    background: var(--dd-cyan); transition: width 0.3s;
  }
  .dd-nav-center a:hover:after, .dd-nav-center a.active:after, .dd-nav-trigger:hover:after { width: 100%; }

  .dd-header-locale {
    display: flex;
    align-items: center;
    gap: 13px;
    color: #FFFFFF;
    font-family: 'Archivo Narrow', sans-serif;
    font-size: 14px;
    font-weight: 800;
  }

  .dd-header-divider {
    width: 1px;
    height: 34px;
    margin-right: 24px;
    background: rgba(0,216,230,0.7);
  }

  .dd-header-globe,
  .dd-header-lang {
    color: #FFFFFF;
    text-decoration: none;
    transition: color 0.3s, opacity 0.3s;
  }

  .dd-header-globe:hover,
  .dd-header-lang:hover {
    color: var(--dd-cyan);
  }

  .dd-header-globe svg {
    display: block;
    width: 23px;
    height: 23px;
  }

  .dd-header-caret {
    color: rgba(255,255,255,0.82);
    font-size: 14px;
    line-height: 1;
  }

  /* Mobile Toggle */
  .dd-toggle-v3 { display: none; background: none; border: none; flex-direction: column; gap: 6px; cursor: pointer; }
  .dd-toggle-v3 span { width: 20px; height: 2px; background: #FFFFFF; }

  @media (max-width: 1366px) {
    .dd-nav-center { position: static; transform: none; margin: 0 40px; }
  }

  @media (max-width: 1024px) {
    .dd-nav-center, .dd-top-utility, .dd-header-locale { display: none; }
    .dd-main-inner { height: 80px; }
    .dd-brand-icon { width: 60px; height: 60px; }
    .dd-toggle-v3 { display: flex; }
  }
.dd-nav-dropdown-wrap:focus-within .dd-dropdown-panel{opacity:1;visibility:visible;transform:translateY(0)}.dd-nav-quote{display:inline-flex;background:#6de1d3;color:#102c32!important;padding:12px 18px;border-radius:4px;font-weight:700;text-decoration:none;white-space:nowrap}.dd-header-v4-9 a:focus-visible,.dd-toggle-v3:focus-visible{outline:3px solid #de9a35;outline-offset:4px}.dd-toggle-v3{min-width:44px;min-height:44px;align-items:center;justify-content:center}.dd-nav-center{gap:22px}.dd-nav-center>a,.dd-nav-trigger{min-height:44px;display:flex;align-items:center}
@media(max-width:1024px){.dd-header-v4-9.menu-open{background:#10272d}.dd-header-v4-9.menu-open .dd-nav-center{display:flex;flex-direction:column;align-items:stretch;position:absolute;top:100%;left:0;right:0;background:#10272d;margin:0;padding:20px 24px;max-height:75vh;overflow-y:auto;gap:8px}.dd-header-v4-9.menu-open .dd-nav-dropdown-wrap{display:block}.dd-header-v4-9.menu-open .dd-dropdown-panel{position:static;width:auto;opacity:1;visibility:visible;transform:none;padding:4px 0 8px;background:transparent;box-shadow:none}.dd-header-v4-9.menu-open .dd-dropdown-grid{grid-template-columns:1fr;gap:4px}.dd-header-v4-9.menu-open .dd-drop-item{min-height:44px}.dd-header-v4-9.menu-open .dd-drop-title{font-size:15px}}
.dd-nav-center{gap:16px}@media(min-width:1025px) and (max-width:1200px){.dd-nav-center{gap:12px;margin:0 14px}.dd-brand-name{font-size:21px}.dd-nav-center>a,.dd-nav-trigger{font-size:12px}.dd-nav-quote{padding:12px}}
</style>

{% schema %}
{
  "name": "Header V2",
  "settings": []
}
{% endschema %}
