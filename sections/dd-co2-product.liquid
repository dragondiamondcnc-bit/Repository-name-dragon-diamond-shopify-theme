{% liquid
assign inquiry_id = 'Co2ProductInquiry-' | append: section.id
assign intro = product.description | split: '</p>' | first | strip_html
%}<div class="dd-fabric"><div class="dd-fabric__hero"><div class="dd-fabric__wrap"><nav class="dd-fabric__crumbs" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a> / <a href="{{ routes.collections_url }}/co2-laser">CO2 Laser Cutting Machines</a> / {{ section.settings.model | escape }}</nav><div class="dd-fabric__split"><div><p class="dd-fabric__eyebrow">{{ section.settings.eyebrow | escape }}</p><h1>{{ product.title | escape }}</h1><p class="dd-fabric__lead">{{ intro }}</p><p><strong>{{ section.settings.summary | escape }}</strong></p><div class="dd-fabric__actions"><a class="dd-fabric__button" href="#{{ inquiry_id }}">Get a Quote</a><a href="#{{ inquiry_id }}">Request a Free Sample Test</a></div></div><figure><img src="{{ section.settings.hero_asset | asset_url }}" width="1400" height="1200" loading="eager" fetchpriority="high" alt="{{ section.settings.model | escape }} — {{ section.settings.caption | escape }}"><figcaption>{{ section.settings.caption | escape }}</figcaption></figure></div></div></div><div class="dd-fabric__wrap"><nav class="dd-fabric__nav" aria-label="Product information"><a href="#co2-configuration">Configuration</a><a href="#co2-specifications">Specifications</a><a href="#co2-applications">Applications</a><a href="#co2-faq">FAQ</a></nav><section><h2>Application Examples</h2><p>Examples of the types of work to discuss during sample testing. Confirm results on your own material and artwork.</p><div class="dd-fabric__samples-grid">{% if section.settings.model == 'LZ-1610L' %}<figure>{{ images['lz-1816l-printed-garment-panels.jpg'] | image_url: width: 700 | image_tag: loading: 'lazy', alt: 'Printed garment panel application example' }}<figcaption>Printed garment panels — textile application reference from our fabric range.</figcaption></figure><figure>{{ images['lz-1816l-decorative-fabric-cutouts.jpg'] | image_url: width: 700 | image_tag: loading: 'lazy', alt: 'Decorative textile cut-out application example' }}<figcaption>Decorative textile cut-outs — verify suitability on your fabric.</figcaption></figure>{% else %}<figure>{{ images['laser-sample-acrylic-letters.jpg'] | image_url: width: 700 | image_tag: loading: 'lazy', alt: 'Acrylic lettering application example' }}<figcaption>Acrylic lettering — match part size to the working area.</figcaption></figure><figure>{{ images['laser-sample-wood-dice-panels.jpg'] | image_url: width: 700 | image_tag: loading: 'lazy', alt: 'Wood craft panel application example' }}<figcaption>Wood-based craft components — material and finish evaluated by sample testing.</figcaption></figure>{% endif %}</div></section><div class="dd-fabric__content">{{ product.description }}</div><section><h2>Compare CO2 Laser Equipment</h2><p><a href="{{ routes.collections_url }}/co2-laser">View the CO2 laser range</a> or discuss your material and production needs with our team.</p><p><a href="{{ routes.root_url }}pages/factory">Visit our factory</a> · <a href="{{ routes.root_url }}pages/support">Installation and technical support</a></p></section><section id="{{ inquiry_id }}" class="dd-fabric__inquiry"><h2>Discuss Your CO2 Laser Project</h2><p>Tell us your material, thickness, part size, production needs and delivery destination.</p>{% form 'contact', id: inquiry_id %}{% if form.posted_successfully? %}<p class="dd-fabric__success" role="status" tabindex="-1" data-fabric-success>Thank you. Your inquiry has been sent. Our team will review your requirements.</p><dialog class="dd-fabric__dialog" data-fabric-dialog aria-labelledby="FabricThanks-{{ section.id }}"><h2 id="FabricThanks-{{ section.id }}">Thank you for your inquiry</h2><p>Your message has been sent successfully. Our team will review your requirements and contact you.</p><button type="button" class="dd-fabric__button" data-fabric-close>Got it</button></dialog>{% endif %}{{ form.errors | default_errors }}<input type="hidden" name="contact[Product URL]" value="{{ canonical_url | escape }}"><div class="dd-fabric__fields"><label for="Name-{{ section.id }}">Name *<input id="Name-{{ section.id }}" name="contact[name]" autocomplete="name" value="{{ form.name | escape }}" required></label><label for="Email-{{ section.id }}">Email *<input id="Email-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" value="{{ form.email | escape }}" required></label><label for="Company-{{ section.id }}">Company<input id="Company-{{ section.id }}" name="contact[Company]" autocomplete="organization"></label><label for="Whatsapp-{{ section.id }}">WhatsApp<input id="Whatsapp-{{ section.id }}" name="contact[WhatsApp]" type="tel" autocomplete="tel"></label><label for="Product-{{ section.id }}">Product Interested<input id="Product-{{ section.id }}" name="contact[Product Interested]" value="{{ product.title | escape }}"></label><label class="dd-fabric__message" for="Message-{{ section.id }}">Message *<textarea id="Message-{{ section.id }}" name="contact[body]" rows="5" required>{{ form.body | escape }}</textarea></label></div><button class="dd-fabric__button" type="submit">Send Inquiry</button>{% endform %}<p><a href="mailto:info@gzcnc-laser.com">info@gzcnc-laser.com</a> · <a href="https://wa.me/8618988946615">WhatsApp: +86 189 8894 6615</a></p></section></div></div>

<script type="application/ld+json">{"@context":"https://schema.org","@type":"Product","@id":{{ canonical_url | append: '#product' | json }},"url":{{ canonical_url | json }},"name":{{ product.title | json }},"model":{{ section.settings.model | json }},"description":{{ intro | json }},"brand":{"@type":"Brand","name":"Dragon Diamond"},"image":{{ section.settings.hero_asset | asset_url | prepend: 'https:' | json }}}</script>
<script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":{{ request.origin | json }}},{"@type":"ListItem","position":2,"name":"CO2 Laser Cutting Machines","item":{{ request.origin | append: '/collections/co2-laser' | json }}},{"@type":"ListItem","position":3,"name":{{ product.title | json }},"item":{{ canonical_url | json }}}]}</script>
{% stylesheet %}
  .dd-fabric{background:#f6f8f8;color:#182d30;font-family:Arial,sans-serif;line-height:1.65}.dd-fabric *{box-sizing:border-box}.dd-fabric__wrap{max-width:1240px;margin:auto;padding:0 32px}.dd-fabric__hero{padding:140px 0 56px;background:#123439;color:#fff}.dd-fabric__crumbs{font-size:13px;margin-bottom:38px}.dd-fabric a{color:inherit;text-underline-offset:4px}.dd-fabric__split{display:grid;grid-template-columns:1fr 1fr;gap:36px;align-items:center}.dd-fabric h1{font-size:clamp(32px,4vw,54px);line-height:1.12;color:inherit;letter-spacing:-1px;margin:18px 0 24px}.dd-fabric h2{font-size:30px;line-height:1.2;margin:0 0 24px}.dd-fabric h3{font-size:20px;line-height:1.35}.dd-fabric__eyebrow{font-size:12px;font-weight:bold;letter-spacing:2px;color:#6edbd1}.dd-fabric__lead{font-size:19px}.dd-fabric figure{margin:0}.dd-fabric__hero img{width:100%;height:520px;object-fit:contain;background:transparent}.dd-fabric figcaption{font-size:12px;opacity:.8;margin-top:12px}.dd-fabric__actions{display:flex;flex-wrap:wrap;gap:24px;align-items:center;margin-top:28px}.dd-fabric .dd-fabric__button{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:13px 24px;background:#6ddbd0;color:#102c30;font:700 16px Arial,sans-serif;text-decoration:none;border:0;border-radius:4px;cursor:pointer}.dd-fabric__nav{display:flex;flex-wrap:wrap;gap:22px;padding:24px 0;border-bottom:1px solid #d3dfdf}.dd-fabric section,.dd-fabric__content{padding:48px 0;border-bottom:1px solid #d3dfdf;scroll-margin-top:110px}.dd-fabric__content>p:first-child{display:none}.dd-fabric__content h2:not(:first-child){margin-top:42px}.dd-fabric__content li{margin:8px 0}.dd-fabric__samples{display:block}.dd-fabric__sample-heading{display:flex;justify-content:space-between;align-items:center;gap:28px;margin-bottom:22px}.dd-fabric__sample-heading>div{max-width:740px}.dd-fabric__sample-heading h2{margin:6px 0 10px}.dd-fabric__sample-heading p{margin:0}.dd-fabric__sample-heading .dd-fabric__button{flex-shrink:0}.dd-fabric__sample-eyebrow{font-size:11px;letter-spacing:1.8px;font-weight:700;color:#157077}.dd-fabric__application-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.dd-fabric__application-card{position:relative;display:block;min-width:0;aspect-ratio:16/10;border-radius:8px;overflow:hidden;background:#263e40;text-decoration:none;color:white}.dd-fabric__application-card img{display:block;width:100%;height:100%;object-fit:cover}.dd-fabric__application-caption{position:absolute;inset:auto 0 0;padding:50px 24px 20px;background:linear-gradient(transparent,rgba(6,19,21,.88));color:white}.dd-fabric__application-caption h3{font-size:25px;color:white;margin:0 0 4px}.dd-fabric__application-caption p{font-size:14px;margin:0;color:#edf5f3}.dd-fabric__application-expand{position:absolute;right:14px;top:14px;display:grid;place-items:center;width:34px;height:34px;border-radius:50%;background:rgba(9,30,32,.65);color:white;font-size:22px}.dd-fabric__sample-footer{display:flex;justify-content:space-between;gap:16px;margin-top:12px;font-size:12px;color:#526c6e}.dd-fabric__sample-footer p{margin:0}.dd-fabric__sample-footer a{display:inline-block;padding:2px 0;margin-left:12px;text-underline-offset:3px}.dd-fabric__sample-footer>div{flex-shrink:0}.dd-fabric__swipe{display:none}.dd-fabric__gallery img{max-height:300px;width:100%;object-fit:contain}.dd-fabric__support,.dd-fabric__related{display:grid;grid-template-columns:repeat(3,1fr);gap:28px}.dd-fabric__related{grid-template-columns:repeat(2,1fr)}.dd-fabric__related>a{padding:24px;background:#e9efee;text-decoration:none}.dd-fabric__related img{width:100%;height:230px;object-fit:contain}.dd-fabric details{border-bottom:1px solid #d3dfdf;padding:18px 0}.dd-fabric summary{font-weight:700;cursor:pointer}.dd-fabric table{width:100%;border-collapse:collapse;margin:20px 0;font-size:15px}.dd-fabric th,.dd-fabric td{padding:12px;border:1px solid #cad8d8;text-align:left;overflow-wrap:anywhere}.dd-fabric th{width:40%;background:#e9efee}.dd-fabric__fields{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin:25px 0}.dd-fabric label{font-weight:700;display:block}.dd-fabric input,.dd-fabric textarea{display:block;width:100%;padding:13px;border:1px solid #a7baba;border-radius:3px;background:white;color:#182d30;font:16px Arial,sans-serif;margin-top:6px}.dd-fabric__message{grid-column:1/-1}.dd-fabric__inquiry a{overflow-wrap:anywhere}.dd-fabric :focus-visible{outline:3px solid #009c9c;outline-offset:4px}@media(max-width:749px){.dd-fabric__sample-heading{display:block;margin-bottom:18px}.dd-fabric__sample-heading h2{font-size:26px}.dd-fabric__sample-heading .dd-fabric__button{margin-top:16px}.dd-fabric__application-grid{display:flex;gap:12px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:thin;padding-bottom:8px}.dd-fabric__application-card{flex:0 0 90%;aspect-ratio:4/3;scroll-snap-align:start}.dd-fabric__application-caption{padding:40px 16px 16px}.dd-fabric__application-caption h3{font-size:22px}.dd-fabric__application-caption p{font-size:13px}.dd-fabric__sample-footer{display:block;margin-top:8px}.dd-fabric__sample-footer a{padding:10px 0}.dd-fabric__swipe{display:block;margin:6px 0;font-size:12px;color:#526c6e}.dd-fabric__wrap{padding:0 20px}.dd-fabric__hero{padding:110px 0 36px}.dd-fabric__split,.dd-fabric__support,.dd-fabric__related,.dd-fabric__fields{grid-template-columns:1fr}.dd-fabric__hero img{height:350px}.dd-fabric h1{font-size:36px}.dd-fabric h2{font-size:27px}.dd-fabric section,.dd-fabric__content{padding:34px 0}.dd-fabric__nav{gap:12px 20px;font-size:14px}.dd-fabric__button{width:100%}.dd-fabric__crumbs{overflow-wrap:anywhere}}

.dd-fabric__hero{background:#edf3f3;color:#182d30}.dd-fabric__eyebrow{color:#087d83}.dd-fabric__hero img{height:550px}.dd-fabric__config{display:grid;grid-template-columns:1fr 1fr;gap:24px}.dd-fabric__config>div{padding:22px;background:#e8eeee;border-radius:8px}.dd-fabric__samples-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}.dd-fabric__samples-grid img{width:100%;height:260px;object-fit:cover;border-radius:8px}.dd-fabric__optional{display:grid;grid-template-columns:1fr 1fr;gap:28px;align-items:center}.dd-fabric__optional img{width:100%;max-height:320px;object-fit:contain}.dd-fabric__video{width:100%;aspect-ratio:16/9;border:0;margin-top:16px}.dd-fabric__success{padding:20px;border:1px solid #087d83;background:#e5f5ed}.dd-fabric__dialog{max-width:480px;width:calc(100% - 36px);border:0;border-radius:12px;padding:28px;color:#182d30;background:white}.dd-fabric__dialog::backdrop{background:rgba(0,0,0,.65)}@media(max-width:749px){.dd-fabric__hero img{height:350px}.dd-fabric__config,.dd-fabric__optional{grid-template-columns:1fr}.dd-fabric__samples-grid{gap:12px}.dd-fabric__samples-grid img{height:170px}.dd-fabric__samples-grid figcaption{font-size:13px}}{% endstylesheet %}

{% javascript %}
function initFabricFeedback(){document.querySelectorAll('[data-fabric-dialog]').forEach(d=>{if(d.dataset.ready)return;d.dataset.ready='true';const s=d.closest('form').querySelector('[data-fabric-success]');d.querySelector('[data-fabric-close]').addEventListener('click',()=>d.close());d.addEventListener('close',()=>s.focus());if(typeof d.showModal==='function')d.showModal();else s.focus();});}initFabricFeedback();document.addEventListener('shopify:section:load',initFabricFeedback);
{% endjavascript %}

