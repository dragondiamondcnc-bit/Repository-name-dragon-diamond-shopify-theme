{% liquid
  assign model = section.settings.model
  assign prefix = 'dd_product.' | append: model | append: '.'
  assign hero_image = section.settings.hero_image | default: product.featured_image
  assign title_key = prefix | append: 'title'
  assign product_name = title_key | t
  assign form_id = 'ProductInquiry-' | append: section.id
  assign nav_items = 'overview,results,configuration,case,support,details' | split: ','
  assign spec_count = 4
  if model == 'router'
    assign spec_count = 5
  endif
%}
{% assign description_key = prefix | append: 'intro' %}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "@id": {{ canonical_url | append: '#product' | json }},
    "url": {{ canonical_url | json }},
    "name": {{ product_name | replace: '&amp;', '&' | json }},
    "description": {{ description_key | t | replace: '&amp;', '&' | json }},
    "brand": { "@type": "Brand", "name": "Dragon Diamond" },
    {% if hero_image != blank %}
      "image": {{ hero_image | image_url: width: 1400 | prepend: 'https:' | json }},
    {% endif %}
    "additionalProperty": [
      {% for i in (1..spec_count) %}
        {% assign label_key = prefix | append: 'spec_' | append: i | append: '_label' %}
        {% assign value_key = prefix | append: 'spec_' | append: i | append: '_value' %}
        {
          "@type": "PropertyValue",
          "name": {{ label_key | t | replace: '&amp;', '&' | json }},
          "value": {{ value_key | t | replace: '&amp;', '&' | json }}
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  }
</script>
<div class="dd-six" id="ProductSix-{{ section.id }}">
  <nav class="dd-six__nav" aria-label="{{ 'dd_product.common.navigation' | t | escape }}">
    {% for item in nav_items %}
      {% assign nav_key = 'dd_product.common.' | append: item %}
      <a href="#{{ item }}-{{ section.id }}">{{ nav_key | t }}</a>
    {% endfor %}
  </nav>
  <section class="dd-six__hero" id="overview-{{ section.id }}" aria-labelledby="title-{{ section.id }}">
    <div class="dd-six__wrap dd-six__split">
      <div>
        <p class="dd-six__eyebrow">{{ 'dd_product.common.manufacturer' | t }}</p>
        <h1 id="title-{{ section.id }}">{{ product_name }}</h1>
        {% assign key = prefix | append: 'intro' %}<p class="dd-six__lead">{{ key | t }}</p>
        <dl class="dd-six__facts">
          {% for i in (1..4) %}
            {% assign label = prefix | append: 'spec_' | append: i | append: '_label' %}
            {% assign value = prefix | append: 'spec_' | append: i | append: '_value' %}
            <div><dt>{{ label | t }}</dt><dd>{{ value | t }}</dd></div>
          {% endfor %}
        </dl>
        <div class="dd-six__actions"><a class="dd-six__button" href="#{{ form_id }}">{{ 'dd_product.common.quote' | t }}</a><a class="dd-six__link" href="#results-{{ section.id }}">{{ 'dd_product.common.explore' | t }}</a></div>
      </div>
      {% if hero_image != blank %}
        <figure class="dd-six__hero-image">
          {{ hero_image | image_url: width: 1400 | image_tag: widths: '480, 750, 1000, 1400', sizes: '(min-width: 900px) 50vw, 100vw', loading: 'eager', fetchpriority: 'high', alt: product_name }}
          <figcaption>{{ 'dd_product.common.image_note' | t }}</figcaption>
        </figure>
      {% endif %}
    </div>
  </section>
  <section class="dd-six__section" id="results-{{ section.id }}" aria-labelledby="results-title-{{ section.id }}">
    <div class="dd-six__wrap">
      <p class="dd-six__eyebrow">02 / {{ 'dd_product.common.results' | t }}</p>
      {% assign key = prefix | append: 'results_title' %}<h2 id="results-title-{{ section.id }}">{{ key | t }}</h2>
      <p class="dd-six__lead">{{ 'dd_product.common.results_intro' | t }}</p>
      <div class="dd-six__cards">
        {% for i in (1..3) %}
          {% assign image_id = 'sample_' | append: i %}
          {% assign title = prefix | append: 'application_' | append: i %}
          {% assign body = prefix | append: 'application_' | append: i | append: '_body' %}
          {% assign alt = title | t %}
          <article class="dd-six__card">
            {% if section.settings[image_id] != blank %}{{ section.settings[image_id] | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 600, 900', sizes: '(min-width: 900px) 33vw, 100vw', alt: alt }}{% endif %}
            <div><h3>{{ title | t }}</h3><p>{{ body | t }}</p></div>
          </article>
        {% endfor %}
      </div>
      {% if model == 'laser' and section.settings.sample_4 != blank %}
        <article class="dd-six__split dd-six__camera-example">
          {% assign camera_alt = 'dd_product.laser.camera_alt' | t %}
          <figure>{{ section.settings.sample_4 | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '480, 750, 1200', sizes: '(min-width: 900px) 50vw, 100vw', alt: camera_alt }}</figure>
          <div><p class="dd-six__eyebrow">{{ 'dd_product.laser.camera_badge' | t }}</p><h3>{{ 'dd_product.laser.camera_title' | t }}</h3><p>{{ 'dd_product.laser.camera_body' | t }}</p><p>{{ 'dd_product.laser.camera_workflow' | t }}</p><a class="dd-six__link" href="#configuration-{{ section.id }}">{{ 'dd_product.laser.camera_link' | t }}</a></div>
        </article>
      {% endif %}
      {% if section.settings.processing_video != blank %}
        <div class="dd-six__video">{{ section.settings.processing_video | video_tag: controls: true, autoplay: false, loop: false, muted: false, preload: 'none' }}</div>
      {% endif %}
      {% if model == 'laser' %}<p>{{ 'dd_product.laser.fabric_note' | t }}</p>{% endif %}
      <div class="dd-six__callout"><div><h3>{{ 'dd_product.common.test_title' | t }}</h3><p>{{ 'dd_product.common.test_body' | t }}</p></div><a class="dd-six__button" href="#{{ form_id }}">{{ 'dd_product.common.test_button' | t }}</a></div>
    </div>
  </section>
  <section class="dd-six__section dd-six__muted" id="configuration-{{ section.id }}" aria-labelledby="configuration-title-{{ section.id }}">
    <div class="dd-six__wrap">
      <p class="dd-six__eyebrow">03 / {{ 'dd_product.common.configuration' | t }}</p>
      <h2 id="configuration-title-{{ section.id }}">{{ 'dd_product.common.configuration_title' | t }}</h2>
      <div class="dd-six__split">
        <div class="dd-six__panel"><h3>{{ 'dd_product.common.standard' | t }}</h3><dl class="dd-six__facts">
          {% for i in (2..spec_count) %}
            {% assign label = prefix | append: 'spec_' | append: i | append: '_label' %}{% assign value = prefix | append: 'spec_' | append: i | append: '_value' %}
            <div><dt>{{ label | t }}</dt><dd>{{ value | t }}</dd></div>
          {% endfor %}
        </dl></div>
        <div class="dd-six__panel"><h3>{{ 'dd_product.common.options' | t }}</h3>
          {% assign key = prefix | append: 'options' %}<p>{{ key | t }}</p>
          {% assign key = prefix | append: 'selection' %}<p>{{ key | t }}</p>
          {% if section.settings.option_image != blank %}{% assign key = prefix | append: 'options_alt' %}{% assign alt = key | t %}{{ section.settings.option_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: alt }}{% endif %}
        </div>
      </div>
      <p>{{ 'dd_product.common.configuration_note' | t }}</p>
    </div>
  </section>
  <section class="dd-six__section" id="case-{{ section.id }}" aria-labelledby="case-title-{{ section.id }}">
    <div class="dd-six__wrap dd-six__split">
      <div><p class="dd-six__eyebrow">04 / {{ 'dd_product.common.case' | t }}</p>
        {% assign key = prefix | append: 'case_title' %}<h2 id="case-title-{{ section.id }}">{{ key | t }}</h2>
        {% assign key = prefix | append: 'case_body' %}<p class="dd-six__lead">{{ key | t }}</p>
        <p>{{ 'dd_product.common.case_note' | t }}</p>
        {% if section.settings.case_url != blank %}<a class="dd-six__button" href="{{ section.settings.case_url }}">{{ 'dd_product.common.case_button' | t }}</a>{% endif %}
      </div>
      {% if section.settings.case_image != blank %}
        {% assign key = prefix | append: 'case_alt' %}{% assign alt = key | t %}
        <figure>{{ section.settings.case_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '480, 750, 1200', sizes: '(min-width: 900px) 50vw, 100vw', alt: alt }}</figure>
      {% endif %}
    </div>
  </section>
  <section class="dd-six__section dd-six__dark" id="support-{{ section.id }}" aria-labelledby="support-title-{{ section.id }}">
    <div class="dd-six__wrap">
      <p class="dd-six__eyebrow">05 / {{ 'dd_product.common.support' | t }}</p>
      <h2 id="support-title-{{ section.id }}">{{ 'dd_product.common.support_title' | t }}</h2>
      <div class="dd-six__support">
        {% for i in (1..5) %}
          {% assign title = 'dd_product.common.service_' | append: i %}{% assign body = title | append: '_body' %}
          <article><span aria-hidden="true">0{{ i }}</span><h3>{{ title | t }}</h3><p>{{ body | t }}</p></article>
        {% endfor %}
      </div>
    </div>
  </section>
  <section class="dd-six__section" id="details-{{ section.id }}" aria-labelledby="details-title-{{ section.id }}">
    <div class="dd-six__wrap">
      <p class="dd-six__eyebrow">06 / {{ 'dd_product.common.details' | t }}</p>
      <h2 id="details-title-{{ section.id }}">{{ 'dd_product.common.details_title' | t }}</h2>
      <div class="dd-six__split dd-six__details-grid">
        <div>
          <details><summary>{{ 'dd_product.common.specs' | t }}</summary><table><caption class="dd-six__sr">{{ product_name }}</caption><tbody>
            {% for i in (1..spec_count) %}
              {% assign label = prefix | append: 'spec_' | append: i | append: '_label' %}{% assign value = prefix | append: 'spec_' | append: i | append: '_value' %}
              <tr><th scope="row">{{ label | t }}</th><td>{{ value | t }}</td></tr>
            {% endfor %}
          </tbody></table></details>
          {% for i in (1..4) %}
            {% assign question = prefix | append: 'faq_' | append: i %}{% assign answer = question | append: '_answer' %}
            <details><summary>{{ question | t }}</summary><p>{{ answer | t }}</p></details>
          {% endfor %}
        </div>
        <div class="dd-six__inquiry">
          <h3>{{ 'dd_product.common.inquiry_title' | t }}</h3>
          <p>{{ 'dd_product.common.inquiry_body' | t }}</p>
          {% form 'contact', id: form_id %}
            <input type="hidden" name="contact[Product]" value="{{ product_name | escape_once }}">
            <input type="hidden" name="contact[Product URL]" value="{{ canonical_url | escape }}">
            {% if form.posted_successfully? %}
              <p role="status" tabindex="-1">{{ 'dd_product.common.success' | t }}</p>
            {% else %}
              {% if form.errors %}<div role="alert">{{ form.errors | default_errors }}</div>{% endif %}
              <label for="name-{{ section.id }}">{{ 'dd_product.common.name' | t }}</label>
              <input id="name-{{ section.id }}" name="contact[name]" autocomplete="name" value="{{ form.name | default: customer.name | escape }}" required>
              <label for="email-{{ section.id }}">{{ 'dd_product.common.email' | t }}</label>
              <input id="email-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" value="{{ form.email | default: customer.email | escape }}" required>
              <label for="body-{{ section.id }}">{{ 'dd_product.common.requirements' | t }}</label>
              <textarea id="body-{{ section.id }}" name="contact[body]" rows="5" required>{{ form.body | escape }}</textarea>
              <button class="dd-six__button" type="submit">{{ 'dd_product.common.submit' | t }}</button>
            {% endif %}
          {% endform %}
        </div>
      </div>
    </div>
  </section>
</div>
{% stylesheet %}
  .dd-six{border-top:110px solid #14282a}
  @media(max-width:1024px){.dd-six{border-top-width:84px}}
  .dd-six{--dd-ink:#14282a;--dd-accent:#006e70;--dd-line:#cbd6d4;color:var(--dd-ink);background:#fff;font-family:Arial,sans-serif;line-height:1.65}
  .dd-six *{box-sizing:border-box}.dd-six figure{margin:0}.dd-six img{display:block;width:100%;height:auto}.dd-six h1,.dd-six h2,.dd-six h3{color:inherit;letter-spacing:-.025em;line-height:1.12;text-wrap:balance}.dd-six h1{font-size:clamp(34px,4.5vw,64px);margin:18px 0 24px}.dd-six h2{font-size:clamp(28px,3.3vw,44px);max-width:24ch;margin:12px 0 24px}.dd-six h3{font-size:21px;margin:0 0 14px}.dd-six p{margin:0 0 20px}.dd-six__wrap{width:min(1200px,calc(100% - 64px));margin:auto}.dd-six__split{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center}.dd-six__hero{padding:64px 0 80px;background:#eff4f2}.dd-six__section{padding:80px 0}.dd-six__eyebrow{font-size:12px;letter-spacing:.15em;text-transform:uppercase;color:var(--dd-accent);font-weight:700}.dd-six__lead{font-size:18px;max-width:65ch}.dd-six__nav{display:flex;gap:24px;padding:16px max(24px,calc((100% - 1200px)/2));overflow-x:auto;border-bottom:1px solid var(--dd-line);white-space:nowrap}.dd-six__nav a{color:var(--dd-ink);font-size:13px;text-decoration:none}.dd-six [id]{scroll-margin-top:160px}.dd-six__facts{margin:24px 0}.dd-six__facts>div{display:flex;justify-content:space-between;gap:24px;padding:12px 0;border-bottom:1px solid var(--dd-line)}.dd-six dt{font-size:14px}.dd-six dd{margin:0;font-size:15px;font-weight:700;text-align:right}.dd-six__actions{display:flex;gap:24px;align-items:center;flex-wrap:wrap}.dd-six__button{display:inline-flex;justify-content:center;align-items:center;min-height:48px;padding:14px 24px;background:var(--dd-accent);color:#fff!important;font:700 14px Arial,sans-serif;text-decoration:none;border:0;border-radius:3px;cursor:pointer}.dd-six__button:hover{background:#004c4e}.dd-six__link{color:var(--dd-accent);font-weight:700}.dd-six :focus-visible{outline:3px solid #b96919;outline-offset:4px}.dd-six__hero-image img{aspect-ratio:1;object-fit:contain;background:#fff}.dd-six figcaption{font-size:12px;margin-top:12px;color:#516563}.dd-six__cards{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin:32px 0}.dd-six__card{border:1px solid var(--dd-line)}.dd-six__card img{aspect-ratio:4/3;object-fit:cover}.dd-six__card>div{padding:24px}.dd-six__card p{margin:0}.dd-six__callout{display:flex;align-items:center;justify-content:space-between;gap:32px;margin-top:32px;padding:32px;background:#edf4f2}.dd-six__callout>div{max-width:65ch}.dd-six__callout p{margin:0}.dd-six__callout a{flex-shrink:0}.dd-six__muted{background:#f5f7f6}.dd-six__panel{padding:32px;background:#fff;border:1px solid var(--dd-line);height:100%}.dd-six__panel img{max-height:300px;object-fit:contain}.dd-six__muted .dd-six__wrap>p:last-child{margin:24px 0 0}.dd-six__dark{background:#14282a;color:#fff}.dd-six__dark .dd-six__eyebrow{color:#8ce0d5}.dd-six__support{display:grid;grid-template-columns:repeat(3,1fr);gap:32px;margin-top:40px}.dd-six__support article{border-top:1px solid #57706f;padding-top:24px}.dd-six__support span{display:block;color:#8ce0d5;margin-bottom:20px}.dd-six__support p{color:#d4dfdd;font-size:15px}.dd-six__details-grid{align-items:start}.dd-six details{border-bottom:1px solid var(--dd-line)}.dd-six summary{padding:20px 8px;cursor:pointer;font-weight:700}.dd-six details p{padding:0 8px 16px}.dd-six table{width:100%;border-collapse:collapse;font-size:14px;margin-bottom:20px}.dd-six th,.dd-six td{text-align:left;padding:12px;border-bottom:1px solid var(--dd-line);overflow-wrap:anywhere}.dd-six__inquiry{padding:32px;background:#eff4f2}.dd-six label{display:block;font-size:14px;font-weight:700;margin:16px 0 6px}.dd-six input:not([type=hidden]),.dd-six textarea{display:block;width:100%;padding:12px;background:#fff;border:1px solid #8ba5a1;border-radius:2px;color:#14282a;font:16px Arial,sans-serif}.dd-six textarea{resize:vertical}.dd-six form button{margin-top:20px;width:100%}.dd-six__video{margin-top:24px}.dd-six video{width:100%;max-height:650px}.dd-six__sr{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}
  @media(max-width:899px){.dd-six__split{grid-template-columns:1fr;gap:32px}.dd-six__cards{grid-template-columns:1fr}.dd-six__support{grid-template-columns:1fr 1fr}.dd-six__callout{align-items:flex-start;flex-direction:column}.dd-six__wrap{width:calc(100% - 40px)}.dd-six__hero,.dd-six__section{padding:48px 0}.dd-six__hero-image{max-width:600px}.dd-six__panel,.dd-six__inquiry{padding:24px}.dd-six__card img{max-height:360px;object-fit:contain}.dd-six__nav{gap:20px}}
  .dd-six .dd-six__hero-image img{background:transparent}
  .dd-six__camera-example{margin:32px 0;padding:24px;border:1px solid var(--dd-line)}
  @media(max-width:480px){.dd-six__support{grid-template-columns:1fr}.dd-six__facts>div{gap:12px}.dd-six dd{max-width:60%}.dd-six__callout{padding:24px}.dd-six__button{width:100%}.dd-six__actions{gap:16px}}
{% endstylesheet %}
{% schema %}
{
  "name": "DD product six modules",
  "settings": [
    {"type":"select","id":"model","label":"Product configuration","options":[{"value":"laser","label":"LZ-1390"},{"value":"router","label":"LZ-1325"}],"default":"laser"},
    {"type":"image_picker","id":"hero_image","label":"Machine image","info":"Confirm the pictured configuration. Uses the product image when blank."},
    {"type":"image_picker","id":"sample_1","label":"Application image 1"},
    {"type":"image_picker","id":"sample_2","label":"Application image 2"},
    {"type":"image_picker","id":"sample_3","label":"Application image 3"},
    {"type":"image_picker","id":"sample_4","label":"Laser camera application","info":"UV-printed acrylic processing with the optional camera. Laser model only."},
    {"type":"video","id":"processing_video","label":"Processing video"},
    {"type":"image_picker","id":"option_image","label":"Optional equipment image"},
    {"type":"image_picker","id":"case_image","label":"Customer case image"},
    {"type":"url","id":"case_url","label":"Customer case link"}
  ],
  "presets": [{"name":"DD product six modules"}]
}
{% endschema %}
