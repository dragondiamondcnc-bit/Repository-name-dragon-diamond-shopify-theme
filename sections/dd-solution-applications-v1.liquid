<section class="dd-solution-applications" aria-labelledby="DDSolutionApplications-{{ section.id }}">
  <div class="dd-solution-applications__frame">
    <header><p>{{ section.settings.eyebrow }}</p><h2 id="DDSolutionApplications-{{ section.id }}">{{ section.settings.heading }}</h2></header>
    <div class="dd-solution-applications__list">
      {% for block in section.blocks %}
        {% case forloop.index %}
          {% when 1 %}{% assign application_asset = 'co2-sign-acrylic-letter-cutting.jpg' %}
          {% when 2 %}{% assign application_asset = 'co2-acrylic-display-panel-processing.jpg' %}
          {% when 3 %}{% assign application_asset = 'co2-wood-panel-batch-cutting.jpg' %}
          {% else %}{% assign application_asset = 'co2-custom-acrylic-fabrication.jpg' %}
        {% endcase %}
        <article {{ block.shopify_attributes }}>
          <div class="dd-solution-applications__media">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1200', sizes: '(min-width: 761px) 42vw, 100vw', alt: block.settings.image_alt }}
            {% else %}
              <img src="{{ application_asset | asset_url }}" alt="{{ block.settings.image_alt | escape }}" width="1597" height="898" loading="lazy">
            {% endif %}
          </div>
          <div class="dd-solution-applications__content"><span>{{ forloop.index | prepend: '0' }}</span><h3>{{ block.settings.title }}</h3><p>{{ block.settings.description }}</p><dl><div><dt>Material</dt><dd>{{ block.settings.material }}</dd></div><div><dt>Process</dt><dd>{{ block.settings.process }}</dd></div><div><dt>Output</dt><dd>{{ block.settings.output }}</dd></div></dl></div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>
{% stylesheet %}.dd-solution-applications{background:#fff;color:#101317;font-family:'Archivo Narrow',sans-serif}.dd-solution-applications__frame{width:min(100% - 64px,1240px);margin:auto;padding:112px 0}.dd-solution-applications header{display:grid;grid-template-columns:1fr 2fr;gap:32px 64px;padding-bottom:52px;border-bottom:1px solid #c8cbcc}.dd-solution-applications header p{margin:0;color:#007f88;font-size:11px;font-weight:700;letter-spacing:.22em;text-transform:uppercase}.dd-solution-applications h2{margin:0;font-size:clamp(38px,4.5vw,62px);line-height:1;text-transform:uppercase}.dd-solution-applications article{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.12fr);gap:54px;padding:42px 0;border-bottom:1px solid #c8cbcc}.dd-solution-applications article:nth-child(even) .dd-solution-applications__media{order:2}.dd-solution-applications__media{aspect-ratio:16/10;overflow:hidden;background:#15191e}.dd-solution-applications__media img{width:100%;height:100%;object-fit:cover}.dd-solution-applications__placeholder{display:grid;place-items:center;width:100%;height:100%;color:rgba(255,255,255,.4);font-size:10px;letter-spacing:.16em;text-transform:uppercase}.dd-solution-applications__content>span{color:#00a3ad;font-size:28px;font-weight:700}.dd-solution-applications h3{margin:18px 0;font-size:30px;line-height:1;text-transform:uppercase}.dd-solution-applications__content>p{max-width:550px;margin:0 0 26px;color:#565d62;font-family:Arial,sans-serif;font-size:14px;line-height:1.65}.dd-solution-applications dl{margin:0}.dd-solution-applications dl div{display:grid;grid-template-columns:110px 1fr;padding:12px 0;border-top:1px solid #d8dadb}.dd-solution-applications dt{color:#007f88;font-size:10px;font-weight:700;letter-spacing:.15em;text-transform:uppercase}.dd-solution-applications dd{margin:0;font-size:14px;line-height:1.5}@media(max-width:760px){.dd-solution-applications__frame{width:min(100% - 40px,1240px);padding:80px 0}.dd-solution-applications header,.dd-solution-applications article{grid-template-columns:1fr}.dd-solution-applications article{gap:26px}.dd-solution-applications article:nth-child(even) .dd-solution-applications__media{order:0}.dd-solution-applications dl div{grid-template-columns:90px 1fr}}{% endstylesheet %}
{% schema %}{"name":"DD Solution Applications","max_blocks":4,"settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"PRODUCTION APPLICATIONS / 03"},{"type":"text","id":"heading","label":"Heading","default":"Production Applications"}],"blocks":[{"type":"application","name":"Application","settings":[{"type":"image_picker","id":"image","label":"Application image"},{"type":"text","id":"image_alt","label":"Image alt text"},{"type":"text","id":"title","label":"Title"},{"type":"text","id":"material","label":"Material"},{"type":"text","id":"process","label":"Process"},{"type":"text","id":"output","label":"Output"},{"type":"textarea","id":"description","label":"Description"}]}],"presets":[{"name":"DD Solution Applications"}]}{% endschema %}
