<section class="dd-solution-configuration" aria-labelledby="DDSolutionConfiguration-{{ section.id }}"><div class="dd-solution-configuration__frame"><header><p>{{ section.settings.eyebrow }}</p><div><h2 id="DDSolutionConfiguration-{{ section.id }}">{{ section.settings.heading }}</h2><p>{{ section.settings.description }}</p></div></header><div class="dd-solution-configuration__register">{% for block in section.blocks %}<article {{ block.shopify_attributes }}><span>{{ forloop.index | prepend: '0' }}</span><div><small>Production requirement</small><h3>{{ block.settings.requirement }}</h3></div><div><small>Configuration consideration</small><p>{{ block.settings.consideration }}</p></div></article>{% endfor %}</div></div></section>
{% stylesheet %}.dd-solution-configuration{background:#e7eaeb;color:#101317;font-family:'Archivo Narrow',sans-serif}.dd-solution-configuration__frame{width:min(100% - 64px,1240px);margin:auto;padding:112px 0}.dd-solution-configuration header{display:grid;grid-template-columns:1fr 2fr;gap:32px 64px;padding-bottom:50px}.dd-solution-configuration header>p{margin:0;color:#007f88;font-size:11px;font-weight:700;letter-spacing:.22em;text-transform:uppercase}.dd-solution-configuration h2{margin:0;font-size:clamp(38px,4.5vw,62px);line-height:1;text-transform:uppercase}.dd-solution-configuration header div p{max-width:650px;margin:24px 0 0;color:#565d62;font-family:Arial,sans-serif;line-height:1.6}.dd-solution-configuration__register{border-top:1px solid #9fa5a8}.dd-solution-configuration article{display:grid;grid-template-columns:80px 1fr 1.5fr;border-bottom:1px solid #b9bdc0}.dd-solution-configuration article>span{padding:28px 0;color:#00a3ad;font-size:25px}.dd-solution-configuration article>div{padding:28px;border-left:1px solid #c4c7c9}.dd-solution-configuration small{display:block;margin-bottom:9px;color:#697075;font-size:9px;font-weight:700;letter-spacing:.16em;text-transform:uppercase}.dd-solution-configuration h3,.dd-solution-configuration article p{margin:0;font-size:16px;line-height:1.45}.dd-solution-configuration h3{text-transform:uppercase}.dd-solution-configuration article p{color:#4d555a;font-family:Arial,sans-serif;font-size:14px}@media(max-width:760px){.dd-solution-configuration__frame{width:min(100% - 40px,1240px);padding:80px 0}.dd-solution-configuration header{grid-template-columns:1fr}.dd-solution-configuration article{grid-template-columns:48px 1fr}.dd-solution-configuration article>span{grid-row:1/3}.dd-solution-configuration article>div{padding:20px}.dd-solution-configuration article>div:last-child{grid-column:2;border-top:1px solid #c4c7c9}}{% endstylesheet %}
{% schema %}{"name":"DD Solution Configuration","max_blocks":6,"settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"SYSTEM CONFIGURATION / 04"},{"type":"text","id":"heading","label":"Heading","default":"Configuration Follows the Production Requirement"},{"type":"textarea","id":"description","label":"Description","default":"Final configuration depends on the actual material, thickness, working size and production target. Each application requires review before equipment selection."}],"blocks":[{"type":"configuration","name":"Configuration row","settings":[{"type":"text","id":"requirement","label":"Requirement"},{"type":"text","id":"consideration","label":"Consideration"}]}],"presets":[{"name":"DD Solution Configuration"}]}{% endschema %}
