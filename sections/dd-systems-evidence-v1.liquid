<section class="dd-systems-evidence" aria-labelledby="DDSystemsEvidenceHeading-{{ section.id }}">
  <div class="dd-systems-evidence__frame">
    <header class="dd-systems-evidence__header">
      <p class="dd-systems-evidence__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 id="DDSystemsEvidenceHeading-{{ section.id }}">{{ section.settings.heading }}</h2>
      <p>{{ section.settings.description }}</p>
    </header>
    <div class="dd-systems-evidence__register">
      {% for block in section.blocks %}
        <article class="dd-systems-evidence__record" {{ block.shopify_attributes }}>
          <div class="dd-systems-evidence__record-index"><span>Deployment record</span><strong>{{ forloop.index | prepend: '0' }}</strong></div>
          <div class="dd-systems-evidence__country"><span>Country</span><h3>{{ block.settings.country }}</h3></div>
          <div><span>Production system</span><strong>{{ block.settings.system }}</strong></div>
          <div><span>Application</span><p>{{ block.settings.application }}</p></div>
          <div class="dd-systems-evidence__status"><span>Production status</span><strong>{{ block.settings.status }}</strong></div>
          {% if block.settings.link != blank %}
            <a href="{{ block.settings.link }}" data-track="cta" data-cta-id="production_systems_case_{{ block.settings.country | handleize }}" data-section="systems_evidence" data-market="{{ block.settings.country | escape }}" data-system="{{ block.settings.system | escape }}" data-application="{{ block.settings.application | escape }}">View Case Study <span aria-hidden="true">→</span></a>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .dd-systems-evidence { background: #0f1115; color: #fff; font-family: 'Archivo Narrow', sans-serif; }
  .dd-systems-evidence__frame { width: min(100% - 64px, 1240px); margin: 0 auto; padding: 112px 0 120px; }
  .dd-systems-evidence__header { display: grid; grid-template-columns: 1fr 2fr; gap: 24px 64px; padding-bottom: 56px; border-bottom: 1px solid rgba(255,255,255,.18); }
  .dd-systems-evidence__eyebrow { margin: 0; color: #00a3ad; font-size: 11px; font-weight: 700; letter-spacing: .24em; text-transform: uppercase; }
  .dd-systems-evidence__header h2 { margin: 0; font-size: clamp(38px, 4.5vw, 62px); line-height: 1; letter-spacing: -.025em; text-transform: uppercase; }
  .dd-systems-evidence__header > p:last-child { grid-column: 2; max-width: 620px; margin: 0; color: rgba(255,255,255,.62); font-size: 17px; line-height: 1.6; }
  .dd-systems-evidence__record { position: relative; display: grid; grid-template-columns: .62fr 1fr 1.2fr 1.25fr 1fr auto; min-height: 170px; border-bottom: 1px solid rgba(255,255,255,.18); }
  .dd-systems-evidence__record::before { content: ''; position: absolute; left: 0; top: -1px; width: 0; height: 2px; background: #00a3ad; transition: width .35s ease; }
  .dd-systems-evidence__record:hover::before { width: 100%; }
  .dd-systems-evidence__record > div { min-width: 0; padding: 34px 20px 34px 0; }
  .dd-systems-evidence__record > div + div { padding-left: 20px; border-left: 1px solid rgba(255,255,255,.12); }
  .dd-systems-evidence__record span { display: block; margin-bottom: 12px; color: rgba(255,255,255,.42); font-size: 9px; font-weight: 700; letter-spacing: .17em; text-transform: uppercase; }
  .dd-systems-evidence__record-index strong { color: #00a3ad; font-size: 28px; }
  .dd-systems-evidence__country h3 { margin: 0; font-size: 24px; text-transform: uppercase; }
  .dd-systems-evidence__record div > strong { display: block; font-size: 15px; line-height: 1.45; text-transform: uppercase; }
  .dd-systems-evidence__record p { margin: 0; color: rgba(255,255,255,.68); font-size: 14px; line-height: 1.5; }
  .dd-systems-evidence__status strong { color: #62d8bf; }
  .dd-systems-evidence__record > a { align-self: stretch; display: flex; align-items: center; justify-content: center; gap: 18px; min-width: 154px; padding: 24px; border-left: 1px solid rgba(255,255,255,.18); color: #fff; font-size: 10px; font-weight: 700; letter-spacing: .14em; text-decoration: none; text-transform: uppercase; }
  .dd-systems-evidence__record > a:hover, .dd-systems-evidence__record > a:focus-visible { background: #00a3ad; color: #071014; }
  .dd-systems-evidence__record > a:focus-visible { outline: 2px solid #fff; outline-offset: -4px; }
  @media (max-width: 1040px) {
    .dd-systems-evidence__record { grid-template-columns: .5fr 1fr 1.25fr 1.25fr; }
    .dd-systems-evidence__status { grid-column: 2 / 4; border-top: 1px solid rgba(255,255,255,.12); }
    .dd-systems-evidence__record > a { grid-column: 4; grid-row: 2; border-top: 1px solid rgba(255,255,255,.12); }
  }
  @media (max-width: 760px) {
    .dd-systems-evidence__frame { width: min(100% - 40px, 1240px); padding: 80px 0; }
    .dd-systems-evidence__header { grid-template-columns: 1fr; padding-bottom: 40px; }
    .dd-systems-evidence__header > p:last-child { grid-column: 1; }
    .dd-systems-evidence__record { grid-template-columns: 50px 1fr; padding: 28px 0; }
    .dd-systems-evidence__record > div, .dd-systems-evidence__record > div + div { padding: 10px 0 10px 18px; border-left: 1px solid rgba(255,255,255,.12); }
    .dd-systems-evidence__record-index { grid-column: 1 !important; grid-row: 1 / 6; padding-left: 0 !important; border-left: 0 !important; }
    .dd-systems-evidence__country, .dd-systems-evidence__record > div, .dd-systems-evidence__status { grid-column: 2; }
    .dd-systems-evidence__status { border-top: 0; }
    .dd-systems-evidence__record > a { grid-column: 2; grid-row: auto; justify-content: flex-start; min-height: 48px; margin: 12px 0 0 18px; padding: 12px 0; border: 0; border-bottom: 1px solid #00a3ad; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "DD Systems Evidence V1",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "VERIFIED EVIDENCE / 04" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Production Systems In Operation" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Documented deployments connect system selection with real applications and operating status." }
  ],
  "blocks": [{
    "type": "evidence",
    "name": "Deployment evidence",
    "settings": [
      { "type": "text", "id": "country", "label": "Country" },
      { "type": "text", "id": "system", "label": "Production system" },
      { "type": "text", "id": "application", "label": "Application" },
      { "type": "text", "id": "status", "label": "Production status" },
      { "type": "url", "id": "link", "label": "Case study link" }
    ]
  }],
  "presets": [{ "name": "DD Systems Evidence V1" }]
}
{% endschema %}
