{% liquid
  assign form_id = 'DisplayInquiry-' | append: section.id
  assign machine_names = 'LZ-1325 CNC Router,LZ-1390 CO2 Laser Cutter,LZ-6090UV Flatbed Printer' | split: ','
%}
<div class="dd-display">
<section class="dd-display__hero"><div class="dd-display__wrap"><nav class="dd-display__crumb" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a><span>/</span><a href="{{ routes.root_url }}#HomeIndustries">Industries</a><span>/</span><span>Display &amp; Event Production</span></nav><div class="dd-display__split"><div><p class="dd-display__eyebrow">DISPLAY &amp; EVENT PRODUCTION</p><h1>CNC &amp; Laser Equipment for Displays and Event Decor</h1><p class="dd-display__lead">Turn your designs into shaped panels, acrylic details and printed display components. Plan cutting, routing and printing around your materials, finished dimensions and assembly needs.</p><div class="dd-display__actions"><a class="dd-display__button" href="#DisplayContact">Get a Display Production Solution</a><a href="#DisplayCase">See the Israel Customer Project →</a></div><p class="dd-display__note">Application testing · Equipment selection · Installation training</p></div><figure><img src="{{ 'israel-cnc-production-panel.jpg' | asset_url }}" alt="Printed bunny decoration panel on the Israel customer's CNC router" width="1080" height="1920" loading="eager" fetchpriority="high" style="object-position:center 58%"><figcaption>Real production photo from our Israel event decoration customer.</figcaption></figure></div></div></section>
<section class="dd-display__section"><div class="dd-display__wrap"><p class="dd-display__eyebrow">PLAN AROUND THE PART YOU MAKE</p><h2>From decorative panels to display components</h2><div class="dd-display__grid">
<article class="dd-display__card"><img src="{{ 'israel-workshop-cutting-bunny.jpg' | asset_url }}" alt="CNC machining a printed decoration board at the Israel customer's workshop" width="1080" height="1920" loading="lazy" style="object-position:center 54%"><div class="dd-display__body"><h3>Event decoration panels</h3><p>Shaped printed boards and themed decoration pieces. The Israel project shows an application-specific CNC setup in customer production.</p><a href="#DisplayCase">Explore the customer project →</a></div></article>
<article class="dd-display__card">{{ images['cnc-sample-decorative-panel.png'] | image_url: width: 800 | image_tag: widths: '360,600,800', sizes: '(min-width:900px) 30vw, 100vw', loading: 'lazy', alt: 'CNC-routed wooden decorative panel with cut-out details' }}<div class="dd-display__body"><h3>Decorative boards &amp; routed details</h3><p>Profile cutting and decorative routing for suitable boards. Review joints, workholding and the finished appearance before confirming the process.</p><a href="#DisplayMachines">See CNC equipment →</a></div></article>
<article class="dd-display__card">{{ images['laser-sample-acrylic-letters.jpg'] | image_url: width: 800 | image_tag: widths: '360,600,800', sizes: '(min-width:900px) 30vw, 100vw', loading: 'lazy', alt: 'Clear laser-cut acrylic letters for branded display details' }}<div class="dd-display__body"><h3>Acrylic display details</h3><p>Cut lettering and custom shapes for branded displays. Confirm material thickness, part size and edge finish with a sample test.</p><a href="{{ routes.root_url }}pages/industry-sign">Explore acrylic sign production →</a></div></article>
</div><p class="dd-display__note">The first photo shows a customer project. The other images are processing samples, not additional customer installations.</p></div></section>
<section class="dd-display__section dd-display__tint" id="DisplayMachines"><div class="dd-display__wrap"><p class="dd-display__eyebrow">EQUIPMENT THAT FITS YOUR WORKFLOW</p><h2>Choose the process before the machine</h2><div class="dd-display__grid">
<article class="dd-display__card dd-display__machine">{{ images['lz-1325-standard-cutout-v1.png'] | image_url: width: 800 | image_tag: loading: 'lazy', alt: 'LZ-1325 CNC router' }}<div class="dd-display__body"><h3>LZ-1325 CNC Router</h3><p>For suitable panel cutting, routed profiles and decorative details.</p><ul><li>3.0 kW water-cooled spindle</li><li>Aluminum profile + PVC worktable</li><li>Optional vacuum table + vacuum pump</li></ul><a class="dd-display__button" href="{{ routes.root_url }}products/lz-1325-cnc-router">View CNC Router</a></div></article>
<article class="dd-display__card dd-display__machine">{{ images['lz-1390-cutout-v1.png'] | image_url: width: 800 | image_tag: loading: 'lazy', alt: 'LZ-1390 CO2 laser cutter' }}<div class="dd-display__body"><h3>LZ-1390 CO2 Laser Cutter</h3><p>For acrylic lettering and suitable non-metal display components.</p><ul><li>150W CO2 laser</li><li>S&amp;A CW5200 chiller and blade table</li><li>Optional camera for printed-graphic contour cutting</li></ul><a class="dd-display__button" href="{{ routes.root_url }}products/lz-1390-industrial-co2-laser-cutting-machine">View CO2 Laser Cutter</a></div></article>
<article class="dd-display__card dd-display__machine">{{ images['lz-6090uv-cutout-v2.png'] | image_url: width: 800 | image_tag: loading: 'lazy', alt: 'LZ-6090UV flatbed printer' }}<div class="dd-display__body"><h3>LZ-6090UV Flatbed Printer</h3><p>For printing graphics on suitable flat display components.</p><ul><li>600 × 900 mm printing area</li><li>XP600 / I1600 / I3200 printhead options</li><li>Substrate adhesion confirmed through testing</li></ul><a class="dd-display__button" href="{{ routes.root_url }}products/lz-6090uv-uv-flatbed-printer">View UV Flatbed Printer</a></div></article>
</div><p class="dd-display__note">Large event panels may require a different printing format. The LZ-6090UV is not presented as the printer used in the Israel project. Match every machine's working area to your actual parts.</p></div></section>
<section class="dd-display__section"><div class="dd-display__wrap dd-display__split"><div><p class="dd-display__eyebrow">FROM ARTWORK TO ASSEMBLY</p><h2>Confirm the whole production process</h2><p>A display part has to fit the artwork, the material and the final assembly. Share the complete design so we can evaluate the processing sequence before recommending equipment.</p><a class="dd-display__button" href="#DisplayContact">Request a Free Sample Test</a></div><ol class="dd-display__steps"><li><h3>01 · Review the design and substrate</h3><p>Confirm material composition, coating, thickness, overall size and assembly details.</p></li><li><h3>02 · Plan printing and alignment</h3><p>For printed parts, review registration and cutting alignment. Do not assume camera registration is included in a standard CNC configuration.</p></li><li><h3>03 · Test cutting, routing and holding</h3><p>Check tooling, clamping or vacuum workholding and the required edge or surface finish.</p></li><li><h3>04 · Review the sample and proposal</h3><p>Confirm fit, appearance and the final equipment configuration before order agreement.</p></li></ol></div></section>
<section class="dd-display__section dd-display__tint" id="DisplayCase"><div class="dd-display__wrap dd-display__split"><figure><img src="{{ 'israel-cnc-production-panel.jpg' | asset_url }}" alt="Israel customer's printed event decoration panel on an LZ-1325 CNC router" width="1080" height="1920" loading="lazy" style="max-height:530px;object-fit:contain"><figcaption>Customer-specific equipment and production example.</figcaption></figure><div><p class="dd-display__eyebrow">ISRAEL · EVENT DECORATION</p><h2>A customer project from factory visit to workshop use</h2><p>The Israel customer produces customized event decoration, including themed panels and printed board components. Their LZ-1325 project includes factory evaluation, shipment preparation, arrival and remote commissioning support.</p><p>Customer workshop photos show the machine processing printed decoration panels. The full case documents the project stages and equipment supplied.</p><p class="dd-display__note">Historical project equipment is not a specification for the current standard model. Printing equipment, registration features and final configuration must be confirmed for your order.</p><a class="dd-display__button" href="{{ routes.root_url }}pages/case-study-israel">Read the Israel Case Study</a></div></div></section>
<section class="dd-display__section"><div class="dd-display__wrap dd-display__split"><div><h2>Practical support for your workshop</h2><p>We provide English manuals and videos, remote installation training, technical support and equipment-specific spare parts. On-site training can be arranged according to the project.</p><p>Delivery timing and final configuration are agreed for each order.</p><a href="{{ routes.root_url }}#HomeFactory">Meet Our Factory &amp; Team →</a></div><div class="dd-display__faq"><h2>Display production FAQ</h2>
<details><summary>Can the CNC router cut my display board?</summary><p>Send the exact board type, thickness, coating and artwork. Tooling and workholding must match the material. We use a sample test to assess the finish and suitability.</p></details>
<details><summary>Can I cut printed boards into custom shapes?</summary><p>Yes, suitable printed-board projects can be evaluated for CNC processing. Alignment, registration and fixture requirements depend on your setup; the Israel case does not mean every standard machine includes automatic camera registration.</p></details>
<details><summary>Is the 6090 UV printer suitable for large backdrops?</summary><p>Its printing area is 600 × 900 mm. Share your largest piece dimensions so we can assess whether this format fits your work or a different printer is needed.</p></details>
<details><summary>Can I use a CO2 laser for all foam or plastic boards?</summary><p>No. Material names alone are not enough to determine laser suitability. Provide the exact composition and coating for review. PVC must not be processed with a CO2 laser.</p></details>
<details><summary>How do I request a sample test?</summary><p>Send your artwork, material specifications, finished size and assembly requirements. The sample test is free; shipping arrangements, if needed, are agreed separately.</p></details>
</div></div></section>
  <section class="dd-display__section" id="DisplayContact"><div class="dd-display__wrap dd-display__split"><div><p class="dd-display__eyebrow">TELL US WHAT YOU WANT TO MAKE</p><h2>Get an equipment proposal for your display workshop</h2><p>Share your material, thickness, finished size and production requirements. We will help you plan the equipment and a free sample test.</p><p><a href="mailto:info@gzcnc-laser.com">info@gzcnc-laser.com</a><br><a href="https://wa.me/8618988946615">WhatsApp: +86 189 8894 6615</a></p><p class="dd-display__note">Need to share artwork or photos? Send them by email or WhatsApp. Name, email and message are required.</p></div>
    {% form 'contact', id: form_id %}
      <input type="hidden" name="contact[Source]" value="Display and advertising industry page">
      {% if form.posted_successfully? %}<div class="dd-display__success" role="status" tabindex="-1" data-display-success><strong>Thank you — your inquiry has been sent.</strong><p>Our team will review your requirements and contact you by email. You do not need to submit the same inquiry again.</p></div><dialog data-display-dialog aria-labelledby="DisplaySuccessTitle"><h2 id="DisplaySuccessTitle">Inquiry sent successfully</h2><p>Thank you for contacting Dragon Diamond. Our team will review your requirements and contact you by email.</p><button type="button" class="dd-display__button" data-display-close>Got it</button></dialog>{% endif %}
      {% if form.errors %}<div role="alert">{{ form.errors | default_errors }}</div>{% endif %}
      <div class="dd-display__fields"><div><label for="SignName-{{ section.id }}">Name *</label><input id="SignName-{{ section.id }}" name="contact[name]" autocomplete="name" value="{{ form.name | escape }}" required></div><div><label for="SignEmail-{{ section.id }}">Email *</label><input id="SignEmail-{{ section.id }}" name="contact[email]" type="email" autocomplete="email" value="{{ form.email | escape }}" required></div><div><label for="SignCompany-{{ section.id }}">Company</label><input id="SignCompany-{{ section.id }}" name="contact[Company]" autocomplete="organization" value="{{ form.Company | escape }}"></div><div><label for="SignWA-{{ section.id }}">WhatsApp</label><input id="SignWA-{{ section.id }}" name="contact[WhatsApp]" type="tel" autocomplete="tel" value="{{ form.WhatsApp | escape }}"></div></div>
      <label for="SignProduct-{{ section.id }}">Product Interested</label><select id="SignProduct-{{ section.id }}" name="contact[Product Interested]"><option>Display equipment combination / need advice</option>{% for name in machine_names %}<option>{{ name }}</option>{% endfor %}<option>Other display production equipment</option></select>
      <label for="SignMessage-{{ section.id }}">Message *</label><textarea id="SignMessage-{{ section.id }}" name="contact[body]" rows="5" placeholder="Material, thickness, finished size, production needs and destination country..." required>{{ form.body | escape }}</textarea><button type="submit" class="dd-display__button">Send Inquiry</button>
    {% endform %}
  </div></section>
</div>
