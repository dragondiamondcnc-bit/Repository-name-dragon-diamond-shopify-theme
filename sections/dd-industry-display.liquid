{% javascript %}
function initDisplayFeedback(){document.querySelectorAll('[data-display-dialog]').forEach(dialog=>{if(dialog.dataset.ready)return;dialog.dataset.ready='true';const status=dialog.closest('form').querySelector('[data-display-success]');dialog.querySelector('[data-display-close]').addEventListener('click',()=>dialog.close());dialog.addEventListener('close',()=>status.focus());if(typeof dialog.showModal==='function')dialog.showModal();else status.focus();});}
initDisplayFeedback();document.addEventListener('shopify:section:load',initDisplayFeedback);
{% endjavascript %}
