-columns:repeat(3,minmax(0,1fr));gap:24px;margin-top:30px}.dd-display__two{display:grid;grid-template-columns:1fr 1fr;gap:26px;margin-top:30px}.dd-display__card{border:1px solid #d6e2e2;border-radius:8px;overflow:hidden;background:#fff;display:flex;flex-direction:column}.dd-display__card img{aspect-ratio:16/10;object-fit:cover}.dd-display__body{padding:24px;flex:1;display:flex;flex-direction:column}.dd-display__body>a:last-child{margin-top:auto}.dd-display__body ul{padding-left:20px;margin:0 0 24px;font-size:15px}.dd-display__machine>a{background:#e8f0ef}.dd-display__machine img{object-fit:contain;padding:18px;aspect-ratio:4/3}.dd-display__panel{padding:26px;background:#fff;border-radius:8px;border-top:3px solid #087f82}.dd-display__panel p{margin:0}.dd-display__steps{list-style:none;margin:0;padding:0;border-left:2px solid #83c9c5}.dd-display__steps li{padding:0 0 20px 26px}.dd-display__steps li:last-child{padding-bottom:0}.dd-display__steps h3{font-size:21px}.dd-display__faq details{border-bottom:1px solid #b9cecc}.dd-display__faq summary{padding:18px 0;min-height:48px;cursor:pointer;font-weight:700}.dd-display__faq details p{padding:0 0 16px}.dd-display__fields{display:grid;grid-template-columns:1fr 1fr;gap:0 18px}.dd-display label{display:block;margin-bottom:6px;font-size:15px;font-weight:700}.dd-display input,.dd-display textarea,.dd-display select{display:block;width:100%;max-width:100%;min-height:48px;padding:12px;border:1px solid #a8c0c0;border-radius:4px;background:#fff;color:#163237;font:16px/1.4 Arial,sans-serif;margin-bottom:18px}.dd-display textarea{resize:vertical}.dd-display [id]{scroll-margin-top:125px}.dd-display :focus-visible{outline:3px solid #d18b24;outline-offset:4px}.dd-display__success{padding:20px;background:#e0f5ee;border:2px solid #087c80;margin-bottom:24px;border-radius:6px}.dd-display dialog{max-width:520px;width:calc(100% - 32px);padding:30px;border:0;border-radius:10px;color:#163237}.dd-display dialog::backdrop{background:#082429b3}.dd