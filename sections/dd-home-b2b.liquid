{% javascript %}
function showInquiryConfirmation() {
 document.querySelectorAll('[data-inquiry-confirmation]').forEach(dialog => {
  if (dialog.dataset.ready) return;
  dialog.dataset.ready = 'true';
  const message = dialog.previousElementSibling;
  message.scrollIntoView({block:'center',behavior:'instant'});
  dialog.querySelector('[data-inquiry-close]').addEventListener('click',()=>dialog.close());
  dialog.addEventListener('close',()=>message.focus({preventScroll:true}));
  if (typeof dialog.showModal === 'function') dialog.showModal();
  else message.focus();
 });
}
if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded',showInquiryConfirmation);
else showInquiryConfirmation();
document.addEventListener('shopify:section:load',showInquiryConfirmation);

document.addEventListener('click', (event) => {
  const link = event.target.closest('[data-category-inquiry]');
  if (!link) return;
  const section = link.closest('.dd-home-b2b');
  const select = section?.querySelector('select[name="contact[Product Interested]"]');
  if (select) { select.value = link.dataset.categoryInquiry; select.dispatchEvent(new Event('change', { bubbles: true })); }
});

function initCuttingPreviews(root = document) {
  root.querySelectorAll('[data-cutting-preview]').forEach(media => {
    if (media.dataset.previewReady) return;
    media.dataset.previewReady = 'true';
    const video = media.querySelector('video');
    const button = media.querySelector('button');
    const label = button.querySelector('[data-video-label]');
    const status = media.querySelector('[role="status"]');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    let wanted = false;
    const stop = () => {
      wanted = false; video.pause(); media.classList.remove('is-playing');
      button.setAttribute('aria-pressed', 'false'); label.textContent = button.dataset.playLabel;
    };
    const fail = () => { stop(); status.textContent = status.dataset.failure; };
    const play = async () => {
      wanted = true; status.textContent = '';
      if (!video.getAttribute('src')) video.src = video.dataset.src;
      video.muted = true;
      try {
        await video.play();
        if (!wanted || !media.isConnected || document.hidden) { video.pause(); return; }
        media.classList.add('is-playing');button.setAttribute('aria-pressed', 'true');label.textContent = button.dataset.stopLabel;
      } catch (error) { if (wanted) fail(); }
    };
    media.addEventListener('pointerenter', event => { if (event.pointerType === 'mouse' && !reduced.matches) play(); });
    media.addEventListener('pointerleave', event => { if (event.pointerType === 'mouse') stop(); });
    button.addEventListener('click', () => { if (wanted) stop(); else play(); });
    media.addEventListener('keydown', event => { if (event.key === 'Escape') stop(); });
    media.addEventListener('focusout', event => { if (!media.contains(event.relatedTarget)) stop(); });
    video.addEventListener('error', fail);
    const visibility = () => { if (document.hidden) stop(); };
    document.addEventListener('visibilitychange', visibility);
    const observer = new IntersectionObserver(entries => { if (!entries[0].isIntersecting) stop(); }, { threshold: 0 });
    observer.observe(media);
    const unload = event => { if (event.target.contains(media)) { stop(); observer.disconnect(); document.removeEventListener('visibilitychange', visibility); document.removeEventListener('shopify:section:unload', unload); } };
    document.addEventListener('shopify:section:unload', unload);
  });
}
initCuttingPreviews();
document.addEventListener('shopify:section:load', event => initCuttingPreviews(event.target));
