{% liquid
  assign inquiry_id = 'HomeInquiry-' | append: section.id
  assign laser_url = '/products/lz-1390-industrial-co2-laser-cutting-machine'
  assign router_url = '/products/lz-1325-cnc-router'
  assign hero_process_image = section.settings.hero_process_image | default: section.settings.sample_2
%}
<script type="application/ld+json">
{"@context":"https://schema.org","@graph":[{"@type":"Organization","@id":{{ request.origin | append: '/#organization' | json }},"name":"Dragon Diamond","legalName":"Guangzhou Dragon Diamond Technology Co., Ltd.","foundingDate":"2012","email":"info@gzcnc-laser.com","telephone":"+8618988946615","sameAs":["https://www.facebook.com/dragondiamondcnc"],"url":{{ request.origin | json }},"description":{{ 'dd_home.seo_description' | t | json }}},{"@type":"WebSite","@id":{{ request.origin | append: '/#website' | json }},"name":"Dragon Diamond","url":{{ request.origin | json }},"publisher":{"@id":{{ request.origin | append: '/#organization' | json }}}}]}
</script>
<div class="dd-home-b2b">
  <section class="dd-home-b2b__hero">
    {% if hero_process_image != blank %}{{ hero_process_image | image_url: width: 2000 | image_tag: widths: '480, 750, 1200, 1600, 2000', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: '', class: 'dd-home-b2b__process-background' }}{% endif %}
    <div class="dd-home-b2b__wrap dd-home-b2b__hero-layout">
      <div class="dd-home-b2b__hero-copy">
        <p class="dd-home-b2b__eyebrow">{{ 'dd_home.eyebrow' | t }}</p>
        <h1>{{ 'dd_home.title' | t }}</h1>
        <p class="dd-home-b2b__lead">{{ 'dd_home.intro' | t }}</p>
        <div class="dd-home-b2b__actions"><a class="dd-home-b2b__button" href="#{{ inquiry_id }}">{{ 'dd_home.quote' | t }}</a><a class="dd-home-b2b__secondary" href="#HomeCategories">{{ 'dd_home.explore' | t }}</a></div>
        <p class="dd-home-b2b__note">{{ 'dd_home.hero_note' | t }}</p>
      </div>
      <p class="dd-home-b2b__process-caption">{{ 'dd_home.process_caption' | t }}</p>
    </div>
  </section>
<div class="dd-home-b2b__trust" aria-label="Company facts"><div class="dd-home-b2b__wrap"><span><strong>2012</strong> {{ 'dd_home.trust_established' | t }}</span><span><strong>2,000 m²</strong> {{ 'dd_home.trust_factory' | t }}</span><a href="#{{ inquiry_id }}">{{ 'dd_home.sample_test' | t }} →</a></div></div>
<section class="dd-home-b2b__section" id="HomeCategories"><div class="dd-home-b2b__wrap"><p class="dd-home-b2b__eyebrow">{{ 'dd_home.equipment_eyebrow' | t }}</p><h2>{{ 'dd_home.equipment_title' | t }}</h2><p class="dd-home-b2b__lead">{{ 'dd_home.categories_intro' | t }}</p><div class="dd-home-b2b__equipment-grid">
{% for i in (1..6) %}{% liquid
assign title_key = 'dd_home.category_' | append: i
assign use_key = 'dd_home.equipment_use_' | append: i
assign image_key = 'category_image_' | append: i
assign name_key = 'category_model_' | append: i
assign link_key = 'category_product_' | append: i
assign machine_image = section.settings[image_key]
assign machine_name = section.settings[name_key]
assign machine_link = section.settings[link_key]
assign category_link = blank
if i == 1
assign machine_image = section.settings.laser_image
assign machine_name = 'LZ-1390'
assign machine_link = laser_url
assign category_link = '/collections/co2-laser'
elsif i == 2
assign machine_image = section.settings.router_image
assign machine_name = 'LZ-1325'
assign machine_link = router_url
assign category_link = '/collections/cnc-router'
elsif i == 3
assign category_link = '/collections/laser-marking'
elsif i == 4
assign category_link = '/collections/fiber-laser-cutting'
elsif i == 5
assign category_link = '/collections/laser-welding'
elsif i == 6
assign category_link = '/collections/printers'
endif
assign image_alt = title_key | t | prepend: ' ' | prepend: machine_name
%}
<article class="dd-home-b2b__equipment-card" id="HomeCategory-{{ i }}"><div class="dd-home-b2b__equipment-heading"><span>0{{ i }}</span><h3>{{ title_key | t }}</h3></div>
<div class="dd-home-b2b__equipment-photo" {% if i <= 6 %}data-cutting-preview{% endif %}>{% if machine_image != blank %}{{ machine_image | image_url: width: 900 | image_tag: widths: '360, 600, 900', sizes: '(min-width: 1000px) 30vw, (min-width: 701px) 45vw, 90vw', loading: 'lazy', alt: image_alt }}{% else %}<div class="dd-home-b2b__photo-placeholder"><span aria-hidden="true">＋</span><p>{{ 'dd_home.photo_pending' | t }}</p></div>{% endif %}{% if i <= 6 %}<video class="dd-home-b2b__cutting-video" data-src="{% if i == 1 %}{{ 'co2-camera-cutting-card-8s.mp4' | asset_url }}{% elsif i == 2 %}{{ 'cnc-wood-routing-card-7s.mp4' | asset_url }}{% elsif i == 3 %}{{ 't5-fiber-marking-card-8s.mp4' | asset_url }}{% elsif i == 4 %}{{ 'fiber-metal-cutting-card-6s.mp4' | asset_url }}{% elsif i == 5 %}{{ 'laser-welding-card-8s.mp4' | asset_url }}{% else %}{{ 'uv-flatbed-printing-card-8s.mp4' | asset_url }}{% endif %}" id="CuttingVideo-{{ section.id }}-{{ i }}" preload="none" muted loop playsinline aria-label="{% if i == 1 %}{{ 'dd_home.cutting_video_label' | t | escape }}{% elsif i == 2 %}{{ 'dd_home.cnc_video_label' | t | escape }}{% elsif i == 3 %}{{ 'dd_home.marking_video_label' | t | escape }}{% elsif i == 4 %}{{ 'dd_home.fiber_cutting_video_label' | t | escape }}{% elsif i == 5 %}{{ 'dd_home.welding_video_label' | t | escape }}{% else %}{{ 'dd_home.printer_video_label' | t | escape }}{% endif %}"></video>{% if i == 5 %}<span class="dd-home-b2b__video-speed">{{ 'dd_home.welding_video_speed' | t }}</span>{% endif %}<button type="button" class="dd-home-b2b__video-toggle" aria-controls="CuttingVideo-{{ section.id }}-{{ i }}" aria-pressed="false" data-play-label="{{ 'dd_home.watch_cutting' | t | escape }}" data-stop-label="{{ 'dd_home.stop_video' | t | escape }}"><span aria-hidden="true">▶</span> <span data-video-label>{{ 'dd_home.watch_cutting' | t }}</span></button><span class="dd-home-b2b__video-status" role="status" aria-live="polite" data-failure="{{ 'dd_home.video_error' | t | escape }}"></span>{% endif %}</div>
<div class="dd-home-b2b__equipment-copy"><p class="dd-home-b2b__equipment-model">{% if machine_name != blank %}{{ machine_name | escape }}{% else %}{{ 'dd_home.model_pending' | t }}{% endif %}</p><p class="dd-home-b2b__equipment-use">{{ use_key | t }}</p>{% if i == 3 %}<p class="dd-home-b2b__equipment-types">Fiber · CO2 · UV</p>{% elsif i == 6 %}<p class="dd-home-b2b__equipment-types">UV Flatbed · DTF · UV DTF · Eco Solvent</p>{% endif %}<div class="dd-home-b2b__equipment-actions">{% if machine_link != blank %}<a class="dd-home-b2b__button" href="{{ machine_link }}">{{ 'dd_home.machine_details' | t }}</a>{% else %}<a class="dd-home-b2b__button" data-category-inquiry="{{ title_key | t | escape }}" href="#{{ inquiry_id }}">{{ 'dd_home.quote' | t }}</a>{% endif %}{% if category_link != blank %}<a class="dd-home-b2b__textlink" href="{{ category_link }}">{{ 'dd_home.category' | t }} →</a>{% endif %}</div></div></article>
{% endfor %}</div></div></section>
<section class="dd-home-b2b__section dd-home-b2b__tint" id="HomeIndustries">
    <div class="dd-home-b2b__wrap"><p class="dd-home-b2b__eyebrow">{{ 'dd_home.applications_eyebrow' | t }}</p><h2>{{ 'dd_home.applications_title' | t }}</h2>
      <div class="dd-home-b2b__grid dd-home-b2b__applications">{% for i in (1..5) %}{% assign title_key = 'dd_home.application_' | append: i %}{% assign body_key = title_key | append: '_body' %}<article><span class="dd-home-b2b__number">0{{ i }}</span><h3>{{ title_key | t }}</h3><p>{{ body_key | t }}</p><p class="dd-home-b2b__industry-links">{% case i %}{% when 1 %}<a href="{{ laser_url }}">CO2 Laser</a> · <a href="/products/lz-6090uv-uv-flatbed-printer">UV Printer</a> · <a href="{{ router_url }}">CNC Router</a>{% when 2 %}<a href="{{ laser_url }}">CO2 Laser</a> · <a href="{{ router_url }}">CNC Router</a>{% when 3 %}<a href="{{ router_url }}">CNC Router</a>{% when 4 %}<a href="{{ routes.collections_url }}/co2-laser">CO2 Laser Options</a>{% when 5 %}<a href="{{ laser_url }}">CO2 Laser</a> · <a href="{{ router_url }}">CNC Router</a> · <a href="{{ routes.collections_url }}/laser-marking">Laser Marking</a>{% endcase %}</p>{% if i == 1 %}<a class="dd-home-b2b__workflow-link" href="{{ routes.root_url }}pages/industry-sign">Explore Signage Solutions →</a>{% elsif i == 2 %}<a class="dd-home-b2b__workflow-link" href="{{ routes.root_url }}pages/industry-display">Explore Display Solutions →</a>{% elsif i == 3 %}<a class="dd-home-b2b__workflow-link" href="{{ routes.root_url }}pages/industry-furniture">Explore Woodworking Solutions →</a>{% else %}<a class="dd-home-b2b__workflow-link" href="#{{ inquiry_id }}">{{ 'dd_home.application_cta' | t }} →</a>{% endif %}</article>{% endfor %}</div>
<div id="HomeSamples" class="dd-home-b2b__integrated-samples">
    <div><p class="dd-home-b2b__eyebrow">{{ 'dd_home.samples_eyebrow' | t }}</p><h3>{{ 'dd_home.samples_title' | t }}</h3><p class="dd-home-b2b__lead">{{ 'dd_home.samples_intro' | t }}</p>
      <div class="dd-home-b2b__grid dd-home-b2b__grid--three">{% for i in (1..3) %}{% assign image_key = 'sample_' | append: i %}{% assign title_key = 'dd_home.sample_' | append: i %}{% assign body_key = title_key | append: '_body' %}{% assign image_alt = title_key | t %}<article class="dd-home-b2b__sample">{% if section.settings[image_key] != blank %}{{ section.settings[image_key] | image_url: width: 800 | image_tag: widths: '360, 600, 800', sizes: '(min-width: 900px) 30vw, 100vw', loading: 'lazy', alt: image_alt }}{% endif %}<h3>{{ title_key | t }}</h3><p>{{ body_key | t }}</p><a href="{% if i == 3 %}{{ router_url }}{% else %}{{ laser_url }}{% endif %}">{{ 'dd_home.sample_cta' | t }} →</a></article>{% endfor %}</div>
    </div>
  </div>
    </div>
  </section>
<section class="dd-home-b2b__section dd-home-b2b__tint" id="HomeCases"><div class="dd-home-b2b__wrap"><p class="dd-home-b2b__eyebrow">{{ 'dd_home.cases_eyebrow' | t }}</p><h2>{{ 'dd_home.cases_title' | t }}</h2><p class="dd-home-b2b__lead">{{ 'dd_home.cases_intro' | t }}</p>
{% assign case_links = '/pages/case-uganda-sign-factory||/pages/case-study-ethiopia||/pages/case-study-israel||/pages/case-study-georgia' | split: '||' %}
{% assign case_images = 'https://cdn.shopify.com/s/files/1/0824/6319/5356/files/dd-section04-uganda-signage-output.webp?v=1782870242||https://cdn.shopify.com/s/files/1/0824/6319/5356/files/dd-section04-ethiopia-machine-testing.webp?v=1782870267||https://cdn.shopify.com/s/files/1/0824/6319/5356/t/1/assets/israel-factory-visit-hero.jpg?v=1780650886||https://cdn.shopify.com/s/files/1/0824/6319/5356/files/dd-section04-georgia-workshop-installed.jpg?v=1782883817' | split: '||' %}
<div class="dd-home-b2b__grid dd-home-b2b__grid--two dd-home-b2b__cases">{% for i in (1..4) %}{% assign ix = i | minus: 1 %}{% assign key = 'dd_home.case_' | append: i %}{% assign body_key = key | append: '_body' %}{% assign alt_key = key | append: '_alt' %}{% assign alt_text = alt_key | t %}{% assign image_key = 'case_image_' | append: i %}<article class="dd-home-b2b__case"><a href="{{ case_links[ix] }}">{% if section.settings[image_key] != blank %}{{ section.settings[image_key] | image_url: width: 900 | image_tag: widths: '480, 720, 900', sizes: '(min-width: 801px) 45vw, 90vw', loading: 'lazy', alt: alt_text }}{% else %}<img src="{{ case_images[ix] }}" alt="{{ alt_text | escape }}" width="900" height="600" loading="lazy">{% endif %}</a><div><h3><a href="{{ case_links[ix] }}">{{ key | t }}</a></h3><p>{{ body_key | t }}</p><a class="dd-home-b2b__textlink" href="{{ case_links[ix] }}">{{ 'dd_home.view_case' | t }} →</a></div></article>{% endfor %}</div><p class="dd-home-b2b__case-note">{{ 'dd_home.cases_note' | t }}</p></div></section>
<section class="dd-home-b2b__section dd-home-b2b__tint" id="HomeFactory"><div class="dd-home-b2b__wrap">
<div class="dd-home-b2b__company-intro"><div><p class="dd-home-b2b__eyebrow">{{ 'dd_home.company_eyebrow' | t }}</p><h2>{{ 'dd_home.company_heading' | t }}</h2><p class="dd-home-b2b__lead">{{ 'dd_home.company_intro' | t }}</p><ul class="dd-home-b2b__company-facts"><li><strong>2012</strong><span>{{ 'dd_home.trust_established' | t }}</span></li><li><strong>2,000 m²</strong><span>{{ 'dd_home.factory_area' | t }}</span></li><li><strong>Guangzhou</strong><span>China</span></li></ul><p>{{ 'dd_home.company_location' | t }}</p><a class="dd-home-b2b__button" href="#{{ inquiry_id }}">{{ 'dd_home.visit_cta' | t }}</a></div><figure>{% if section.settings.company_factory_image != blank %}{{ section.settings.company_factory_image | image_url: width: 1200 | image_tag: widths: '480, 750, 1000, 1200', sizes: '(min-width: 801px) 44vw, 90vw', loading: 'lazy', alt: 'Customers and the Dragon Diamond team at our Guangzhou factory' }}{% endif %}<figcaption>{{ 'dd_home.company_factory_caption' | t }}</figcaption></figure></div>
<div class="dd-home-b2b__company-grid">{% for i in (1..4) %}{% liquid
 assign photo_key = 'company_photo_' | append: i
 assign heading_key = 'dd_home.company_card_' | append: i
 assign body_key = heading_key | append: '_body'
 assign alt_key = heading_key | append: '_alt'
 assign photo_alt = alt_key | t
 assign photo = section.settings[photo_key]
%}<article>{% if photo != blank %}<a class="dd-home-b2b__company-photo" href="{{ photo | image_url: width: 2000 }}" target="_blank" rel="noopener" aria-label="{{ photo_alt | escape }} — open full photograph">{{ photo | image_url: width: 900 | image_tag: widths: '360, 600, 900', sizes: '(min-width: 801px) 22vw, 85vw', loading: 'lazy', alt: photo_alt }}<span aria-hidden="true">↗</span></a>{% endif %}<div><h3>{{ heading_key | t }}</h3><p>{{ body_key | t }}</p></div></article>{% endfor %}</div>
<p class="dd-home-b2b__company-projects">{{ 'dd_home.company_projects' | t }} <a href="#HomeCases">{{ 'dd_home.company_projects_cta' | t }} →</a></p>
<div id="HomeCertificates" class="dd-home-b2b__certificates"><div class="dd-home-b2b__cert-intro"><div><h3>{{ 'dd_home.cert_heading' | t }}</h3><p>{{ 'dd_home.cert_intro' | t }}</p></div><a class="dd-home-b2b__textlink" href="#{{ inquiry_id }}">{{ 'dd_home.cert_cta' | t }} →</a></div><details class="dd-home-b2b__cert-library"><summary>{{ 'dd_home.cert_view' | t }}<span aria-hidden="true">＋</span></summary><p class="dd-home-b2b__cert-scope">{{ 'dd_home.cert_scope' | t }}</p><div class="dd-home-b2b__cert-grid">{% for i in (1..6) %}{% liquid
 assign cert_key = 'company_certificate_' | append: i
 assign title_key = 'dd_home.certificate_' | append: i
 assign scope_key = title_key | append: '_scope'
 assign number_key = title_key | append: '_number'
 assign date_key = title_key | append: '_date'
 assign certificate = section.settings[cert_key]
 assign cert_alt = title_key | t | append: ' — UDEM attestation of conformity'
%}<article>{% if certificate != blank %}<a href="{{ certificate | image_url: width: 2000 }}" target="_blank" rel="noopener" aria-label="{{ cert_alt | escape }} — open document">{{ certificate | image_url: width: 600 | image_tag: widths: '240, 400, 600', sizes: '(min-width: 801px) 26vw, 80vw', loading: 'lazy', alt: cert_alt }}</a>{% endif %}<h4>{{ title_key | t }}</h4><p>{{ scope_key | t }}</p><p class="dd-home-b2b__cert-number">{{ number_key | t }}</p><p>{{ date_key | t }}</p>{% if certificate != blank %}<a href="{{ certificate | image_url: width: 2000 }}" target="_blank" rel="noopener">{{ 'dd_home.cert_open' | t }} ↗</a>{% endif %}</article>{% endfor %}</div></details></div>
<div id="HomeSupport" class="dd-home-b2b__delivery-support"><h3>{{ 'dd_home.support_title' | t }}</h3><div class="dd-home-b2b__support-details">{% for i in (1..5) %}{% assign title_key = 'dd_product.common.service_' | append: i %}{% assign body_key = title_key | append: '_body' %}<details><summary>{{ title_key | t }}</summary><p>{{ body_key | t }}</p></details>{% endfor %}</div><p class="dd-home-b2b__support-note">{{ 'dd_home.support_note' | t }}</p></div>
</div></section>
<section class="dd-home-b2b__section" id="HomeProcess"><div class="dd-home-b2b__wrap"><h2>{{ 'dd_home.process_title' | t }}</h2><ol class="dd-home-b2b__compact-steps">{% for i in (1..5) %}{% assign title_key = 'dd_home.phase_' | append: i %}{% assign body_key = title_key | append: '_body' %}<li><span class="dd-home-b2b__number">0{{ i }}</span><h3>{{ title_key | t }}</h3><p>{{ body_key | t }}</p></li>{% endfor %}</ol><details class="dd-home-b2b__full-process"><summary>{{ 'dd_home.full_process' | t }}</summary><ol>{% for i in (1..9) %}{% assign title_key = 'dd_home.step_' | append: i %}{% assign body_key = title_key | append: '_body' %}<li><strong>{{ title_key | t }}</strong> — {{ body_key | t }}</li>{% endfor %}</ol></details><p>{{ 'dd_home.lead_time' | t }}</p></div></section>
<section class="dd-home-b2b__section dd-home-b2b__tint" id="HomeFAQ"><div class="dd-home-b2b__wrap"><h2>{{ 'dd_home.faq_title' | t }}</h2><div class="dd-home-b2b__faq">{% for i in (1..6) %}{% assign q = 'dd_home.faq_' | append: i %}{% assign a = q | append: '_answer' %}<details><summary>{{ q | t }}</summary><p>{{ a | t }}</p></details>{% endfor %}</div></div></section>
<section class="dd-home-b2b__section" id="HomeContact">
    <div class="dd-home-b2b__wrap dd-home-b2b__split"><div><p class="dd-home-b2b__eyebrow">{{ 'dd_home.inquiry_eyebrow' | t }}</p><h2>{{ 'dd_home.inquiry_title' | t }}</h2><p class="dd-home-b2b__lead">{{ 'dd_home.inquiry_body' | t }}</p><p>{{ 'dd_home.inquiry_note' | t }}</p><p><a href="mailto:info@gzcnc-laser.com">info@gzcnc-laser.com</a><br><a href="https://wa.me/8618988946615">WhatsApp: +86 189 8894 6615</a></p></div>
      {% form 'contact', id: inquiry_id %}
        <input type="hidden" name="contact[Source]" value="Homepage production inquiry">
        {% if form.posted_successfully? %}
<div class="dd-inquiry-success" id="InquirySuccess-{{ section.id }}" tabindex="-1" role="status"><strong>Thank you — your inquiry has been sent.</strong><p>Our team will review your requirements and contact you by email. You do not need to submit the same inquiry again.</p></div>
<dialog class="dd-inquiry-confirmation" aria-labelledby="InquirySuccessTitle-{{ section.id }}" data-inquiry-confirmation><h2 id="InquirySuccessTitle-{{ section.id }}">Inquiry sent successfully</h2><p>Thank you for contacting Dragon Diamond. Our team will review your requirements and contact you by email.</p><p>You do not need to submit the same inquiry again.</p><button type="button" class="dd-home-b2b__button" data-inquiry-close>Got it</button></dialog>
{% endif %}
        {% if form.errors %}<div role="alert">{{ form.errors | default_errors }}</div>{% endif %}
        <label for="HomeName-{{ section.id }}">{{ 'dd_product.common.name' | t }}</label><input id="HomeName-{{ section.id }}" name="contact[name]" autocomplete="name" value="{{ form.name | escape }}" required>
        <label for="HomeEmail-{{ section.id }}">{{ 'dd_product.common.email' | t }}</label><input id="HomeEmail-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" value="{{ form.email | escape }}" required>
        <label for="HomeCompany-{{ section.id }}">{{ 'dd_home.company' | t }}</label><input id="HomeCompany-{{ section.id }}" name="contact[Company]" autocomplete="organization" value="{{ form.Company | escape }}">
        <label for="HomeWhatsApp-{{ section.id }}">{{ 'dd_home.whatsapp' | t }}</label><input id="HomeWhatsApp-{{ section.id }}" type="tel" name="contact[WhatsApp]" autocomplete="tel" value="{{ form.WhatsApp | escape }}">
        <label for="HomeProduct-{{ section.id }}">{{ 'dd_home.product_interested' | t }}</label><select id="HomeProduct-{{ section.id }}" name="contact[Product Interested]"><option value="">{{ 'dd_home.choose_product' | t }}</option><option value="LZ-1390 CO2 Laser Cutting Machine">LZ-1390 CO2 Laser Cutting Machine</option><option value="LZ-1325 CNC Router">LZ-1325 CNC Router</option>{% for i in (3..6) %}{% assign key = 'dd_home.category_' | append: i %}<option value="{{ key | t | escape }}">{{ key | t }}</option>{% endfor %}<option value="Equipment combination">{{ 'dd_home.equipment_combination' | t }}</option></select>
        <label for="HomeBody-{{ section.id }}">{{ 'dd_home.message' | t }}</label><textarea id="HomeBody-{{ section.id }}" name="contact[body]" rows="5" placeholder="{{ 'dd_home.requirements_hint' | t | escape }}" required>{{ form.body | escape }}</textarea>
        <button class="dd-home-b2b__button" type="submit">{{ 'dd_product.common.submit' | t }}</button>
      {% endform %}
    </div>
  </section>
</div>
