<div class="dd-welding-category"><div class="dd-welding-category__wrap"><nav aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a> / <span>{{ collection.title | escape }}</span></nav><h1>{{ collection.title | escape }}</h1><div class="rte">{{ collection.description }}</div>{% paginate collection.products by 12 %}<div class="dd-welding-category__grid">{% for product in collection.products %}<article><a href="{{ product.url }}">{% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'eager', widths: '400, 600, 900', sizes: '(min-width: 900px) 33vw, 100vw', alt: product.featured_image.alt }}{% endif %}<h2>{{ product.title | escape }}</h2></a><p>{{ product.description | split: '</p>' | first | strip_html }}</p><a class="dd-welding-category__button" href="{{ product.url }}">View Product &amp; Get a Quote</a></article>{% endfor %}</div>{{ paginate | default_pagination }}{% endpaginate %}<aside><h2>Plan Your Welding Setup</h2><p>Send your material, artwork, joint design and material thickness and production requirements. We provide free sample testing and help select the appropriate configuration.</p><a class="dd-welding-category__button" href="https://wa.me/8618988946615">Discuss Your Application</a><p><a href="mailto:info@gzcnc-laser.com">info@gzcnc-laser.com</a></p></aside></div></div>
<script type="application/ld+json">{"@context":"https://schema.org","@type":"CollectionPage","name":{{ collection.title | json }},"url":{{ canonical_url | json }},"description":{{ collection.description | strip_html | json }}}</script>
<script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":{{ request.origin | json }}},{"@type":"ListItem","position":2,"name":"Laser Welding Machines","item":{{ request.origin | append: '/collections/laser-welding' | json }}}{% if collection.handle != 'laser-welding' %},{"@type":"ListItem","position":3,"name":{{ collection.title | json }},"item":{{ canonical_url | json }}}{% endif %}]}</script>
{% stylesheet %}
.dd-welding-category{padding:145px 0 70px;background:#eff4f3;color:#183234;line-height:1.65;font-family:Arial,sans-serif}.dd-welding-category__wrap{max-width:1240px;margin:auto;padding:0 28px}.dd-welding-category h1{font-size:clamp(34px,4vw,52px);line-height:1.15;margin:28px 0}.dd-welding-category a{color:inherit}.dd-welding-category__types{display:flex;flex-wrap:wrap;gap:12px;margin:32px 0}.dd-welding-category__types a{padding:10px 16px;border:1px solid #829e9f;border-radius:4px}.dd-welding-category__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}.dd-welding-category article{padding:24px;background:white;border-radius:8px;display:flex;flex-direction:column}.dd-welding-category article>a{text-decoration:none}.dd-welding-category article img{width:100%;height:320px;object-fit:contain}.dd-welding-category h2{font-size:23px;line-height:1.3}.dd-welding-category article p{flex:1}.dd-welding-category .dd-welding-category__button{display:inline-block;padding:14px 20px;background:#0b666b;color:white;border-radius:4px;text-decoration:none;font-weight:700}.dd-welding-category aside{margin-top:50px;padding:32px;background:#dfeae8}.dd-welding-category :focus-visible{outline:3px solid #007e83;outline-offset:4px}@media(max-width:749px){.dd-welding-category{padding-top:110px}.dd-welding-category__wrap{padding:0 20px}.dd-welding-category__grid{grid-template-columns:1fr}.dd-welding-category article img{height:300px}.dd-welding-category aside{padding:24px}.dd-welding-category__button{box-sizing:border-box;width:100%;text-align:center}}
{% endstylesheet %}
{% schema %}{"name":"B2B welding collection","settings":[],"presets":[{"name":"B2B welding collection"}]}{% endschema %}
