;border-radius:6px}.dd-weldselect dialog{max-width:520px;width:calc(100% - 32px);padding:30px;border:0;border-radius:10px;color:#163237}.dd-weldselect dialog::backdrop{background:#082429b3}.dd-weldselect__two img{object-fit:contain;background:#edf3f2}.dd-weldselect a{overflow-wrap:anywhere}@media(max-width:899px){.dd-weldselect__wrap{padding:0 22px}.dd-weldselect__split{grid-template-columns:1fr;gap:32px}.dd-weldselect__grid{grid-template-columns:1fr}.dd-weldselect__section{padding:48px 0}.dd-weldselect__hero{padding-top:105px}.dd-weldselect__crumb{margin-bottom:28px}.dd-weldselect__hero img{aspect-ratio:16/10}.dd-weldselect__machine img{max-height:310px}.dd-weldselect__two{grid-template-columns:1fr}.dd-weldselect__body{padding:22px}.dd-weldselect__actions{align-items:flex-start;flex-direction:column}.dd-weldselect__fields{grid-template-columns:1fr}}
.dd-weldselect__compare{overflow-x:auto}.dd-weldselect table{width:100%;border-collapse:collapse;font-size:16px}.dd-weldselect th,.dd-weldselect td{text-align:left;vertical-align:top;border:1px solid #c3d4d4;padding:16px}.dd-weldselect th{background:#edf4f3}.dd-weldselect .cnc-machines{grid-template-columns:repeat(2,minmax(0,1fr))}.dd-weldselect .cnc-machines img{height:330px;object-fit:contain;padding:18px;background:#edf3f3}.dd-weldselect .dd-weldselect__hero img{aspect-ratio:4/3;object-fit:contain}.dd-weldselect .co2-model{font-size:28px;margin-bottom:12px}.dd-weldselect .co2-need{font-weight:700;color:#087f82}.dd-weldselect .co2-specs{font-size:15px}.dd-weldselect .co2-additional{grid-template-columns:repeat(3,minmax(0,1fr))}@media(max-width:700px){.dd-weldselect .cnc-machines,.dd-weldselect .co2-additional{grid-template-columns:1fr}.dd-weldselect table{min-width:610px}.dd-weldselect .cnc-machines img{height:290px}}.cnc-config{margin:22px 0}.cnc-config>div{display:grid;grid-template-columns:1fr 1.5fr;gap:14px;padding:12px 0;border-bottom:1px solid #c3d4d4}.cnc-config dt{font-weight:700}.cnc-config dd{margin:0}.dd-weldselect__panel>a{display:inline-block;margin-top:18px}.dd-weldselect #WeldselectMachine img{object-fit:contain;max-height:450px}.dd-weldselect__two .dd-weldselect__card img{height:310px;object-fit:cover;object-position:center 42%}.dd-weldselect .dd-weldselect__hero img{object-fit:contain}@media(max-width:700px){.cnc-config>div{grid-template-columns:1fr;gap:5px}.dd-weldselect__two .dd-weldselect__card img{height:260px}}.fiber-sample-window{position:relative;overflow:hidden;aspect-ratio:4/3;border-radius:8px}.dd-weldselect .fiber-original-samples{display:block;width:100%;height:100%;object-fit:contain}.dd-weldselect .dd-weldselect__hero img{object-fit:contain}.dd-weldselect .weld-sample{display:block;width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:8px}{% endstylesheet %}
{% javascript %}
function initWeldselectFeedback(){document.querySelectorAll('[data-weldselect-dialog]').forEach(dialog=>{if(dialog.dataset.ready)return;dialog.dataset.ready='true';const status=dialog.closest('form').querySelector('[data-weldselect-success]');dialog.querySelector('[data-weldselect-close]').addEventListener('click',()=>dialog.close());dialog.addEventListener('close',()=>status.focus());if(typeof dialog.showModal==='function')dialog.showModal();else status.focus();});}
initWeldselectFeedback();document.addEventListener('shopify:section:load',initWeldselectFeedback);
{% endjavascript %}
