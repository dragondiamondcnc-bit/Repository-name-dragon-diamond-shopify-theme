<section class="dd-solution-evidence" aria-labelledby="DDSolutionEvidence-{{ section.id }}"><div class="dd-solution-evidence__frame"><header><p>{{ section.settings.eyebrow }}</p><h2 id="DDSolutionEvidence-{{ section.id }}">{{ section.settings.heading }}</h2></header><div class="dd-solution-evidence__register">{% for block in section.blocks %}{% if forloop.first %}{% assign evidence_asset = 'dd-section04-uganda-sign-factory.jpg' %}{% else %}{% assign evidence_asset = 'dd-section04-ethiopia-advertising-production.jpg' %}{% endif %}<article {{ block.shopify_attributes }}><div class="dd-solution-evidence__media">{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '480, 720, 900', sizes: '(min-width: 761px) 25vw, 100vw', alt: block.settings.image_alt }}{% else %}<img src="{{ evidence_asset | asset_url }}" alt="{{ block.settings.image_alt | escape }}" width="900" height="600" loading="lazy">{% endif %}</div><div class="dd-solution-evidence__index"><small>Deployment</small><strong>{{ forloop.index | prepend: '0' }}</strong></div><div><small>Location</small><h3>{{ block.settings.location }}</h3></div><div><small>Context</small><p>{{ block.settings.context }}</p></div><div><small>System</small><p>{{ block.settings.system }}</p></div><div><small>Status</small><strong class="dd-solution-evidence__status">{{ block.settings.status }}</strong></div>{% if block.settings.link_url != blank %}<a href="{{ block.settings.link_url }}" data-track="cta" data-cta-id="co2_solution_case_study" data-section="solution_evidence">{{ block.settings.link_label }} <span aria-hidden="true">→</span></a>{% endif %}</article>{% endfor %}</div></div></section>
{% stylesheet %}.dd-solution-evidence{background:#f1f2f2;color:#101317;font-family:'Archivo Narrow',sans-serif}.dd-solution-evidence__frame{width:min(100% - 64px,1240px);margin:auto;padding:112px 0}.dd-solution-evidence header{display:grid;grid-template-columns:1fr 2fr;gap:32px 64px;padding-bottom:52px;border-bottom:1px solid #aeb2b4}.dd-solution-evidence header p{margin:0;color:#007f88;font-size:11px;font-weight:700;letter-spacing:.22em;text-transform:uppercase}.dd-solution-evidence h2{margin:0;font-size:clamp(38px,4.5vw,62px);line-height:1;text-transform:uppercase}.dd-solution-evidence article{display:grid;grid-template-columns:1.65fr .48fr .8fr 1fr 1.15fr 1fr auto;min-height:190px;border-bottom:1px solid #bfc3c5}.dd-solution-evidence article>div:not(.dd-solution-evidence__media){padding:34px 18px;border-left:1px solid #d0d3d4}.dd-solution-evidence__media{min-height:190px;overflow:hidden;background:#15191e}.dd-solution-evidence__media img{width:100%;height:100%;object-fit:cover}.dd-solution-evidence small{display:block;margin-bottom:11px;color:#697075;font-size:9px;font-weight:700;letter-spacing:.15em;text-transform:uppercase}.dd-solution-evidence__index strong{color:#00a3ad;font-size:26px}.dd-solution-evidence h3,.dd-solution-evidence article p{margin:0;font-size:15px;line-height:1.45;text-transform:uppercase}.dd-solution-evidence__status{color:#087f68;font-size:14px;text-transform:uppercase}.dd-solution-evidence article>a{display:flex;align-items:center;justify-content:flex-start;gap:12px;min-width:168px;padding:34px 22px;border-left:1px solid #bfc3c5;color:#101317;font-size:10px;font-weight:700;letter-spacing:.12em;text-decoration:none;text-transform:uppercase}.dd-solution-evidence article>a:hover,.dd-solution-evidence article>a:focus-visible{color:#007f88;text-decoration-line:underline;text-decoration-thickness:1px;text-underline-offset:5px}.dd-solution-evidence article>a:focus-visible{outline:2px solid #007f88;outline-offset:-5px}@media(max-width:1000px){.dd-solution-evidence article{grid-template-columns:1.35fr .5fr 1fr 1fr}.dd-solution-evidence__media{grid-row:1/3}.dd-solution-evidence article>a{grid-column:4}}@media(max-width:760px){.dd-solution-evidence__frame{width:min(100% - 40px,1240px);padding:80px 0}.dd-solution-evidence header{grid-template-columns:1fr}.dd-solution-evidence article{grid-template-columns:50px 1fr;padding:28px 0}.dd-solution-evidence__media{grid-column:1/-1;grid-row:auto;aspect-ratio:16/10;margin-bottom:20px}.dd-solution-evidence article>div:not(.dd-solution-evidence__media){grid-column:2;padding:10px 0 10px 18px}.dd-solution-evidence__index{grid-column:1!important;grid-row:2/7}.dd-solution-evidence article>a{grid-column:2;justify-content:flex-start;min-height:48px;padding:12px 0 12px 18px;border-left:0}}{% endstylesheet %}
{% schema %}{"name":"DD Solution Evidence","max_blocks":2,"settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"VERIFIED EVIDENCE / 06"},{"type":"text","id":"heading","label":"Heading","default":"Verified Production Deployments"}],"blocks":[{"type":"deployment","name":"Deployment","settings":[{"type":"text","id":"location","label":"Location"},{"type":"text","id":"context","label":"Context"},{"type":"text","id":"system","label":"System"},{"type":"text","id":"status","label":"Status"},{"type":"image_picker","id":"image","label":"Deployment image"},{"type":"text","id":"image_alt","label":"Image alt text"},{"type":"text","id":"link_label","label":"Link label","default":"VIEW CASE STUDY"},{"type":"url","id":"link_url","label":"Case study link"}]}],"presets":[{"name":"DD Solution Evidence"}]}{% endschema %}
