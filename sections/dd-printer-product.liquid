{% liquid
  assign inquiry_id = 'PrinterInquiry-' | append: section.id
  assign intro = product.description | split: '</p>' | first | strip_html
%}
<div class="dd-printer">
  <div class="dd-printer__hero">
    <div class="dd-printer__wrap">
      <nav class="dd-printer__crumbs" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a> / <a href="{{ routes.collections_url }}/uv-flatbed-printers">UV Flatbed Printers</a></nav>
      <div class="dd-printer__split">
        <div><p class="dd-printer__eyebrow">DRAGON DIAMOND · UV FLATBED PRINTING</p><h1>{{ product.title | escape }}</h1><p class="dd-printer__lead">{{ intro }}</p><p>Equipment selection · Free sample testing · Technical support</p><div class="dd-printer__actions"><a class="dd-printer__button" href="#{{ inquiry_id }}">Get a Quote</a><a href="#printing-results">View Printing Samples</a></div></div>
        {% if product.featured_image != blank %}<figure>{{ product.featured_image | image_url: width: 1400 | image_tag: widths: '480, 750, 1000, 1400', sizes: '(min-width: 900px) 48vw, 100vw', loading: 'eager', fetchpriority: 'high', alt: product.featured_image.alt }}<figcaption>Machine shown for reference. Final configuration is specified in your quotation.</figcaption></figure>{% endif %}
      </div>
    </div>
  </div>
  <div class="dd-printer__wrap">
    <nav class="dd-printer__nav" aria-label="Product information"><a href="#printing-results">Samples</a><a href="#printing-configuration">Configuration</a><a href="#printing-specifications">Specifications</a><a href="#printing-delivery">Delivery &amp; Support</a><a href="#printing-faq">FAQ</a></nav>
    <section id="printing-results" class="dd-printer__samples">
      <div class="dd-printer__sample-heading"><div><p class="dd-printer__sample-eyebrow">MATERIALS &amp; POSSIBILITIES</p><h2>UV Printing Applications &amp; Samples</h2><p>Explore printing applications on wood, leather, stainless steel, phone cases, acrylic and ballpoint pens.</p></div><a class="dd-printer__button" href="#{{ inquiry_id }}">Request a Free Sample Test</a></div>
<div class="dd-uv-sample-grid"><figure><a href="{{ 'uv-print-sample-wood.png' | asset_url }}" target="_blank" rel="noopener" aria-label="View Wood printing sample"><img src="{{ 'uv-print-sample-wood.png' | asset_img_url: '700x' }}" width="1254" height="1254" loading="lazy" alt="Colorful animal artwork printed on a wood panel"></a><figcaption><h3>Wood</h3><p>Print colorful artwork on wooden signs, decorative panels and personalized gifts. Confirm the surface finish and preparation with your actual wood sample.</p></figcaption></figure><figure><a href="{{ 'uv-print-sample-leather.png' | asset_url }}" target="_blank" rel="noopener" aria-label="View Leather printing sample"><img src="{{ 'uv-print-sample-leather.png' | asset_img_url: '700x' }}" width="1254" height="1254" loading="lazy" alt="Mountain landscape artwork on a leather notebook cover"></a><figcaption><h3>Leather</h3><p>Add custom artwork to notebook covers, accessories and leather gifts. Test ink adhesion and flexibility on the selected leather before production.</p></figcaption></figure><figure><a href="{{ 'uv-print-sample-stainless-steel.png' | asset_url }}" target="_blank" rel="noopener" aria-label="View Stainless Steel printing sample"><img src="{{ 'uv-print-sample-stainless-steel.png' | asset_img_url: '700x' }}" width="1254" height="1254" loading="lazy" alt="Colorful landscape designs on stainless steel drinkware"></a><figcaption><h3>Stainless Steel</h3><p>Create personalized designs on stainless steel drinkware and gifts. Curved items require confirmation of compatible accessories and the printing method.</p></figcaption></figure><figure><a href="{{ 'uv-print-sample-phone-case.png' | asset_url }}" target="_blank" rel="noopener" aria-label="View Phone Cases printing sample"><img src="{{ 'uv-print-sample-phone-case.png' | asset_img_url: '700x' }}" width="1254" height="1254" loading="lazy" alt="Coastal landscape artwork on a phone case"></a><figcaption><h3>Phone Cases</h3><p>Print photos, patterns and branding on phone cases for personalized gifts and merchandise. Confirm the case material, shape and positioning fixture.</p></figcaption></figure><figure><a href="{{ 'uv-print-sample-acrylic.png' | asset_url }}" target="_blank" rel="noopener" aria-label="View Acrylic printing sample"><img src="{{ 'uv-print-sample-acrylic.png' | asset_img_url: '700x' }}" width="1254" height="1254" loading="lazy" alt="Colorful racing car artwork on an acrylic display panel"></a><figcaption><h3>Acrylic</h3><p>Print colorful artwork on acrylic signs, display panels and keepsakes. Confirm the viewing side, ink layers and required finish through sample testing.</p></figcaption></figure><figure><a href="{{ 'uv-print-sample-ballpoint-pens.png' | asset_url }}" target="_blank" rel="noopener" aria-label="View ballpoint pen printing sample"><img src="{{ 'uv-print-sample-ballpoint-pens.png' | asset_img_url: '700x' }}" width="1448" height="1086" loading="lazy" alt="Colorful ballpoint pens with printed logos and promotional designs"></a><figcaption><h3>Ballpoint Pens</h3><p>Add logos and promotional designs to ballpoint pens. Confirm pen dimensions, positioning fixtures and the printable area with a sample test.</p></figcaption></figure></div><p class="dd-uv-sample-note">Application examples. Confirm ink adhesion, surface preparation and the required finish with a sample test on your actual material. Images do not define the standard machine configuration.</p>
    </section>
    <div class="dd-printer__content">{{ product.description }}</div>
    <section id="printing-delivery"><h2>Packaging, Delivery &amp; Technical Support</h2><div class="dd-printer__support"><article><h3>Confirm before shipping</h3><p>We agree the printheads, ink channels, electrical requirements, accessories, packing and shipping method in your quotation. Delivery time is negotiated for each order.</p></article><article><h3>Installation &amp; training</h3><p>English manuals and videos support setup and operation. Our technical team provides remote training and assistance with day-to-day use. On-site training and technical support can be arranged by agreement.</p></article><article><h3>Spare parts &amp; equipment planning</h3><p>We prepare corresponding spare parts for each machine and help plan compatible equipment for your production workflow.</p></article></div></section>
    <section id="printing-faq"><h2>Frequently Asked Questions</h2><details><summary>What can the LZ-6090UV print on?</summary><p>It supports flatbed printing applications on suitable acrylic, glass, wood, plastic and metal surfaces. Ink adhesion and any primer or surface preparation requirements should be checked with your actual material through a sample test.</p></details><details><summary>Which printhead should I choose?</summary><p>XP600, I1600 and I3200 options are available. Share your artwork, output target and required finish so we can recommend the printhead count and ink-channel configuration.</p></details><details><summary>Can it print color and white ink on clear panels?</summary><p>A suitable white-ink configuration supports layered printing on transparent panels. The demonstration shows reverse printing with color first and white second. Confirm the substrate, viewing side and layer order during sample testing.</p></details><details><summary>Can you test my artwork before I order?</summary><p>Yes. Request a free sample test using your artwork and material requirements. Sample shipping arrangements are agreed separately.</p></details><details><summary>What is the price and delivery time?</summary><p>We quote according to the selected printheads, ink configuration, accessories and shipping requirements. Delivery time is negotiated for each order.</p></details></section>
    <section><h2>Related Equipment</h2><div class="dd-printer__related">{% assign related_handles = 'lz-1390-industrial-co2-laser-cutting-machine,lz-1325-cnc-router' | split: ',' %}{% for related_handle in related_handles %}{% assign related = all_products[related_handle] %}{% unless related.id == product.id %}<a href="{{ related.url }}">{% if related.featured_image != blank %}{{ related.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: related.featured_image.alt }}{% endif %}<h3>{{ related.title | escape }}</h3><span>View Product →</span></a>{% endunless %}{% endfor %}</div><p><a href="{{ routes.collections_url }}/uv-flatbed-printers">Explore UV flatbed printers</a></p></section>
    <section id="{{ inquiry_id }}" class="dd-printer__inquiry"><h2>Get a Quote for Your Printing Application</h2><p>Tell us your substrate, print size, artwork, required finish and production volume.</p>{% form 'contact', id: inquiry_id %}{% if form.posted_successfully? %}<p role="status">Thank you. Your inquiry has been sent.</p>{% endif %}{{ form.errors | default_errors }}<input type="hidden" name="contact[Product URL]" value="{{ canonical_url | escape }}"><div class="dd-printer__fields"><label for="Name-{{ section.id }}">Name *<input id="Name-{{ section.id }}" name="contact[name]" autocomplete="name" value="{{ form.name | escape }}" required></label><label for="Email-{{ section.id }}">Email *<input id="Email-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" value="{{ form.email | escape }}" required></label><label for="Company-{{ section.id }}">Company<input id="Company-{{ section.id }}" name="contact[Company]" autocomplete="organization"></label><label for="Whatsapp-{{ section.id }}">WhatsApp<input id="Whatsapp-{{ section.id }}" name="contact[WhatsApp]" type="tel" autocomplete="tel"></label><label for="Product-{{ section.id }}">Product Interested<input id="Product-{{ section.id }}" name="contact[Product Interested]" value="{{ product.title | escape }}"></label><label class="dd-printer__message" for="Message-{{ section.id }}">Message *<textarea id="Message-{{ section.id }}" name="contact[body]" rows="5" required>{{ form.body | escape }}</textarea></label></div><button class="dd-printer__button" type="submit">Send Inquiry</button>{% endform %}<p><a href="mailto:info@gzcnc-laser.com">info@gzcnc-laser.com</a> · <a href="https://wa.me/8618988946615">WhatsApp: +86 189 8894 6615</a></p></section>
  </div>
</div>
<script type="application/ld+json">{"@context":"https://schema.org","@type":"Product","@id":{{ canonical_url | append: '#product' | json }},"url":{{ canonical_url | json }},"name":{{ product.title | json }},"description":{{ intro | json }},"brand":{"@type":"Brand","name":"Dragon Diamond"}{% if product.featured_image != blank %},"image":{{ product.featured_image | image_url: width: 1400 | prepend: 'https:' | json }}{% endif %}}</script>
<script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":{{ request.origin | json }}},{"@type":"ListItem","position":2,"name":"UV Flatbed Printers","item":{{ request.origin | append: '/collections/uv-flatbed-printers' | json }}},{"@type":"ListItem","position":3,"name":{{ product.title | json }},"item":{{ canonical_url | json }}}]}</script>
{% stylesheet %}
  .dd-printer{background:#f6f8f8;color:#182d30;font-family:Arial,sans-serif;line-height:1.65}.dd-printer *{box-sizing:border-box}.dd-printer__wrap{max-width:1240px;margin:auto;padding:0 32px}.dd-printer__hero{padding:140px 0 56px;background:#123439;color:#fff}.dd-printer__crumbs{font-size:13px;margin-bottom:38px}.dd-printer a{color:inherit;text-underline-offset:4px}.dd-printer__split{display:grid;grid-template-columns:1fr 1fr;gap:36px;align-items:center}.dd-printer h1{font-size:clamp(32px,4vw,54px);line-height:1.12;color:inherit;letter-spacing:-1px;margin:18px 0 24px}.dd-printer h2{font-size:30px;line-height:1.2;margin:0 0 24px}.dd-printer h3{font-size:20px;line-height:1.35}.dd-printer__eyebrow{font-size:12px;font-weight:bold;letter-spacing:2px;color:#6edbd1}.dd-printer__lead{font-size:19px}.dd-printer figure{margin:0}.dd-printer__hero img{width:100%;height:520px;object-fit:contain;background:transparent}.dd-printer figcaption{font-size:12px;opacity:.8;margin-top:12px}.dd-printer__actions{display:flex;flex-wrap:wrap;gap:24px;align-items:center;margin-top:28px}.dd-printer .dd-printer__button{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:13px 24px;background:#6ddbd0;color:#102c30;font:700 16px Arial,sans-serif;text-decoration:none;border:0;border-radius:4px;cursor:pointer}.dd-printer__nav{display:flex;flex-wrap:wrap;gap:22px;padding:24px 0;border-bottom:1px solid #d3dfdf}.dd-printer section,.dd-printer__content{padding:48px 0;border-bottom:1px solid #d3dfdf;scroll-margin-top:110px}.dd-printer__content>p:first-child{display:none}.dd-printer__content h2:not(:first-child){margin-top:42px}.dd-printer__content li{margin:8px 0}.dd-printer__samples{display:block}.dd-printer__sample-heading{display:flex;justify-content:space-between;align-items:center;gap:28px;margin-bottom:22px}.dd-printer__sample-heading>div{max-width:740px}.dd-printer__sample-heading h2{margin:6px 0 10px}.dd-printer__sample-heading p{margin:0}.dd-printer__sample-heading .dd-printer__button{flex-shrink:0}.dd-printer__sample-eyebrow{font-size:11px;letter-spacing:1.8px;font-weight:700;color:#157077}.dd-printer__application-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.dd-printer__application-card{position:relative;display:block;min-width:0;aspect-ratio:16/10;border-radius:8px;overflow:hidden;background:#263e40;text-decoration:none;color:white}.dd-printer__application-card img{display:block;width:100%;height:100%;object-fit:cover}.dd-printer__application-caption{position:absolute;inset:auto 0 0;padding:50px 24px 20px;background:linear-gradient(transparent,rgba(6,19,21,.88));color:white}.dd-printer__application-caption h3{font-size:25px;color:white;margin:0 0 4px}.dd-printer__application-caption p{font-size:14px;margin:0;color:#edf5f3}.dd-printer__application-expand{position:absolute;right:14px;top:14px;display:grid;place-items:center;width:34px;height:34px;border-radius:50%;background:rgba(9,30,32,.65);color:white;font-size:22px}.dd-printer__sample-footer{display:flex;justify-content:space-between;gap:16px;margin-top:12px;font-size:12px;color:#526c6e}.dd-printer__sample-footer p{margin:0}.dd-printer__sample-footer a{display:inline-block;padding:2px 0;margin-left:12px;text-underline-offset:3px}.dd-printer__sample-footer>div{flex-shrink:0}.dd-printer__swipe{display:none}.dd-printer__gallery img{max-height:300px;width:100%;object-fit:contain}.dd-printer__support,.dd-printer__related{display:grid;grid-template-columns:repeat(3,1fr);gap:28px}.dd-printer__related{grid-template-columns:repeat(2,1fr)}.dd-printer__related>a{padding:24px;background:#e9efee;text-decoration:none}.dd-printer__related img{width:100%;height:230px;object-fit:contain}.dd-printer details{border-bottom:1px solid #d3dfdf;padding:18px 0}.dd-printer summary{font-weight:700;cursor:pointer}.dd-printer table{width:100%;border-collapse:collapse;margin:20px 0;font-size:15px}.dd-printer th,.dd-printer td{padding:12px;border:1px solid #cad8d8;text-align:left;overflow-wrap:anywhere}.dd-printer th{width:40%;background:#e9efee}.dd-printer__fields{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin:25px 0}.dd-printer label{font-weight:700;display:block}.dd-printer input,.dd-printer textarea{display:block;width:100%;padding:13px;border:1px solid #a7baba;border-radius:3px;background:white;color:#182d30;font:16px Arial,sans-serif;margin-top:6px}.dd-printer__message{grid-column:1/-1}.dd-printer__inquiry a{overflow-wrap:anywhere}.dd-printer :focus-visible{outline:3px solid #009c9c;outline-offset:4px}@media(max-width:749px){.dd-printer__sample-heading{display:block;margin-bottom:18px}.dd-printer__sample-heading h2{font-size:26px}.dd-printer__sample-heading .dd-printer__button{margin-top:16px}.dd-printer__application-grid{display:flex;gap:12px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:thin;padding-bottom:8px}.dd-printer__application-card{flex:0 0 90%;aspect-ratio:4/3;scroll-snap-align:start}.dd-printer__application-caption{padding:40px 16px 16px}.dd-printer__application-caption h3{font-size:22px}.dd-printer__application-caption p{font-size:13px}.dd-printer__sample-footer{display:block;margin-top:8px}.dd-printer__sample-footer a{padding:10px 0}.dd-printer__swipe{display:block;margin:6px 0;font-size:12px;color:#526c6e}.dd-printer__wrap{padding:0 20px}.dd-printer__hero{padding:110px 0 36px}.dd-printer__split,.dd-printer__support,.dd-printer__related,.dd-printer__fields{grid-template-columns:1fr}.dd-printer__hero img{height:350px}.dd-printer h1{font-size:36px}.dd-printer h2{font-size:27px}.dd-printer section,.dd-printer__content{padding:34px 0}.dd-printer__nav{gap:12px 20px;font-size:14px}.dd-printer__button{width:100%}.dd-printer__crumbs{overflow-wrap:anywhere}}

.dd-uv-sample-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;margin:24px 0}.dd-uv-sample-grid figure{margin:0;min-width:0}.dd-uv-sample-grid img{display:block;width:100%;height:auto;aspect-ratio:1;object-fit:cover;object-position:center;border-radius:8px}.dd-uv-sample-grid h3{font-size:19px;margin:12px 0 6px}.dd-uv-sample-grid p,.dd-uv-sample-note{font-size:14px;line-height:1.6}.dd-uv-sample-grid a:focus-visible{outline:3px solid #00858a;outline-offset:3px}.dd-uv-category-samples{margin-top:48px}@media(max-width:749px){.dd-uv-sample-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:18px 12px}.dd-uv-sample-grid h3{font-size:17px}}{% endstylesheet %}
{% schema %}
{
  "name": "B2B UV printer",
  "settings": [
    {
      "type": "textarea",
      "id": "sample_description",
      "label": "Application introduction",
      "default": "Explore UV printing applications and request a sample test with your own material."
    },
    {
      "type": "textarea",
      "id": "sample_intro",
      "label": "Short application introduction"
    },
    {
      "type": "image_picker",
      "id": "application_image_1",
      "label": "Application illustration 1"
    },
    {
      "type": "text",
      "id": "application_title_1",
      "label": "Application 1 title"
    },
    {
      "type": "text",
      "id": "application_subtitle_1",
      "label": "Application 1 subtitle"
    },
    {
      "type": "image_picker",
      "id": "application_image_2",
      "label": "Application illustration 2"
    },
    {
      "type": "text",
      "id": "application_title_2",
      "label": "Application 2 title"
    },
    {
      "type": "text",
      "id": "application_subtitle_2",
      "label": "Application 2 subtitle"
    }
  ],
  "presets": [
    {
      "name": "B2B UV printer"
    }
  ]
}
{% endschema %}
