set_img_url: '900x' }}" srcset="{{ 'factory-customer-sample-review.jpg' | asset_img_url: '500x' }} 500w, {{ 'factory-customer-sample-review.jpg' | asset_img_url: '900x' }} 900w, {{ 'factory-customer-sample-review.jpg' | asset_img_url: '1400x' }} 1400w" sizes="(min-width: 900px) 33vw, (min-width: 600px) 50vw, 100vw" width="1206" height="904" loading="lazy"  alt="A customer holding a routed sample beside a CNC router"></a><figcaption>A customer holding a routed sample beside a CNC router</figcaption></figure><figure class="factory-photo"><a href="{{ 'factory-customer-discussion.jpg' | asset_url }}" target="_blank" rel="noopener" aria-label="Customers and team members discussing equipment at the meeting table — open full photograph"><img src="{{ 'factory-customer-discussion.jpg' | asset_img_url: '900x' }}" srcset="{{ 'factory-customer-discussion.jpg' | asset_img_url: '500x' }} 500w, {{ 'factory-customer-discussion.jpg' | asset_img_url: '900x' }} 900w, {{ 'factory-customer-discussion.jpg' | asset_img_url: '1400x' }} 1400w" sizes="(min-width: 900px) 33vw, (min-width: 600px) 50vw, 100vw" width="4096" height="3348" loading="lazy"  alt="Customers and team members discussing equipment at the meeting table"></a><figcaption>Customers and team members discussing equipment at the meeting table</figcaption></figure><figure class="factory-photo"><a href="{{ 'factory-customer-visit-group.jpg' | asset_url }}" target="_blank" rel="noopener" aria-label="Customers and Dragon Diamond team members during a factory visit — open full photograph"><img src="{{ 'factory-customer-visit-group.jpg' | asset_img_url: '900x' }}" srcset="{{ 'factory-customer-visit-group.jpg' | asset_img_url: '500x' }} 500w, {{ 'factory-customer-visit-group.jpg' | asset_img_url: '900x' }} 900w, {{ 'factory-customer-visit-group.jpg' | asset_img_url: '1400x' }} 1400w" sizes="(min-width: 900px) 33vw, (min-width: 600px) 50vw, 100vw" width="4032" height="3024" loading="lazy"  alt="Customers and Dragon Diamond team members during a factory visit"></a><figcaption>Customers and Dragon Diamond team members during a factory visit</figcaption></figure></div><p class="dd-factory__note">Photographs below and above record different visits and stages of our company history. Workshop layouts and equipment configurations vary between projects.</p><div class="factory-links"><a href="{{ routes.root_url }}pages/case-studies">Explore Customer Case Studies →</a><a href="#FactoryContact">Plan Your Visit →</a></div></div></section><section class="dd-factory__section dd-factory__tint" id="FactoryExhibitions"><div class="dd-factory__wrap"><div class="factory-section-heading"><h2>Equipment conversations beyond the workshop</h2><p>A selection of past exhibition photographs: our team meeting visitors, discussing applications and presenting equipment.</p></div><div class="factory-gallery "><figure class="factory-photo"><a href="{{ 'factory-exhibition-customer-meeting.jpg' | asset_url }}" target="_blank" rel="noopener" aria-label="Dragon Diamond representatives meeting visitors at an exhibition booth — open full photograph"><img src="{{ 'factory-exhibition-customer-meeting.jpg' | asset_img_url: '900x' }}" srcset="{{ 'factory-exhibition-customer-meeting.jpg' | asset_img_url: '500x' }} 500w, {{ 'factory-exhibition-customer-meeting.jpg' | asset_img_url: '900x' }} 900w, {{ 'factory-exhibition-customer-meeting.jpg' | asset_img_url: '1400x' }} 1400w" sizes="(min-width: 900px) 33vw, (min-width: 600px) 50vw, 100vw" width="4032" height="3024" loading="lazy"  alt="Dragon Diamond representatives meeting visitors at an exhibition booth"></a><figcaption>Dragon Diamond representatives meeting visitors at an exhibition booth</figcaption></figure><figure class="factory-photo"><a href="{{ 'factory-exhibition-equipment-review.jpg' | asset_url }}" target="_blank" rel="noopener" aria-label="Visitors reviewing equipment at an exhibition booth — open full photograph"><img src="{{ 'factory-exhibition-equipment-review.jpg' | asset_img_url: '900x' }}" srcset="{{ 'factory-exhibition-equipment-review.jpg' | asset_img_url: '500x' }} 500w, {{ 'factory-exhibition-equipment-review.jpg' | asset_img_url: '900x' }} 900w, {{ 'factory-exhibition-equipment-review.jpg' | asset_img_url: '1400x' }} 1400w" sizes="(min-width: 900px) 33vw, (min-width: 600px) 50vw, 100vw" width="3024" height="4032" loading="lazy"  alt="Visitors reviewing equipment at an exhibition booth"></a><figcaption>Visitors reviewing equipment at an exhibition booth</figcaption></figure><figure class="factory-photo"><a href="{{ 'factory-exhibition-team.jpg' | asset_url }}" target="_blank" rel="noopener" aria-label="Dragon Diamond team at an exhibition booth with equipment on display — open full photograph"><img src="{{ 'factory-exhibition-team.jpg' | asset_img_url: '900x' }}" srcset="{{ 'factory-exhibition-team.jpg' | asset_img_url: '500x' }} 500w, {{ 'factory-exhibition-team.jpg' | asset_img_url: '900x' }} 900w, {{ 'factory-exhibition-team.jpg' | asset_img_url: '1400x' }} 1400w" sizes="(min-width: 900px) 33vw, (min-width: 600px) 50vw, 100vw" width="4032" height="3024" loading="lazy"  alt="Dragon Diamond team at an exhibition booth with equipment on display"></a><figcaption>Dragon Diamond team at an exhibition booth with equipment on display</figcaption></figure></div></div></section><section class="dd-factory__section " id="FactoryDelivery"><div class="dd-factory__wrap"><div class="factory-section-heading"><h2>Packing preparation and container loading</h2><p>See wrapped equipment, wooden packing bases and a container loading record. Packing and handling arrangements depend on machine dimensions, destination and the agreed shipping plan.</p></div><div class="factory-gallery "><figure class="factory-photo"><a href="{{ 'factory-wrapped-equipment.jpg' | asset_url }}" target="_blank" rel="noopener" aria-label="Wrapped machines on pallets in the workshop — open full photograph"><img src="{{ 'factory-wrapped-equipment.jpg' | asset_img_url: '900x' }}" srcset="{{ 'factory-wrapped-equipment.jpg' | asset_img_url: '500x' }} 500w, {{ 'factory-wrapped-equipment.jpg' | asset_img_url: '900x' }} 900w, {{ 'factory-wrapped-equipment.jpg' | asset_img_url: '1400x' }} 1400w" sizes="(min-width: 900px) 33vw, (min-width: 600px) 50vw, 100vw" width="4032" height="3024" loading="lazy"  alt="Wrapped machines on pallets in the workshop"></a><figcaption>Wrapped machines on pallets in the workshop</figcaption></figure><figure class="factory-photo"><a href="{{ 'factory-packing-preparation.jpg' | asset_url }}" target="_blank" rel="noopener" aria-label="A group of machines positioned in wooden packing bases — open full photograph"><img src="{{ 'factory-packing-preparation.jpg' | asset_img_url: '900x' }}" srcset="{{ 'factory-packing-preparation.jpg' | asset_img_url: '500x' }} 500w, {{ 'factory-packing-preparation.jpg' | asset_img_url: '900x' }} 900w, {{ 'factory-packing-preparation.jpg' | asset_img_url: '1400x' }} 1400w" sizes="(min-width: 900px) 33vw, (min-width: 600px) 50vw, 100vw" width="4032" height="3024" loading="lazy"  alt="A group of machines positioned in wooden packing bases"></a><figcaption>A group of machines positioned in wooden packing bases</figcaption></figure><figure class="factory-photo"><a href="{{ 'factory-container-loading.jpg' | asset_url }}" target="_blank" rel="noopener" aria-label="Wrapped equipment being moved into a shipping container by forklift — open full photograph"><img src="{{ 'factory-container-loading.jpg' | asset_img_url: '900x' }}" srcset="{{ 'factory-container-loading.jpg' | asset_img_url: '500x' }} 500w, {{ 'factory-container-loading.jpg' | asset_img_url: '900x' }} 900w, {{ 'factory-container-loading.jpg' | asset_img_url: '1400x' }} 1400w" sizes="(min-width: 900px) 33vw, (min-width: 600px) 50vw, 100vw" width="4096" height="3072" loading="lazy"  alt="Wrapped equipment being moved into a shipping container by forklift"></a><figcaption>Wrapped equipment being moved into a shipping container by forklift</figcaption></figure></div><div class="factory-links"><a href="{{ routes.root_url }}pages/case-study-ethiopia">Customer-Observed Loading in the Ethiopia Case →</a><a href="{{ routes.root_url }}pages/case-study-georgia">Georgia Equipment &amp; Delivery Records →</a></div></div></section><section class="dd-factory__section dd-factory__tint" id="FactoryDocuments"><div class="dd-factory__wrap"><div class="factory-section-heading"><h2>Certificates &amp; conformity documents</h2><p>Check the documentation relevant to your equipment.</p></div><p>Review the supplied UDEM attestations for CNC routers, laser engraving and cutting machines, laser marking machines and laser welding machines. Document scope is specific to the listed products and models.</p><details class="factory-documents"><summary>View 6 conformity documents</summary><div class="factory-document-grid">{% assign certificate = section.settings.company_certificate_1 %}<article>{% if certificate != blank %}<a href="{{ certificate | image_url: width: 2000 }}" target="_blank" rel="noopener">{{ certificate | image_url: width: 600 | image_tag: loading: 'lazy', alt: 'UDEM conformity document 1' }}</a>{% endif %}<h3>{{ 'dd_home.certificate_1' | t }}</h3><p>{{ 'dd_home.certificate_1_scope' | t }}</p><p>{{ 'dd_home.certificate_1_number' | t }}</p><p>{{ 'dd_home.certificate_1_date' | t }}</p>{% if certificate != blank %}<a href="{{ certificate | image_url: width: 2000 }}" target="_blank" rel="noopener">View Full Document ↗</a>{% endif %}</article>{% assign certificate = section.settings.company_certificate_2 %}<article>{% if certificate != blank %}<a href="{{ certificate | image_url: width: 2000 }}" target="_blank" rel="noopener">{{ certificate | image_url: width: 600 | image_tag: loading: 'lazy', alt: 'UDEM conformity document 2' }}</a>{% endif %}<h3>{{ 'dd_home.certificate_2' | t }}</h3><p>{{ 'dd_home.certificate_2_scope' | t }}</p><p>{{ 'dd_home.certificate_2_number' | t }}</p><p>{{ 'dd_home.certificate_2_date' | t }}</p>{% if certificate != blank %}<a href="{{ certificate | image_url: width: 2000 }}" target="_blank" rel="noopener">View Full Document ↗</a>{% endif %}</article>{% assign certificate = section.settings.company_certificate_3 %}<article>{% if certificate != blank %}<a href="{{ certificate | image_url: width: 2000 }}" target="_blank" rel="noopener">{{ certificate | image_url: width: 600 | image_tag: loading: 'lazy', alt: 'UDEM conformity document 3' }}</a>{% endif %}<h3>{{ 'dd_home.certificate_3' | t }}</h3><p>{{ 'dd_home.certificate_3_scope' | t }}</p><p>{{ 'dd_home.certificate_3_number' | t }}</p><p>{{ 'dd_home.certificate_3_date' | t }}</p>{% if certificate != blank %}<a href="{{ certificate | image_url: width: 2000 }}" target="_blank" rel="noopener">View Full Document ↗</a>{% endif %}</article>{% assign certificate = section.settings.company_certificate_4 %}<article>{% if certificate != blank %}<a href="{{ certificate | image_url: width: 2000 }}" target="_blank" rel="noopener">{{ certificate | image_url: width: 600 | image_tag: loading: 'lazy', alt: 'UDEM conformity document 4' }}</a>{% endif %}<h3>{{ 'dd_home.certificate_4' | t }}</h3><p>{{ 'dd_home.certificate_4_scope' | t }}</p><p>{{ 'dd_home.certificate_4_number' | t }}</p><p>{{ 'dd_home.certificate_4_date' | t }}</p>{% if certificate != blank %}<a href="{{ certificate | image_url: width: 2000 }}" target="_blank" rel="noopener">View Full Document ↗</a>{% endif %}</article>{% assign certificate = section.settings.company_certificate_5 %}<article>{% if certificate != blank %}<a href="{{ certificate | image_url: width: 2000 }}" target="_blank" rel="noopener">{{ certificate | image_url: width: 600 | image_tag: loading: 'lazy', alt: 'UDEM conformity document 5' }}</a>{% endif %}<h3>{{ 'dd_home.certificate_5' | t }}</h3><p>{{ 'dd_home.certificate_5_scope' | t }}</p><p>{{ 'dd_home.certificate_5_number' | t }}</p><p>{{ 'dd_home.certificate_5_date' | t }}</p>{% if certificate != blank %}<a href="{{ certificate | image_url: width: 2000 }}" target="_blank" rel="noopener">View Full Document ↗</a>{% endif %}</article>{% assign certificate = section.settings.company_certificate_6 %}<article>{% if certificate != blank %}<a href="{{ certificate | image_url: width: 2000 }}" target="_blank" rel="noopener">{{ certificate | image_url: width: 600 | image_tag: loading: 'lazy', alt: 'UDEM conformity document 6' }}</a>{% endif %}<h3>{{ 'dd_home.certificate_6' | t }}</h3><p>{{ 'dd_home.certificate_6_scope' | t }}</p><p>{{ 'dd_home.certificate_6_number' | t }}</p><p>{{ 'dd_home.certificate_6_date' | t }}</p>{% if certificate != blank %}<a href="{{ certificate | image_url: width: 2000 }}" target="_blank" rel="noopener">View Full Document ↗</a>{% endif %}</article></div><p class="dd-factory__note">The CNC document lists LZ-1325. The welding document lists LZ-1500F and LZ-2000F; it does not list LZ-3000F. Please confirm the applicable document for your exact model and configuration.</p></details><p><a href="#FactoryContact">Request Documents for Your Model →</a></p></div></section><section class="dd-factory__section " id="FactorySupport"><div class="dd-factory__wrap"><div class="factory-section-heading"><h2>Practical support before and after delivery</h2><p>Start with your production requirements and agree the equipment and service scope for your project.</p></div><div class="dd-factory__grid"><article class="dd-factory__panel"><h3>Application &amp; sample review</h3><p>Discuss materials, artwork, working area and sample results before selecting equipment.</p></article><article class="dd-factory__panel"><h3>Installation &amp; training</h3><p>English manuals and videos, remote installation training and technical assistance. On-site support can be arranged.</p></article><article class="dd-factory__panel"><h3>Parts &amp; continued support</h3><p>Contact our team for equipment-specific spare parts and help with your machine. Confirm requirements with the model and relevant photographs.</p></article></div></div></section><section class="dd-factory__section dd-factory__tint" id="FactoryFAQ"><div class="dd-factory__wrap"><div class="factory-section-heading"><h2>Planning a factory visit or equipment order</h2><p>Answers to common questions before you contact our team.</p></div><div class="factory-faq"><details><summary>Where is your factory?</summary><p>Our factory is in Guangzhou, China. Contact our team to arrange a visit; we will confirm the detailed address, arrival instructions and a suitable time.</p></details><details><summary>Can I test my material before choosing a machine?</summary><p>Yes. Request a free sample test and share your material, thickness, dimensions and artwork. We will agree the test requirements and suitable equipment with you. Sample shipping arrangements are confirmed separately.</p></details><details><summary>Can I review equipment and packing before shipment?</summary><p>Discuss the review points with our team when confirming your order. Equipment configuration, packing method, shipment arrangements and delivery timing are agreed for the specific order.</p></details><details><summary>What technical support is available?</summary><p>Support includes English manuals and videos, remote installation training, technical assistance and equipment-specific spare parts. On-site support can be arranged according to the project.</p></details><details><summary>Do the conformity documents cover every model?</summary><p>Each document covers only its listed products and models. Ask us to confirm the applicable documentation for the exact model and configuration in your quotation.</p></details></div></div></section><section class="dd-factory__section" id="FactoryContact"><div class="dd-factory__wrap dd-factory__split"><div><p class="dd-factory__eyebrow">VISIT · SAMPLE TEST · EQUIPMENT ADVICE</p><h2>Arrange a factory visit or a free sample test</h2><p>Tell us your application and the equipment you would like to review. For a visit, include your preferred dates and number of visitors. We will confirm the address and arrangements with you.</p><p><a href="mailto:info@gzcnc-laser.com">info@gzcnc-laser.com</a><br><a href="https://wa.me/8618988946615">WhatsApp: +86 189 8894 6615</a></p><p class="dd-factory__note">Need to share artwork or photos? Send them by email or WhatsApp. Name, email and message are required.</p></div>
