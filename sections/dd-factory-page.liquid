      <label for="FactoryMessage-{{ section.id }}">Message *</label><textarea id="FactoryMessage-{{ section.id }}" name="contact[body]" rows="5" placeholder="Your material, equipment interests, sample requirements or preferred factory visit dates..." required>{{ form.body | escape }}</textarea><button type="submit" class="dd-factory__button">Send Inquiry</button>
