<footer class="dd-b2b-footer">
  <div class="dd-b2b-footer__grid">
    <div><h2>{{ 'dd_home.footer_company' | t }}</h2><p>{{ 'dd_home.footer_intro' | t }}</p><a href="{{ routes.root_url }}pages/contact">{{ 'dd_home.sample_test' | t }}</a></div>
    <div><h2>{{ 'dd_home.footer_links' | t }}</h2><a href="{{ routes.root_url }}">{{ 'dd_home.home' | t }}</a><a href="{{ routes.root_url }}#HomeIndustries">{{ 'dd_home.industries' | t }}</a><a href="{{ routes.root_url }}#HomeCases">{{ 'dd_home.cases' | t }}</a><a href="{{ routes.root_url }}pages/factory">{{ 'dd_home.factory' | t }}</a><a href="{{ routes.root_url }}pages/support">{{ 'dd_support.title' | t }}</a><a href="{{ routes.root_url }}pages/faq">{{ 'dd_home.faq' | t }}</a></div>
    <div><h2>{{ 'dd_home.footer_products' | t }}</h2><a href="{{ routes.collections_url }}/co2-laser">{{ 'dd_home.category_1' | t }}</a><a href="{{ routes.collections_url }}/cnc-router">{{ 'dd_home.category_2' | t }}</a>{% for i in (3..6) %}{% assign key = 'dd_home.category_' | append: i %}<a href="{% if i == 4 %}{{ routes.collections_url }}/fiber-laser-cutting{% elsif i == 5 %}{{ routes.collections_url }}/laser-welding{% elsif i == 6 %}{{ routes.collections_url }}/printers{% else %}{{ routes.root_url }}#HomeCategory-{{ i }}{% endif %}">{{ key | t }}</a>{% endfor %}<a href="/products/lz-1390-industrial-co2-laser-cutting-machine">LZ-1390</a><a href="/products/lz-1325-cnc-router">LZ-1325</a></div>
    <div><h2>{{ 'dd_home.footer_contact' | t }}</h2><a href="mailto:info@gzcnc-laser.com">info@gzcnc-laser.com</a><a href="https://wa.me/8618988946615">WhatsApp: +86 189 8894 6615</a><p>{{ 'dd_home.factory_city' | t }}, {{ 'dd_home.factory_location' | t }}</p><a href="{{ routes.root_url }}pages/factory#FactoryContact">Arrange a Factory Visit</a><nav class="dd-b2b-footer__social" aria-label="Official social media"><h3>Follow Us</h3><div><a href="https://www.facebook.com/dragondiamondcnc" target="_blank" rel="noopener noreferrer">Facebook</a><a href="https://www.youtube.com/@guangzhoudragondiamondtech9470" target="_blank" rel="noopener noreferrer">YouTube</a><a href="https://www.linkedin.com/company/guangzhou-dragon-diamond-technology-co-ltd/" target="_blank" rel="noopener noreferrer">LinkedIn</a><a href="https://www.instagram.com/dragondiamondlaser_cnc/" target="_blank" rel="noopener noreferrer">Instagram</a></div></nav></div>
  </div>
  <div class="dd-b2b-footer__bottom"><span>© {{ 'now' | date: '%Y' }} {{ 'dd_home.footer_company' | t }}. {{ 'dd_home.footer_rights' | t }}</span>{% if shop.privacy_policy != blank %}<a href="{{ shop.privacy_policy.url }}">{{ 'dd_home.privacy' | t }}</a>{% endif %}{% if shop.terms_of_service != blank %}<a href="{{ shop.terms_of_service.url }}">{{ 'dd_home.terms' | t }}</a>{% endif %}</div>
</footer>
{% stylesheet %}
.dd-b2b-footer{background:#10272d;color:#d6e7e6;padding:64px 5% 100px;font:15px/1.7 Arial,sans-serif}.dd-b2b-footer__grid{max-width:1280px;margin:auto;display:grid;grid-template-columns:1.5fr .8fr 1fr 1.2fr;gap:36px}.dd-b2b-footer h2{color:#fff;font-size:18px;line-height:1.4;margin:0 0 18px}.dd-b2b-footer a{display:block;color:#d6e7e6;padding:8px 0;overflow-wrap:anywhere;text-underline-offset:4px}.dd-b2b-footer a:hover{color:#7bdfd6}.dd-b2b-footer a:focus-visible{outline:3px solid #de9a35;outline-offset:3px}.dd-b2b-footer__bottom{max-width:1280px;margin:36px auto 0;padding-top:24px;border-top:1px solid #416063;display:flex;flex-wrap:wrap;gap:20px;font-size:12px}@media(max-width:900px){.dd-b2b-footer__grid{grid-template-columns:1fr 1fr}}@media(max-width:540px){.dd-b2b-footer__grid{grid-template-columns:1fr}.dd-b2b-footer a{min-height:44px}}
.dd-b2b-footer__social{margin-top:20px}.dd-b2b-footer__social h3{font-size:16px;color:#fff;margin:0 0 12px}.dd-b2b-footer__social>div{display:flex;flex-wrap:wrap;gap:8px}.dd-b2b-footer__social a{display:inline-flex;align-items:center;min-height:44px;padding:8px 12px;border:1px solid #547377;border-radius:4px;text-decoration:none;font-size:14px}.dd-b2b-footer__social a:hover{background:#1c4147}
{% endstylesheet %}
{% schema %}
{"name":"B2B contact footer","settings":[],"presets":[{"name":"B2B contact footer"}]}
{% endschema %}
