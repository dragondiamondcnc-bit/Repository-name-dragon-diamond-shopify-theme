{% liquid
  assign inquiry_id = 'WeldingInquiry-' | append: section.id
  assign intro = product.description | split: '</p>' | first | strip_html
%}
<div class="dd-welding">
  <div class="dd-welding__hero">
    <div class="dd-welding__wrap">
      <nav class="dd-welding__crumbs" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a> / <a href="{{ routes.collections_url }}/laser-welding">Laser Welding Machines</a></nav>
      <div class="dd-welding__split">
        <div><p class="dd-welding__eyebrow">DRAGON DIAMOND · LASER WELDING SOLUTIONS</p><h1>{{ product.title | escape }}</h1><p class="dd-welding__lead">{{ intro }}</p><p>Equipment selection · Free sample testing · Technical support</p><div class="dd-welding__actions"><a class="dd-welding__button" href="#{{ inquiry_id }}">Get a Quote</a><a href="#welding-results">View Welding Samples</a></div></div>
        {% if product.featured_image != blank %}<figure>{{ product.featured_image | image_url: width: 1400 | image_tag: widths: '480, 750, 1000, 1400', sizes: '(min-width: 900px) 48vw, 100vw', loading: 'eager', fetchpriority: 'high', alt: product.featured_image.alt }}<figcaption>Machine shown for reference. Final configuration is specified in your quotation.</figcaption></figure>{% endif %}
      </div>
    </div>
  </div>
  <div class="dd-welding__wrap">
    <nav class="dd-welding__nav" aria-label="Product information"><a href="#welding-results">Samples</a><a href="#welding-configuration">Configuration</a><a href="#welding-specifications">Specifications</a><a href="#welding-delivery">Delivery &amp; Support</a><a href="#welding-faq">FAQ</a></nav>
    <section id="welding-results" class="dd-welding__samples">
      <div class="dd-welding__sample-heading"><div><p class="dd-welding__sample-eyebrow">MATERIALS &amp; POSSIBILITIES</p><h2>Welding Applications &amp; Sample Ideas</h2><p>{{ section.settings.sample_intro | default: section.settings.sample_description | escape }}</p></div><a class="dd-welding__button" href="#{{ inquiry_id }}">Request a Free Sample Test</a></div>
      {% if section.settings.application_image_1 != blank %}
      <div class="dd-welding__application-grid" tabindex="0" role="region" aria-label="Application illustrations. Scroll horizontally to explore on mobile.">
        {% for i in (1..2) %}{% liquid
          assign image_key = 'application_image_' | append: i
          assign title_key = 'application_title_' | append: i
          assign subtitle_key = 'application_subtitle_' | append: i
          assign application_image = section.settings[image_key]
          assign application_alt = section.settings[title_key] | prepend: 'Welding demonstration sample: '
        %}
        {% if application_image != blank %}<a class="dd-welding__application-card sample-crop-{{ i }}" href="{{ application_image | image_url: width: 1600 }}" target="_blank" rel="noopener" aria-label="{{ section.settings[title_key] | escape }} — view illustration in a new tab">
          {{ application_image | image_url: width: 1200 | image_tag: widths: '360, 600, 900, 1200', sizes: '(min-width: 1240px) 580px, (min-width: 750px) 46vw, 84vw', loading: 'lazy', alt: application_alt }}
          <div class="dd-welding__application-caption"><h3>{{ section.settings[title_key] | escape }}</h3><p>{{ section.settings[subtitle_key] | escape }}</p></div><span class="dd-welding__application-expand" aria-hidden="true">↗</span>
        </a>{% endif %}{% endfor %}
      </div>
      <p class="dd-welding__swipe">Swipe to explore both applications →</p>
      <div class="dd-welding__sample-footer"><p>Frames from our welding demonstration video. Actual results depend on laser power, material, joint preparation and process settings.</p><div>{% for image in product.images offset: 1 %}<a href="{{ image | image_url: width: 1800 }}" target="_blank" rel="noopener">View original sample photos ↗</a>{% endfor %}</div></div>
      {% else %}
      <div class="dd-welding__gallery">{% for image in product.images offset: 1 %}<a href="{{ image | image_url: width: 1800 }}" target="_blank" rel="noopener">{{ image | image_url: width: 800 | image_tag: loading: 'lazy', alt: image.alt }}</a>{% endfor %}</div>
      {% endif %}
    </section>
    <div class="dd-welding__content">{{ product.description }}</div>
    <section id="welding-delivery"><h2>Packaging, Delivery &amp; Technical Support</h2><div class="dd-welding__support"><article><h3>Confirm before shipping</h3><p>We agree the laser power, handheld head, electrical requirements, accessories, packing and shipping method in your quotation. Delivery time is negotiated for each order.</p></article><article><h3>Installation &amp; training</h3><p>English manuals and videos support setup and operation. Our technical team provides remote training and assistance with day-to-day use. On-site training and technical support can be arranged by agreement.</p></article><article><h3>Spare parts &amp; equipment planning</h3><p>We prepare corresponding spare parts for each machine and help plan compatible equipment for your production workflow.</p></article></div></section>
    <section id="welding-faq"><h2>Frequently Asked Questions</h2><details><summary>How do I choose the right laser welding machine?</summary><p>Start with your metal, joint design, required weld finish and production volume. Confirm the metal grade, thickness, joint design, shielding gas and required weld result with a sample test.</p></details><details><summary>Can you test my material before I order?</summary><p>Yes. We provide free sample testing to check the proposed configuration. Send your joint drawing and material information using the inquiry form; sample shipping arrangements are agreed separately.</p></details><details><summary>Can the configuration be customized?</summary><p>Choose 1500W, 2000W or 3000W, then confirm the head, wire-feeding arrangement, shielding gas, cooling and site electrical requirements. Confirm the required accessories for welding, cleaning and cutting in your quotation.</p></details><details><summary>What is the price and delivery time?</summary><p>We quote according to the selected configuration, accessories and delivery requirements. Lead time is confirmed for your specific order.</p></details></section>
    <section><h2>Related Equipment</h2><div class="dd-welding__related">{% assign related_handles = 'lz-t5-desktop-fiber-laser-marking-machine,1530-fiber-laser-cutting-machine' | split: ',' %}{% for related_handle in related_handles %}{% assign related = all_products[related_handle] %}{% unless related.id == product.id %}<a href="{{ related.url }}">{% if related.featured_image != blank %}{{ related.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: related.featured_image.alt }}{% endif %}<h3>{{ related.title | escape }}</h3><span>View Product →</span></a>{% endunless %}{% endfor %}</div><p><a href="{{ routes.collections_url }}/laser-welding">Explore all laser welding machines</a></p></section>
    <section id="{{ inquiry_id }}" class="dd-welding__inquiry"><h2>Get a Quote for Your Welding Application</h2><p>Tell us your metal grade, thickness, joint design and production requirements.</p>{% form 'contact', id: inquiry_id %}{% if form.posted_successfully? %}<p role="status">Thank you. Your inquiry has been sent.</p>{% endif %}{{ form.errors | default_errors }}<input type="hidden" name="contact[Product URL]" value="{{ canonical_url | escape }}"><div class="dd-welding__fields"><label for="Name-{{ section.id }}">Name *<input id="Name-{{ section.id }}" name="contact[name]" autocomplete="name" value="{{ form.name | escape }}" required></label><label for="Email-{{ section.id }}">Email *<input id="Email-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" value="{{ form.email | escape }}" required></label><label for="Company-{{ section.id }}">Company<input id="Company-{{ section.id }}" name="contact[Company]" autocomplete="organization"></label><label for="Whatsapp-{{ section.id }}">WhatsApp<input id="Whatsapp-{{ section.id }}" name="contact[WhatsApp]" type="tel" autocomplete="tel"></label><label for="Product-{{ section.id }}">Product Interested<input id="Product-{{ section.id }}" name="contact[Product Interested]" value="{{ product.title | escape }}"></label><label class="dd-welding__message" for="Message-{{ section.id }}">Message *<textarea id="Message-{{ section.id }}" name="contact[body]" rows="5" required>{{ form.body | escape }}</textarea></label></div><button class="dd-welding__button" type="submit">Send Inquiry</button>{% endform %}<p><a href="mailto:info@gzcnc-laser.com">info@gzcnc-laser.com</a> · <a href="https://wa.me/8618988946615">WhatsApp: +86 189 8894 6615</a></p></section>
  </div>
</div>
<script type="application/ld+json">{"@context":"https://schema.org","@type":"Product","@id":{{ canonical_url | append: '#product' | json }},"url":{{ canonical_url | json }},"name":{{ product.title | json }},"description":{{ intro | json }},"brand":{"@type":"Brand","name":"Dragon Diamond"}{% if product.featured_image != blank %},"image":{{ product.featured_image | image_url: width: 1400 | prepend: 'https:' | json }}{% endif %}}</script>
<script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":{{ request.origin | json }}},{"@type":"ListItem","position":2,"name":"Laser Welding Machines","item":{{ request.origin | append: '/collections/laser-welding' | json }}},{"@type":"ListItem","position":3,"name":{{ product.title | json }},"item":{{ canonical_url | json }}}]}</script>
{% render 'dd-support-link' %}
{% stylesheet %}
  .dd-welding{background:#f6f8f8;color:#182d30;font-family:Arial,sans-serif;line-height:1.65}.dd-welding *{box-sizing:border-box}.dd-welding__wrap{max-width:1240px;margin:auto;padding:0 32px}.dd-welding__hero{padding:140px 0 56px;background:#123439;color:#fff}.dd-welding__crumbs{font-size:13px;margin-bottom:38px}.dd-welding a{color:inherit;text-underline-offset:4px}.dd-welding__split{display:grid;grid-template-columns:1fr 1fr;gap:36px;align-items:center}.dd-welding h1{font-size:clamp(32px,4vw,54px);line-height:1.12;color:inherit;letter-spacing:-1px;margin:18px 0 24px}.dd-welding h2{font-size:30px;line-height:1.2;margin:0 0 24px}.dd-welding h3{font-size:20px;line-height:1.35}.dd-welding__eyebrow{font-size:12px;font-weight:bold;letter-spacing:2px;color:#6edbd1}.dd-welding__lead{font-size:19px}.dd-welding figure{margin:0}.dd-welding__hero img{width:100%;height:520px;object-fit:contain;background:transparent}.dd-welding figcaption{font-size:12px;opacity:.8;margin-top:12px}.dd-welding__actions{display:flex;flex-wrap:wrap;gap:24px;align-items:center;margin-top:28px}.dd-welding .dd-welding__button{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:13px 24px;background:#6ddbd0;color:#102c30;font:700 16px Arial,sans-serif;text-decoration:none;border:0;border-radius:4px;cursor:pointer}.dd-welding__nav{display:flex;flex-wrap:wrap;gap:22px;padding:24px 0;border-bottom:1px solid #d3dfdf}.dd-welding section,.dd-welding__content{padding:48px 0;border-bottom:1px solid #d3dfdf;scroll-margin-top:110px}.dd-welding__content>p:first-child{display:none}.dd-welding__content h2:not(:first-child){margin-top:42px}.dd-welding__content li{margin:8px 0}.dd-welding__samples{display:block}.dd-welding__sample-heading{display:flex;justify-content:space-between;align-items:center;gap:28px;margin-bottom:22px}.dd-welding__sample-heading>div{max-width:740px}.dd-welding__sample-heading h2{margin:6px 0 10px}.dd-welding__sample-heading p{margin:0}.dd-welding__sample-heading .dd-welding__button{flex-shrink:0}.dd-welding__sample-eyebrow{font-size:11px;letter-spacing:1.8px;font-weight:700;color:#157077}.dd-welding__application-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.dd-welding__application-card{position:relative;display:block;min-width:0;aspect-ratio:16/10;border-radius:8px;overflow:hidden;background:#263e40;text-decoration:none;color:white}.dd-welding__application-card img{display:block;width:100%;height:100%;object-fit:cover}.dd-welding__application-caption{position:absolute;inset:auto 0 0;padding:50px 24px 20px;background:linear-gradient(transparent,rgba(6,19,21,.88));color:white}.dd-welding__application-caption h3{font-size:25px;color:white;margin:0 0 4px}.dd-welding__application-caption p{font-size:14px;margin:0;color:#edf5f3}.dd-welding__application-expand{position:absolute;right:14px;top:14px;display:grid;place-items:center;width:34px;height:34px;border-radius:50%;background:rgba(9,30,32,.65);color:white;font-size:22px}.dd-welding__sample-footer{display:flex;justify-content:space-between;gap:16px;margin-top:12px;font-size:12px;color:#526c6e}.dd-welding__sample-footer p{margin:0}.dd-welding__sample-footer a{display:inline-block;padding:2px 0;margin-left:12px;text-underline-offset:3px}.dd-welding__sample-footer>div{flex-shrink:0}.dd-welding__swipe{display:none}.dd-welding__gallery img{max-height:300px;width:100%;object-fit:contain}.dd-welding__support,.dd-welding__related{display:grid;grid-template-columns:repeat(3,1fr);gap:28px}.dd-welding__related{grid-template-columns:repeat(2,1fr)}.dd-welding__related>a{padding:24px;background:#e9efee;text-decoration:none}.dd-welding__related img{width:100%;height:230px;object-fit:contain}.dd-welding details{border-bottom:1px solid #d3dfdf;padding:18px 0}.dd-welding summary{font-weight:700;cursor:pointer}.dd-welding table{width:100%;border-collapse:collapse;margin:20px 0;font-size:15px}.dd-welding th,.dd-welding td{padding:12px;border:1px solid #cad8d8;text-align:left;overflow-wrap:anywhere}.dd-welding th{width:40%;background:#e9efee}.dd-welding__fields{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin:25px 0}.dd-welding label{font-weight:700;display:block}.dd-welding input,.dd-welding textarea{display:block;width:100%;padding:13px;border:1px solid #a7baba;border-radius:3px;background:white;color:#182d30;font:16px Arial,sans-serif;margin-top:6px}.dd-welding__message{grid-column:1/-1}.dd-welding__inquiry a{overflow-wrap:anywhere}.dd-welding :focus-visible{outline:3px solid #009c9c;outline-offset:4px}@media(max-width:749px){.dd-welding__sample-heading{display:block;margin-bottom:18px}.dd-welding__sample-heading h2{font-size:26px}.dd-welding__sample-heading .dd-welding__button{margin-top:16px}.dd-welding__application-grid{display:flex;gap:12px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:thin;padding-bottom:8px}.dd-welding__application-card{flex:0 0 90%;aspect-ratio:4/3;scroll-snap-align:start}.dd-welding__application-caption{padding:40px 16px 16px}.dd-welding__application-caption h3{font-size:22px}.dd-welding__application-caption p{font-size:13px}.dd-welding__sample-footer{display:block;margin-top:8px}.dd-welding__sample-footer a{padding:10px 0}.dd-welding__swipe{display:block;margin:6px 0;font-size:12px;color:#526c6e}.dd-welding__wrap{padding:0 20px}.dd-welding__hero{padding:110px 0 36px}.dd-welding__split,.dd-welding__support,.dd-welding__related,.dd-welding__fields{grid-template-columns:1fr}.dd-welding__hero img{height:350px}.dd-welding h1{font-size:36px}.dd-welding h2{font-size:27px}.dd-welding section,.dd-welding__content{padding:34px 0}.dd-welding__nav{gap:12px 20px;font-size:14px}.dd-welding__button{width:100%}.dd-welding__crumbs{overflow-wrap:anywhere}}

{% endstylesheet %}
{% schema %}
{
  "name": "B2B laser welding",
  "settings": [
    {
      "type": "textarea",
      "id": "sample_description",
      "label": "Application introduction",
      "default": "Explore welding applications and request a sample test with your own material."
    },
    {
      "type": "textarea",
      "id": "sample_intro",
      "label": "Short application introduction"
    },
    {
      "type": "image_picker",
      "id": "application_image_1",
      "label": "Application illustration 1"
    },
    {
      "type": "text",
      "id": "application_title_1",
      "label": "Application 1 title"
    },
    {
      "type": "text",
      "id": "application_subtitle_1",
      "label": "Application 1 subtitle"
    },
    {
      "type": "image_picker",
      "id": "application_image_2",
      "label": "Application illustration 2"
    },
    {
      "type": "text",
      "id": "application_title_2",
      "label": "Application 2 title"
    },
    {
      "type": "text",
      "id": "application_subtitle_2",
      "label": "Application 2 subtitle"
    }
  ],
  "presets": [
    {
      "name": "B2B welding product"
    }
  ]
}
{% endschema %}
