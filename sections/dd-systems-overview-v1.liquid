<section class="dd-systems-overview" aria-labelledby="DDSystemsOverviewHeading-{{ section.id }}" data-systems-overview>
  <div class="dd-systems-overview__frame">
    <header class="dd-systems-overview__header">
      <p class="dd-systems-overview__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 id="DDSystemsOverviewHeading-{{ section.id }}">{{ section.settings.heading }}</h2>
      <p>{{ section.settings.description }}</p>
    </header>

    <div class="dd-systems-overview__layout">
      <div class="dd-systems-overview__nav" role="tablist" aria-label="Production systems">
        {% assign previous_group = '' %}
        {% for block in section.blocks %}
          {% if forloop.first or block.settings.group != previous_group %}
            <p class="dd-systems-overview__group" role="presentation">
              {% if block.settings.group == 'industrial' %}Industrial Processing{% else %}Primary Systems{% endif %}
            </p>
          {% endif %}
          <button class="dd-systems-overview__tab{% if forloop.first %} is-active{% endif %}" type="button" role="tab" id="DDSystemsTab-{{ section.id }}-{{ block.id }}" aria-controls="DDSystemsPanel-{{ section.id }}-{{ block.id }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" data-system-tab="{{ block.id }}" {{ block.shopify_attributes }}>
            <span>{{ forloop.index | prepend: '0' }} //</span>
            <strong>{{ block.settings.title }}</strong>
          </button>
          {% assign previous_group = block.settings.group %}
        {% endfor %}
      </div>

      <div class="dd-systems-overview__documents">
        {% for block in section.blocks %}
          {% case forloop.index %}
            {% when 1 %}{% assign system_asset = 'section05-co2-production.jpg' %}
            {% when 2 %}{% assign system_asset = 'section05-cnc-production.jpg' %}
            {% when 3 %}{% assign system_asset = 'section05-uv-production.jpg' %}
            {% when 4 %}{% assign system_asset = 'section05-fiber-production.jpg' %}
            {% when 5 %}{% assign system_asset = 'section05-welding-production.jpg' %}
            {% else %}{% assign system_asset = 'section05-marking-production.jpg' %}
          {% endcase %}
          <article class="dd-systems-overview__panel{% if forloop.first %} is-active{% endif %}" role="tabpanel" id="DDSystemsPanel-{{ section.id }}-{{ block.id }}" aria-labelledby="DDSystemsTab-{{ section.id }}-{{ block.id }}" data-system-panel="{{ block.id }}">
            <div class="dd-systems-overview__media">
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 1600 | image_tag: class: 'dd-systems-overview__image', loading: 'lazy', widths: '640, 960, 1280, 1600', sizes: '(min-width: 990px) 62vw, 100vw' }}
              {% else %}
                <img class="dd-systems-overview__image" src="{{ system_asset | asset_url }}" alt="{{ block.settings.title | escape }} production evidence" width="1600" height="900" loading="lazy">
              {% endif %}
              <span class="dd-systems-overview__media-label">Production reference / {{ forloop.index | prepend: '0' }}</span>
            </div>
            <div class="dd-systems-overview__content">
              <p class="dd-systems-overview__document-label">System document / {{ forloop.index | prepend: '0' }}</p>
              <h3>{{ block.settings.title }}</h3>
              <dl>
                <div><dt>Best for</dt><dd>{{ block.settings.best_for }}</dd></div>
                <div><dt>Main applications</dt><dd>{{ block.settings.applications }}</dd></div>
                <div><dt>Materials</dt><dd>{{ block.settings.materials }}</dd></div>
              </dl>
              {% if block.settings.link != blank %}
                <a href="{{ block.settings.link }}" data-track="cta" data-cta-id="production_system_solution" data-section="production_systems_overview">Review Solution System <span aria-hidden="true">→</span></a>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .dd-systems-overview { background: #0f1115; color: #fff; font-family: 'Archivo Narrow', sans-serif; }
  .dd-systems-overview__frame { width: min(100% - 64px, 1240px); margin: 0 auto; padding: 112px 0 120px; }
  .dd-systems-overview__header { display: grid; grid-template-columns: 1fr 2fr; gap: 24px 64px; padding-bottom: 56px; border-bottom: 1px solid rgba(255,255,255,.16); }
  .dd-systems-overview__eyebrow, .dd-systems-overview__document-label { margin: 0; color: #00a3ad; font-size: 11px; font-weight: 700; letter-spacing: .24em; text-transform: uppercase; }
  .dd-systems-overview__header h2 { margin: 0; font-size: clamp(38px, 4.5vw, 62px); line-height: 1; letter-spacing: -.025em; text-transform: uppercase; }
  .dd-systems-overview__header > p:last-child { grid-column: 2; max-width: 620px; margin: 0; color: rgba(255,255,255,.62); font-size: 17px; line-height: 1.6; }
  .dd-systems-overview__layout { display: grid; grid-template-columns: 350px minmax(0, 1fr); border-bottom: 1px solid rgba(255,255,255,.16); }
  .dd-systems-overview__nav { border-right: 1px solid rgba(255,255,255,.16); }
  .dd-systems-overview__group { margin: 0; padding: 24px 20px 12px 0; color: rgba(255,255,255,.42); font-size: 10px; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; }
  .dd-systems-overview__tab { position: relative; display: grid; grid-template-columns: 54px 1fr; width: 100%; padding: 22px 24px 22px 0; border: 0; border-top: 1px solid rgba(255,255,255,.12); background: transparent; color: #fff; text-align: left; cursor: pointer; }
  .dd-systems-overview__tab::after { content: ''; position: absolute; right: -1px; top: 0; bottom: 0; width: 3px; background: transparent; }
  .dd-systems-overview__tab:hover::after, .dd-systems-overview__tab:focus-visible::after, .dd-systems-overview__tab.is-active::after { background: #00a3ad; }
  .dd-systems-overview__tab:focus-visible { outline: 2px solid #00a3ad; outline-offset: -3px; }
  .dd-systems-overview__tab span { color: #00a3ad; font-size: 10px; letter-spacing: .1em; }
  .dd-systems-overview__tab strong { font-size: 16px; letter-spacing: .04em; text-transform: uppercase; }
  .dd-systems-overview__documents { min-width: 0; }
  .dd-systems-overview[data-enhanced] .dd-systems-overview__panel:not(.is-active) { display: none; }
  .dd-systems-overview__panel { min-width: 0; }
  .dd-systems-overview__media { position: relative; aspect-ratio: 16 / 8; overflow: hidden; background: #07090c; }
  .dd-systems-overview__image { width: 100%; height: 100%; object-fit: cover; filter: grayscale(28%) contrast(1.08); }
  .dd-systems-overview__media-label { position: absolute; left: 0; bottom: 0; padding: 10px 16px; background: #0f1115; color: rgba(255,255,255,.7); font-size: 9px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
  .dd-systems-overview__content { padding: 44px 48px 52px; }
  .dd-systems-overview__content h3 { margin: 14px 0 32px; font-size: clamp(32px, 4vw, 50px); line-height: 1; text-transform: uppercase; }
  .dd-systems-overview__content dl { display: grid; grid-template-columns: repeat(3, 1fr); margin: 0 0 40px; border-top: 1px solid rgba(255,255,255,.16); border-bottom: 1px solid rgba(255,255,255,.16); }
  .dd-systems-overview__content dl div { padding: 24px 22px 28px 0; }
  .dd-systems-overview__content dl div + div { padding-left: 22px; border-left: 1px solid rgba(255,255,255,.16); }
  .dd-systems-overview__content dt { margin-bottom: 12px; color: #00a3ad; font-size: 10px; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; }
  .dd-systems-overview__content dd { margin: 0; color: rgba(255,255,255,.72); font-size: 14px; line-height: 1.55; }
  .dd-systems-overview__content a { display: inline-flex; gap: 24px; align-items: center; min-height: 48px; color: #fff; font-size: 12px; font-weight: 700; letter-spacing: .14em; text-decoration: none; text-transform: uppercase; border-bottom: 1px solid #00a3ad; }
  @media (max-width: 990px) {
    .dd-systems-overview__header { grid-template-columns: 1fr; }
    .dd-systems-overview__header > p:last-child { grid-column: 1; }
    .dd-systems-overview__layout { grid-template-columns: 1fr; }
    .dd-systems-overview__nav { display: flex; overflow-x: auto; border-right: 0; border-bottom: 1px solid rgba(255,255,255,.16); scrollbar-width: thin; }
    .dd-systems-overview__group { display: none; }
    .dd-systems-overview__tab { flex: 0 0 210px; grid-template-columns: 40px 1fr; padding: 20px 16px; border-top: 0; border-right: 1px solid rgba(255,255,255,.12); }
    .dd-systems-overview__tab::after { top: auto; left: 0; right: 0; bottom: 0; width: auto; height: 3px; }
  }
  @media (max-width: 760px) {
    .dd-systems-overview__frame { width: min(100% - 40px, 1240px); padding: 80px 0; }
    .dd-systems-overview__header { padding-bottom: 40px; }
    .dd-systems-overview__media { aspect-ratio: 4 / 3; }
    .dd-systems-overview__content { padding: 32px 0 40px; }
    .dd-systems-overview__content dl { grid-template-columns: 1fr; }
    .dd-systems-overview__content dl div, .dd-systems-overview__content dl div + div { padding: 20px 0; border-left: 0; }
    .dd-systems-overview__content dl div + div { border-top: 1px solid rgba(255,255,255,.12); }
  }
{% endstylesheet %}

{% javascript %}
  document.querySelectorAll('[data-systems-overview]').forEach((section) => {
    section.dataset.enhanced = 'true';
    const tabs = Array.from(section.querySelectorAll('[data-system-tab]'));
    const panels = Array.from(section.querySelectorAll('[data-system-panel]'));
    const activate = (tab) => {
      tabs.forEach((item) => {
        const selected = item === tab;
        item.classList.toggle('is-active', selected);
        item.setAttribute('aria-selected', selected ? 'true' : 'false');
      });
      panels.forEach((panel) => panel.classList.toggle('is-active', panel.dataset.systemPanel === tab.dataset.systemTab));
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activate(tab));
      tab.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
        event.preventDefault();
        const offset = event.key === 'ArrowRight' ? 1 : -1;
        const nextTab = tabs[(index + offset + tabs.length) % tabs.length];
        activate(nextTab);
        nextTab.focus();
      });
    });
  });
{% endjavascript %}

{% schema %}
{
  "name": "DD Systems Overview V1",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "SYSTEM SELECTION / 01" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Production System Overview" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Review each system by production purpose, application range and material capability." }
  ],
  "blocks": [{
    "type": "system",
    "name": "Production system",
    "settings": [
      { "type": "select", "id": "group", "label": "System group", "options": [{ "value": "primary", "label": "Primary system" }, { "value": "industrial", "label": "Industrial processing" }], "default": "primary" },
      { "type": "text", "id": "title", "label": "System name" },
      { "type": "textarea", "id": "best_for", "label": "Best for" },
      { "type": "textarea", "id": "applications", "label": "Main applications" },
      { "type": "textarea", "id": "materials", "label": "Materials" },
      { "type": "image_picker", "id": "image", "label": "Production evidence image" },
      { "type": "url", "id": "link", "label": "Future solution page" }
    ]
  }],
  "presets": [{ "name": "DD Systems Overview V1" }]
}
{% endschema %}
