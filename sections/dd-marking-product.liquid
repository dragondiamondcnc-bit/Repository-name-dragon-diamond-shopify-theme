{% liquid
  assign inquiry_id = 'MarkingInquiry-' | append: section.id
  assign intro = product.description | split: '</p>' | first | strip_html
  assign category_handle = 'fiber-laser-marking'
  if product.product_type contains 'CO2'
    assign category_handle = 'co2-laser-marking'
  elsif product.product_type contains 'UV'
    assign category_handle = 'uv-laser-marking'
  endif
  assign subcategory = collections[category_handle]
%}
<div class="dd-marking">
  <div class="dd-marking__hero">
    <div class="dd-marking__wrap">
      <nav class="dd-marking__crumbs" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a> / <a href="{{ routes.collections_url }}/laser-marking">Laser Marking Machines</a> / <a href="{{ subcategory.url }}">{{ subcategory.title | escape }}</a></nav>
      <div class="dd-marking__split">
        <div><p class="dd-marking__eyebrow">DRAGON DIAMOND · LASER MARKING SOLUTIONS</p><h1>{{ product.title | escape }}</h1><p class="dd-marking__lead">{{ intro }}</p><p>Equipment selection · Free sample testing · Technical support</p><div class="dd-marking__actions"><a class="dd-marking__button" href="#{{ inquiry_id }}">Get a Quote</a><a href="#marking-results">View Marking Samples</a></div></div>
        {% if product.featured_image != blank %}<figure>{{ product.featured_image | image_url: width: 1400 | image_tag: widths: '480, 750, 1000, 1400', sizes: '(min-width: 900px) 48vw, 100vw', loading: 'eager', fetchpriority: 'high', alt: product.featured_image.alt }}<figcaption>Machine shown for reference. Final configuration is specified in your quotation.</figcaption></figure>{% endif %}
      </div>
    </div>
  </div>
  <div class="dd-marking__wrap">
    <nav class="dd-marking__nav" aria-label="Product information"><a href="#marking-results">Samples</a><a href="#marking-configuration">Configuration</a><a href="#marking-specifications">Specifications</a><a href="#marking-delivery">Delivery &amp; Support</a><a href="#marking-faq">FAQ</a></nav>
    <section id="marking-results"><h2>Marking Samples &amp; Applications</h2><p>{{ section.settings.sample_description | escape }}</p><div class="dd-marking__gallery">{% for image in product.images offset: 1 %}<figure><a href="{{ image | image_url: width: 1800 }}" target="_blank" rel="noopener">{{ image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '480, 750, 1000', sizes: '(min-width: 900px) 600px, 100vw', alt: image.alt }}</a><figcaption>{{ image.alt | escape }}</figcaption></figure>{% endfor %}</div><p>Samples illustrate applications, not a guarantee for every material or configuration. Send your material and artwork for a free sample test.</p><a class="dd-marking__button" href="#{{ inquiry_id }}">Request a Free Sample Test</a></section>
    <div class="dd-marking__content">{{ product.description }}</div>
    <section id="marking-delivery"><h2>Packaging, Delivery &amp; Technical Support</h2><div class="dd-marking__support"><article><h3>Confirm before shipping</h3><p>We agree the laser power, lens, electrical requirements, accessories, packing and shipping method in your quotation. Delivery time is negotiated for each order.</p></article><article><h3>Installation &amp; training</h3><p>English manuals and videos support setup and operation. Our technical team provides remote training and assistance with day-to-day use. On-site training and technical support can be arranged by agreement.</p></article><article><h3>Spare parts &amp; equipment planning</h3><p>We prepare corresponding spare parts for each machine and help plan compatible equipment for your production workflow.</p></article></div></section>
    <section id="marking-faq"><h2>Frequently Asked Questions</h2><details><summary>How do I choose the right laser marking machine?</summary><p>Start with your material, coating, marking area, required contrast and production volume. Compare Fiber, CO2 and UV options, then confirm the result with a sample test.</p></details><details><summary>Can you test my material before I order?</summary><p>Yes. We provide free sample testing to check the proposed configuration. Send your artwork and material information using the inquiry form; sample shipping arrangements are agreed separately.</p></details><details><summary>Can the configuration be customized?</summary><p>We help select the listed power and lens options. Tell us your workpiece dimensions, electrical supply and any rotary marking requirements so we can confirm a compatible configuration.</p></details><details><summary>What is the price and delivery time?</summary><p>We quote according to the selected configuration, accessories and delivery requirements. Lead time is confirmed for your specific order.</p></details></section>
    <section><h2>Compare Laser Marking Machines</h2><div class="dd-marking__related">{% for related in collections['laser-marking'].products %}{% unless related.id == product.id %}<a href="{{ related.url }}">{% if related.featured_image != blank %}{{ related.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: related.featured_image.alt }}{% endif %}<h3>{{ related.title | escape }}</h3><span>View Product →</span></a>{% endunless %}{% endfor %}</div><p><a href="{{ routes.collections_url }}/laser-marking">Explore all laser marking machines</a></p></section>
    <section id="{{ inquiry_id }}" class="dd-marking__inquiry"><h2>Get a Quote for Your Marking Application</h2><p>Tell us your material, workpiece size, artwork and production requirements.</p>{% form 'contact', id: inquiry_id %}{% if form.posted_successfully? %}<p role="status">Thank you. Your inquiry has been sent.</p>{% endif %}{{ form.errors | default_errors }}<input type="hidden" name="contact[Product URL]" value="{{ canonical_url | escape }}"><div class="dd-marking__fields"><label for="Name-{{ section.id }}">Name *<input id="Name-{{ section.id }}" name="contact[name]" autocomplete="name" value="{{ form.name | escape }}" required></label><label for="Email-{{ section.id }}">Email *<input id="Email-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" value="{{ form.email | escape }}" required></label><label for="Company-{{ section.id }}">Company<input id="Company-{{ section.id }}" name="contact[Company]" autocomplete="organization"></label><label for="Whatsapp-{{ section.id }}">WhatsApp<input id="Whatsapp-{{ section.id }}" name="contact[WhatsApp]" type="tel" autocomplete="tel"></label><label for="Product-{{ section.id }}">Product Interested<input id="Product-{{ section.id }}" name="contact[Product Interested]" value="{{ product.title | escape }}"></label><label class="dd-marking__message" for="Message-{{ section.id }}">Message *<textarea id="Message-{{ section.id }}" name="contact[body]" rows="5" required>{{ form.body | escape }}</textarea></label></div><button class="dd-marking__button" type="submit">Send Inquiry</button>{% endform %}<p><a href="mailto:info@gzcnc-laser.com">info@gzcnc-laser.com</a> · <a href="https://wa.me/8618988946615">WhatsApp: +86 189 8894 6615</a></p></section>
  </div>
</div>
<script type="application/ld+json">{"@context":"https://schema.org","@type":"Product","@id":{{ canonical_url | append: '#product' | json }},"url":{{ canonical_url | json }},"name":{{ product.title | json }},"description":{{ intro | json }},"brand":{"@type":"Brand","name":"Dragon Diamond"}{% if product.featured_image != blank %},"image":{{ product.featured_image | image_url: width: 1400 | prepend: 'https:' | json }}{% endif %}}</script>
<script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":{{ request.origin | json }}},{"@type":"ListItem","position":2,"name":"Laser Marking Machines","item":{{ request.origin | append: '/collections/laser-marking' | json }}},{"@type":"ListItem","position":3,"name":{{ subcategory.title | json }},"item":{{ request.origin | append: subcategory.url | json }}},{"@type":"ListItem","position":4,"name":{{ product.title | json }},"item":{{ canonical_url | json }}}]}</script>
{% stylesheet %}
  .dd-marking{background:#f6f8f8;color:#182d30;font-family:Arial,sans-serif;line-height:1.65}.dd-marking *{box-sizing:border-box}.dd-marking__wrap{max-width:1240px;margin:auto;padding:0 32px}.dd-marking__hero{padding:140px 0 56px;background:#123439;color:#fff}.dd-marking__crumbs{font-size:13px;margin-bottom:38px}.dd-marking a{color:inherit;text-underline-offset:4px}.dd-marking__split{display:grid;grid-template-columns:1fr 1fr;gap:36px;align-items:center}.dd-marking h1{font-size:clamp(32px,4vw,54px);line-height:1.12;color:inherit;letter-spacing:-1px;margin:18px 0 24px}.dd-marking h2{font-size:30px;line-height:1.2;margin:0 0 24px}.dd-marking h3{font-size:20px;line-height:1.35}.dd-marking__eyebrow{font-size:12px;font-weight:bold;letter-spacing:2px;color:#6edbd1}.dd-marking__lead{font-size:19px}.dd-marking figure{margin:0}.dd-marking__hero img{width:100%;height:520px;object-fit:contain;background:transparent}.dd-marking figcaption{font-size:12px;opacity:.8;margin-top:12px}.dd-marking__actions{display:flex;flex-wrap:wrap;gap:24px;align-items:center;margin-top:28px}.dd-marking .dd-marking__button{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:13px 24px;background:#6ddbd0;color:#102c30;font:700 16px Arial,sans-serif;text-decoration:none;border:0;border-radius:4px;cursor:pointer}.dd-marking__nav{display:flex;flex-wrap:wrap;gap:22px;padding:24px 0;border-bottom:1px solid #d3dfdf}.dd-marking section,.dd-marking__content{padding:48px 0;border-bottom:1px solid #d3dfdf;scroll-margin-top:110px}.dd-marking__content>p:first-child{display:none}.dd-marking__content h2:not(:first-child){margin-top:42px}.dd-marking__content li{margin:8px 0}.dd-marking__gallery{max-width:640px;margin:24px auto}.dd-marking__gallery img{width:100%;height:auto;object-fit:contain}.dd-marking__support,.dd-marking__related{display:grid;grid-template-columns:repeat(3,1fr);gap:28px}.dd-marking__related{grid-template-columns:repeat(2,1fr)}.dd-marking__related>a{padding:24px;background:#e9efee;text-decoration:none}.dd-marking__related img{width:100%;height:230px;object-fit:contain}.dd-marking details{border-bottom:1px solid #d3dfdf;padding:18px 0}.dd-marking summary{font-weight:700;cursor:pointer}.dd-marking table{width:100%;border-collapse:collapse;margin:20px 0;font-size:15px}.dd-marking th,.dd-marking td{padding:12px;border:1px solid #cad8d8;text-align:left;overflow-wrap:anywhere}.dd-marking th{width:40%;background:#e9efee}.dd-marking__fields{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin:25px 0}.dd-marking label{font-weight:700;display:block}.dd-marking input,.dd-marking textarea{display:block;width:100%;padding:13px;border:1px solid #a7baba;border-radius:3px;background:white;color:#182d30;font:16px Arial,sans-serif;margin-top:6px}.dd-marking__message{grid-column:1/-1}.dd-marking__inquiry a{overflow-wrap:anywhere}.dd-marking :focus-visible{outline:3px solid #009c9c;outline-offset:4px}@media(max-width:749px){.dd-marking__wrap{padding:0 20px}.dd-marking__hero{padding:110px 0 36px}.dd-marking__split,.dd-marking__support,.dd-marking__related,.dd-marking__fields{grid-template-columns:1fr}.dd-marking__hero img{height:350px}.dd-marking h1{font-size:36px}.dd-marking h2{font-size:27px}.dd-marking section,.dd-marking__content{padding:34px 0}.dd-marking__nav{gap:12px 20px;font-size:14px}.dd-marking__button{width:100%}.dd-marking__crumbs{overflow-wrap:anywhere}}
{% endstylesheet %}
{% schema %}
{"name":"B2B marking product","settings":[{"type":"textarea","id":"sample_description","label":"Application introduction","default":"Explore marking applications and request a sample test with your own material."}],"presets":[{"name":"B2B marking product"}]}
{% endschema %}
