<section class="dd-solution-cta" aria-labelledby="DDSolutionCta-{{ section.id }}"><div class="dd-solution-cta__frame"><p>{{ section.settings.eyebrow }}</p><div><h2 id="DDSolutionCta-{{ section.id }}">{{ section.settings.heading }}</h2><p>{{ section.settings.description }}</p><ul><li>Material</li><li>Thickness</li><li>Working Size</li><li>Production Application</li></ul><a href="{{ section.settings.button_url }}" data-track="cta" data-cta-id="co2_solution_final_discuss_project" data-section="solution_cta">{{ section.settings.button_text }} <span aria-hidden="true">→</span></a></div></div></section>
{% stylesheet %}.dd-solution-cta{background:#00a3ad;color:#071014;font-family:'Archivo Narrow',sans-serif}.dd-solution-cta__frame{display:grid;grid-template-columns:1fr 2fr;gap:32px 64px;width:min(100% - 64px,1240px);margin:auto;padding:96px 0}.dd-solution-cta__frame>p{margin:0;font-size:11px;font-weight:700;letter-spacing:.22em;text-transform:uppercase}.dd-solution-cta h2{max-width:18ch;margin:0;font-size:clamp(42px,5vw,68px);line-height:.98;text-transform:uppercase}.dd-solution-cta div>p{max-width:650px;margin:24px 0 16px;font-family:Arial,sans-serif;font-size:16px;line-height:1.6}.dd-solution-cta ul{display:flex;flex-wrap:wrap;gap:8px 28px;margin:0 0 28px;padding:0;list-style:none;font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase}.dd-solution-cta li:before{content:'//';margin-right:8px}.dd-solution-cta a{display:inline-flex;align-items:center;gap:16px;min-height:50px;border-bottom:1px solid #071014;color:#071014;font-size:12px;font-weight:700;letter-spacing:.14em;text-decoration:none;text-transform:uppercase}.dd-solution-cta a:focus-visible{outline:2px solid #071014;outline-offset:5px}@media(max-width:760px){.dd-solution-cta__frame{grid-template-columns:1fr;width:min(100% - 40px,1240px);padding:72px 0}.dd-solution-cta ul{display:grid;grid-template-columns:1fr 1fr}}{% endstylesheet %}
{% schema %}{"name":"DD Solution CTA V1","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"PRODUCTION PROJECT"},{"type":"text","id":"heading","label":"Heading","default":"Planning a CO₂ Laser Cutting System?"},{"type":"textarea","id":"description","label":"Description","default":"Prepare the core production information so our team can review the system requirement with you."},{"type":"text","id":"button_text","label":"CTA label","default":"DISCUSS YOUR PROJECT"},{"type":"url","id":"button_url","label":"CTA link"}],"presets":[{"name":"DD Solution CTA V1"}]}{% endschema %}
