<section class="dd-solution-products" aria-labelledby="DDSolutionProducts-{{ section.id }}"><div class="dd-solution-products__frame"><header><p>{{ section.settings.eyebrow }}</p><h2 id="DDSolutionProducts-{{ section.id }}">{{ section.settings.heading }}</h2></header>{% for block in section.blocks %}<article {{ block.shopify_attributes }}><div class="dd-solution-products__media">{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1400', sizes: '(min-width: 761px) 50vw, 100vw', alt: block.settings.image_alt }}{% else %}<img src="{{ 'lz1390-open-final.png' | asset_url }}" alt="LZ-1390 CO₂ laser cutting system" width="1200" height="900" loading="lazy">{% endif %}</div><div class="dd-solution-products__content"><p>Recommended system / {{ forloop.index | prepend: '0' }}</p><h3>{{ block.settings.model_name }}</h3><h4>{{ block.settings.system_name }}</h4><dl><div><dt>Working Area</dt><dd>{{ block.settings.working_area }}</dd></div><div><dt>Typical Applications</dt><dd>{{ block.settings.applications }}</dd></div></dl><a href="{{ block.settings.link_url }}" data-track="cta" data-cta-id="co2_solution_view_system" data-section="solution_products">{{ block.settings.link_label }} <span aria-hidden="true">→</span></a></div></article>{% endfor %}</div></section>
{% stylesheet %}.dd-solution-products{background:#fff;color:#101317;font-family:'Archivo Narrow',sans-serif}.dd-solution-products__frame{width:min(100% - 64px,1240px);margin:auto;padding:112px 0}.dd-solution-products header{display:grid;grid-template-columns:1fr 2fr;gap:32px 64px;padding-bottom:52px;border-bottom:1px solid #c8cbcc}.dd-solution-products header p,.dd-solution-products__content>p{margin:0;color:#007f88;font-size:11px;font-weight:700;letter-spacing:.2em;text-transform:uppercase}.dd-solution-products h2{margin:0;font-size:clamp(38px,4.5vw,62px);line-height:1;text-transform:uppercase}.dd-solution-products article{display:grid;grid-template-columns:1.15fr 1fr;gap:58px;padding-top:48px}.dd-solution-products__media{aspect-ratio:4/3;overflow:hidden;background:#edf0f1}.dd-solution-products__media img{width:100%;height:100%;object-fit:contain}.dd-solution-products h3{margin:30px 0 4px;font-size:clamp(46px,6vw,78px);line-height:.9;text-transform:uppercase}.dd-solution-products h4{margin:14px 0 36px;font-size:20px;font-weight:500;text-transform:uppercase}.dd-solution-products dl{margin:0}.dd-solution-products dl div{display:grid;grid-template-columns:140px 1fr;padding:15px 0;border-top:1px solid #d0d3d4}.dd-solution-products dt{color:#007f88;font-size:10px;font-weight:700;letter-spacing:.14em;text-transform:uppercase}.dd-solution-products dd{margin:0;font-size:15px;line-height:1.5}.dd-solution-products a{display:inline-flex;align-items:center;gap:15px;min-height:48px;margin-top:28px;border-bottom:1px solid #00a3ad;color:#101317;font-size:11px;font-weight:700;letter-spacing:.13em;text-decoration:none;text-transform:uppercase}.dd-solution-products a:focus-visible{outline:2px solid #007f88;outline-offset:5px}@media(max-width:760px){.dd-solution-products__frame{width:min(100% - 40px,1240px);padding:80px 0}.dd-solution-products header,.dd-solution-products article{grid-template-columns:1fr}.dd-solution-products article{gap:28px}.dd-solution-products dl div{grid-template-columns:115px 1fr}}{% endstylesheet %}
{% schema %}{"name":"DD Solution Products","max_blocks":3,"settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"RECOMMENDED SYSTEMS / 07"},{"type":"text","id":"heading","label":"Heading","default":"Select the Machine Configuration Around the Production Requirement"}],"blocks":[{"type":"product","name":"Recommended machine","settings":[{"type":"text","id":"model_name","label":"Model name"},{"type":"text","id":"system_name","label":"System name"},{"type":"image_picker","id":"image","label":"Machine image"},{"type":"text","id":"image_alt","label":"Image alt text"},{"type":"text","id":"working_area","label":"Working area"},{"type":"text","id":"applications","label":"Typical applications"},{"type":"text","id":"link_label","label":"Link label","default":"VIEW SYSTEM DETAILS"},{"type":"url","id":"link_url","label":"Product link"}]}],"presets":[{"name":"DD Solution Products"}]}{% endschema %}
