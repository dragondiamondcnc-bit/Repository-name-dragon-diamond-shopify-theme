<section class="dd-information"><div class="dd-information__wrap"><h1>{{ page.title | escape }}</h1><div class="dd-information__body">{{ page.content }}</div></div></section><script type="application/ld+json">{"@context":"https://schema.org","@type":"WebPage","name":{{ page.title | json }},"url":{{ canonical_url | json }}}</script>{% stylesheet %}.dd-information{padding:145px 24px 75px;color:#17343b;background:#f1f6f5;font:18px/1.75 Arial,sans-serif}.dd-information__wrap{max-width:1000px;margin:auto}.dd-information h1{font-size:clamp(34px,4vw,52px);line-height:1.15;margin:0 0 36px}.dd-information h2{font-size:27px;line-height:1.3;margin:36px 0 15px}.dd-information p{margin:0 0 20px}.dd-information a{color:#087c83;text-underline-offset:4px}.dd-information li{margin-bottom:10px}.dd-information a:focus-visible{outline:3px solid #c9902d;outline-offset:4px}@media(max-width:749px){.dd-information{padding:120px 22px 50px;font-size:17px}.dd-information h2{font-size:25px}}{% endstylesheet %}{% schema %}{"name":"Company and application","settings":[]}{% endschema %}