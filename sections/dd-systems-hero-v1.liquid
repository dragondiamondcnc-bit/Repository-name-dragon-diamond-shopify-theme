<section class="dd-systems-hero" aria-labelledby="DDSystemsHeroHeading-{{ section.id }}">
  <div class="dd-systems-hero__media" aria-hidden="true">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 2200 | image_tag: class: 'dd-systems-hero__image', loading: 'eager', widths: '960, 1440, 1800, 2200', sizes: '100vw' }}
    {% else %}
      <img class="dd-systems-hero__image" src="{{ 'hero-v22-final-industrial-frame.png' | asset_url }}" alt="" width="1672" height="941" loading="eager">
    {% endif %}
  </div>
  <div class="dd-systems-hero__frame">
    <div class="dd-systems-hero__content">
      <p class="dd-systems-hero__eyebrow">{{ section.settings.eyebrow }}</p>
      <h1 id="DDSystemsHeroHeading-{{ section.id }}">{{ section.settings.heading }}</h1>
      <p class="dd-systems-hero__description">{{ section.settings.description }}</p>
      <div class="dd-systems-hero__index" aria-label="Production system categories">
        <span>01 / Cutting</span><span>02 / Routing</span><span>03 / Printing</span><span>04 / Processing</span>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .dd-systems-hero { position: relative; min-height: 720px; overflow: hidden; background: #07090c; color: #fff; font-family: 'Archivo Narrow', sans-serif; }
  .dd-systems-hero__media { position: absolute; inset: 0; }
  .dd-systems-hero__media::after { content: ''; position: absolute; inset: 0; background: rgba(7,9,12,.68); }
  .dd-systems-hero__image { width: 100%; height: 100%; object-fit: cover; object-position: center; filter: grayscale(35%) contrast(1.08); }
  .dd-systems-hero__frame { position: relative; z-index: 1; display: grid; align-items: end; width: min(100% - 64px, 1240px); min-height: 720px; margin: 0 auto; padding: 180px 0 80px; box-sizing: border-box; }
  .dd-systems-hero__content { max-width: 760px; border-left: 1px solid rgba(255,255,255,.28); padding-left: 40px; }
  .dd-systems-hero__eyebrow { margin: 0 0 28px; color: #00a3ad; font-size: 12px; font-weight: 700; letter-spacing: .28em; text-transform: uppercase; }
  .dd-systems-hero h1 { max-width: 16ch; margin: 0; font-size: clamp(48px, 6vw, 82px); font-weight: 700; line-height: .96; letter-spacing: -.035em; text-transform: uppercase; }
  .dd-systems-hero__description { max-width: 620px; margin: 32px 0 0; color: rgba(255,255,255,.76); font-size: 19px; line-height: 1.6; }
  .dd-systems-hero__index { display: flex; flex-wrap: wrap; gap: 12px 32px; margin-top: 48px; padding-top: 22px; border-top: 1px solid rgba(255,255,255,.18); font-size: 11px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
  @media (max-width: 760px) {
    .dd-systems-hero, .dd-systems-hero__frame { min-height: 640px; }
    .dd-systems-hero__frame { width: min(100% - 40px, 1240px); padding: 140px 0 56px; }
    .dd-systems-hero__content { padding-left: 20px; }
    .dd-systems-hero h1 { font-size: clamp(40px, 12vw, 58px); }
    .dd-systems-hero__description { font-size: 16px; }
    .dd-systems-hero__media::after { background: rgba(7,9,12,.76); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "DD Systems Hero V1",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "PRODUCTION SYSTEMS" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Engineering Solutions For Sign & Industrial Fabrication" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Select a production system around your materials, applications and output requirements." },
    { "type": "image_picker", "id": "image", "label": "Documentary production image" }
  ],
  "presets": [{ "name": "DD Systems Hero V1" }]
}
{% endschema %}
