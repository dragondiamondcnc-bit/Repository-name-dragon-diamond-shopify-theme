{% javascript %}
function initMarkselectFeedback(){document.querySelectorAll('[data-markselect-dialog]').forEach(dialog=>{if(dialog.dataset.ready)return;dialog.dataset.ready='true';const status=dialog.closest('form').querySelector('[data-markselect-success]');dialog.querySelector('[data-markselect-close]').addEventListener('click',()=>dialog.close());dialog.addEventListener('close',()=>status.focus());if(typeof dialog.showModal==='function')dialog.showModal();else status.focus();});}
initMarkselectFeedback();document.addEventListener('shopify:section:load',initMarkselectFeedback);
{% endjavascript %}
{% schema %}{"name":"B2B marking collection","settings":[],"presets":[{"name":"B2B marking collection"}]}{% endschema %}