{% if collection.handle == 'laser-marking' %}{% liquid
assign form_id = 'MarkselectInquiry-' | append: section.id
assign machine_names = 'LZ-T5 Fiber Laser Marking,LZ-RF CO2 Laser Marking,LZ-UV UV Laser Marking' | split: ','
%}<div class="dd-markselect"><section class="dd-markselect__hero"><div class="dd-markselect__wrap"><nav class="dd-markselect__crumb" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a><span>/</span><span>Laser Marking Machines</span></nav><p class="dd-markselect__eyebrow">CHOOSE BY MATERIAL &amp; MARKING RESULT</p><h1>Fiber, CO2 &amp; UV Laser Marking Machines</h1><p class="dd-markselect__lead">Find a marking setup for metal parts, personalized gifts and non-metal products. Compare materials, power options and sample results before confirming your equipment.</p><div class="dd-markselect__actions"><a class="dd-markselect__button" href="#MarkselectMachines">Compare the Machines</a><a href="#MarkselectContact">Request a Free Sample Test →</a></div></div></section>
<section class="dd-markselect__section" id="MarkselectMachines"><div class="dd-markselect__wrap"><h2>Three marking technologies, different production needs</h2><div class="dd-markselect__grid marking-models">{% assign machine = all_products['lz-t5-desktop-fiber-laser-marking-machine'] %}<article class="dd-markselect__card"><a href="{{ machine.url }}">{{ machine.featured_image | image_url: width: 800 | image_tag: widths: '360,600,800', sizes: '(min-width:900px) 30vw, 100vw', loading: 'lazy', alt: machine.featured_image.alt }}</a><div class="dd-markselect__body"><p class="marking-type">Fiber LASER MARKING</p><h3>LZ-T5</h3><p><strong>20W / 30W / 50W</strong></p><p>Metal parts, personalized metal gifts and product identification.</p><p class="dd-markselect__note">Confirm the metal, coating, marking size and required finish.</p><a class="dd-markselect__button" href="{{ machine.url }}">View Machine &amp; Get a Quote</a><a class="marking-browse" href="{{ routes.collections_url }}/fiber-laser-marking">Browse Fiber Marking →</a></div></article>{% assign machine = all_products['lz-rf-35w-co2-laser-marking-machine'] %}<article class="dd-markselect__card"><a href="{{ machine.url }}">{{ machine.featured_image | image_url: width: 800 | image_tag: widths: '360,600,800', sizes: '(min-width:900px) 30vw, 100vw', loading: 'lazy', alt: machine.featured_image.alt }}</a><div class="dd-markselect__body"><p class="marking-type">CO2 LASER MARKING</p><h3>LZ-RF</h3><p><strong>30W–60W</strong></p><p>Wood, bamboo, leather, acrylic and other suitable non-metal products.</p><p class="dd-markselect__note">Match the material and artwork to the power and marking lens.</p><a class="dd-markselect__button" href="{{ machine.url }}">View Machine &amp; Get a Quote</a><a class="marking-browse" href="{{ routes.collections_url }}/co2-laser-marking">Browse CO2 Marking →</a></div></article>{% assign machine = all_products['lz-uv-laser-marking-machine'] %}<article class="dd-markselect__card"><a href="{{ machine.url }}">{{ machine.featured_image | image_url: width: 800 | image_tag: widths: '360,600,800', sizes: '(min-width:900px) 30vw, 100vw', loading: 'lazy', alt: machine.featured_image.alt }}</a><div class="dd-markselect__body"><p class="marking-type">UV LASER MARKING</p><h3>LZ-UV</h3><p><strong>3W / 5W / 10W</strong></p><p>Metal and non-metal materials, including wood, leather, plastics, glass and stainless steel.</p><p class="dd-markselect__note">Test each material and finish; one setup does not guarantee the same result on every product.</p><a class="dd-markselect__button" href="{{ machine.url }}">View Machine &amp; Get a Quote</a><a class="marking-browse" href="{{ routes.collections_url }}/uv-laser-marking">Browse UV Marking →</a></div></article></div></div></section>
<section class="dd-markselect__section dd-markselect__tint"><div class="dd-markselect__wrap"><h2>Compare material and configuration priorities</h2><div class="dd-markselect__compare" tabindex="0" role="region" aria-label="Laser marking comparison. Scroll horizontally on small screens."><table><caption>Starting points for sample testing</caption><thead><tr><th scope="col">Selection point</th><th scope="col">Fiber · LZ-T5</th><th scope="col">CO2 · LZ-RF</th><th scope="col">UV · LZ-UV</th></tr></thead><tbody><tr><th scope="row">Material focus</th><td>Metal parts and gifts</td><td>Suitable non-metal products</td><td>Metal and non-metal products</td></tr><tr><th scope="row">Examples to evaluate</th><td>Metal components, tags and personalized accessories</td><td>Wood, bamboo, leather and acrylic</td><td>Wood, leather, plastics, glass and stainless steel</td></tr><tr><th scope="row">Power options</th><td>20W / 30W / 50W</td><td>30W–60W</td><td>3W / 5W / 10W</td></tr><tr><th scope="row">Confirm before ordering</th><td>Metal and surface finish</td><td>Material composition and desired contrast</td><td>Result on every intended material</td></tr><tr><th scope="row">For all three</th><td colspan="3">Marking size, artwork, lens, workholding, curved-part accessories and required output</td></tr></tbody></table></div><p class="dd-markselect__note">Power ratings across different laser technologies are not a direct ranking of suitability. Final configuration and included accessories are stated in your quotation.</p></div></section>
<section class="dd-markselect__section"><div class="dd-markselect__wrap"><h2>Explore marking samples</h2><div class="dd-markselect__grid marking-samples"><figure class="dd-markselect__card"><img src="{{ 'marking-fiber-pet-tags.png' | asset_img_url: '800x' }}" width="1448" height="1086" loading="lazy" alt="Personalized metal pet tags with names and decorative markings"><figcaption>Fiber · personalized metal pet tags</figcaption></figure><figure class="dd-markselect__card"><img src="{{ 'marking-co2-leather-bag.png' | asset_img_url: '800x' }}" width="1448" height="1086" loading="lazy" alt="Brown leather bag with a floral monogram marking"><figcaption>CO2 · personalized leather</figcaption></figure><figure class="dd-markselect__card"><img src="{{ 'marking-uv-glass-bottle.png' | asset_img_url: '800x' }}" width="1448" height="1086" loading="lazy" alt="Blue glass perfume bottle with lettering and a leaf design"><figcaption>UV · personalized glass</figcaption></figure></div><p class="dd-markselect__note">These are application samples. Confirm your own material and required finish through testing. Curved items may require a rotary attachment or fixture.</p><a href="{{ routes.root_url }}pages/industry-crafts">Explore Crafts &amp; Personalized Gifts →</a></div></section>
<section class="dd-markselect__section dd-markselect__tint"><div class="dd-markselect__wrap dd-markselect__split"><div><h2>Confirm the result before choosing equipment</h2><p>Share your material, surface finish, artwork and marking size. We review the job and sample results, then recommend the laser technology, power and accessories.</p><p>English manuals and videos, remote installation training, equipment-specific spare parts and technical support are available. On-site support can be arranged. Delivery timing is agreed for each order.</p><a class="dd-markselect__button" href="#MarkselectContact">Request a Free Sample Test</a></div><div class="dd-markselect__faq"><h2>Laser Marking Selection Questions</h2><details><summary>Which laser marking technology should I start with?</summary><p>Start with your material and the marking result you need. Evaluate fiber for metal products, CO2 for suitable non-metal materials, and UV for mixed metal and non-metal applications. A sample test helps confirm the choice.</p></details><details><summary>Can UV mark both metal and non-metal products?</summary><p>Yes. Evaluate UV marking for wood, leather, plastics, glass and stainless steel. The surface treatment, composition, artwork and required appearance still need to be tested on your actual material.</p></details><details><summary>What power options are available for CO2 marking?</summary><p>The LZ-RF CO2 marking series offers 30W–60W configurations. The final power and marking lens are selected around your material and production requirements.</p></details><details><summary>Can I mark cups, pens or curved parts?</summary><p>Curved items may require a rotary attachment or a fixture. Send the dimensions, marking position and artwork so we can confirm the required accessories; do not assume they are included.</p></details><details><summary>What do you need for a free sample test?</summary><p>Send the material specification, surface finish, artwork, marking dimensions and output target. We will confirm test arrangements and the proposed configuration. Any sample shipping is agreed separately.</p></details></div></div></section>  <section class="dd-markselect__section" id="MarkselectContact"><div class="dd-markselect__wrap dd-markselect__split"><div><p class="dd-markselect__eyebrow">TELL US WHAT YOU WANT TO MAKE</p><h2>Get an equipment proposal for your laser marking application</h2><p>Share your material, thickness, finished size and production requirements. We will help you plan the equipment and a free sample test.</p><p><a href="mailto:info@gzcnc-laser.com">info@gzcnc-laser.com</a><br><a href="https://wa.me/8618988946615">WhatsApp: +86 189 8894 6615</a></p><p class="dd-markselect__note">Need to share artwork or photos? Send them by email or WhatsApp. Name, email and message are required.</p></div>
    {% form 'contact', id: form_id %}
      <input type="hidden" name="contact[Source]" value="Laser marking machine category">
      {% if form.posted_successfully? %}<div class="dd-markselect__success" role="status" tabindex="-1" data-markselect-success><strong>Thank you — your inquiry has been sent.</strong><p>Our team will review your requirements and contact you by email. You do not need to submit the same inquiry again.</p></div><dialog data-markselect-dialog aria-labelledby="MarkselectSuccessTitle"><h2 id="MarkselectSuccessTitle">Inquiry sent successfully</h2><p>Thank you for contacting Dragon Diamond. Our team will review your requirements and contact you by email.</p><button type="button" class="dd-markselect__button" data-markselect-close>Got it</button></dialog>{% endif %}
      {% if form.errors %}<div role="alert">{{ form.errors | default_errors }}</div>{% endif %}
      <div class="dd-markselect__fields"><div><label for="MarkselectName-{{ section.id }}">Name *</label><input id="MarkselectName-{{ section.id }}" name="contact[name]" autocomplete="name" value="{{ form.name | escape }}" required></div><div><label for="MarkselectEmail-{{ section.id }}">Email *</label><input id="MarkselectEmail-{{ section.id }}" name="contact[email]" type="email" autocomplete="email" value="{{ form.email | escape }}" required></div><div><label for="MarkselectCompany-{{ section.id }}">Company</label><input id="MarkselectCompany-{{ section.id }}" name="contact[Company]" autocomplete="organization" value="{{ form.Company | escape }}"></div><div><label for="MarkselectWA-{{ section.id }}">WhatsApp</label><input id="MarkselectWA-{{ section.id }}" name="contact[WhatsApp]" type="tel" autocomplete="tel" value="{{ form.WhatsApp | escape }}"></div></div>
      <label for="MarkselectProduct-{{ section.id }}">Product Interested</label><select id="MarkselectProduct-{{ section.id }}" name="contact[Product Interested]"><option>Laser marking selection / need advice</option>{% for name in machine_names %}<option>{{ name }}</option>{% endfor %}<option>Other marking requirements</option></select>
      <label for="MarkselectMessage-{{ section.id }}">Message *</label><textarea id="MarkselectMessage-{{ section.id }}" name="contact[body]" rows="5" placeholder="Material, thickness, finished size, production needs and destination country..." required>{{ form.body | escape }}</textarea><button type="submit" class="dd-markselect__button">Send Inquiry</button>
    {% endform %}
  </div></section></div>{% else %}<div class="dd-marking-category"><div class="dd-marking-category__wrap"><nav aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a> / {% if collection.handle != 'laser-marking' %}<a href="{{ routes.collections_url }}/laser-marking">Laser Marking Machines</a> / {% endif %}<span>{{ collection.title | escape }}</span></nav><h1>{{ collection.title | escape }}</h1><div class="rte">{{ collection.description }}</div><nav class="dd-marking-category__types" aria-label="Marking technologies"><a href="{{ routes.collections_url }}/laser-marking">All Laser Marking Machines</a><a href="{{ routes.collections_url }}/fiber-laser-marking">Fiber Laser Marking</a><a href="{{ routes.collections_url }}/co2-laser-marking">CO2 Laser Marking</a><a href="{{ routes.collections_url }}/uv-laser-marking">UV Laser Marking</a></nav>{% paginate collection.products by 12 %}<div class="dd-marking-category__grid">{% for product in collection.products %}<article><a href="{{ product.url }}">{% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'eager', widths: '400, 600, 900', sizes: '(min-width: 900px) 33vw, 100vw', alt: product.featured_image.alt }}{% endif %}<h2>{{ product.title | escape }}</h2></a><p>{{ product.description | split: '</p>' | first | strip_html }}</p><a class="dd-marking-category__button" href="{{ product.url }}">View Product &amp; Get a Quote</a></article>{% endfor %}</div>{{ paginate | default_pagination }}{% endpaginate %}<aside><h2>Find the Right Marking Solution</h2><p>Send your material, artwork, marking size and production requirements. We provide free sample testing and help select the appropriate configuration.</p><a class="dd-marking-category__button" href="https://wa.me/8618988946615">Discuss Your Application</a><p><a href="mailto:info@gzcnc-laser.com">info@gzcnc-laser.com</a></p></aside></div></div>
{% endif %}<script type="application/ld+json">{"@context":"https://schema.org","@type":"CollectionPage","name":{{ collection.title | json }},"url":{{ canonical_url | json }},"description":{{ collection.description | strip_html | json }}}</script>
<script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":{{ request.origin | json }}},{"@type":"ListItem","position":2,"name":"Laser Marking Machines","item":{{ request.origin | append: '/collections/laser-marking' | json }}}{% if collection.handle != 'laser-marking' %},{"@type":"ListItem","position":3,"name":{{ collection.title | json }},"item":{{ canonical_url | json }}}{% endif %}]}</script>
