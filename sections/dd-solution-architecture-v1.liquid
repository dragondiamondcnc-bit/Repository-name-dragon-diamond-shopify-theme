<section class="dd-solution-architecture" aria-labelledby="DDSolutionArchitecture-{{ section.id }}"><div class="dd-solution-architecture__frame"><header><p>{{ section.settings.eyebrow }}</p><h2 id="DDSolutionArchitecture-{{ section.id }}">{{ section.settings.heading }}</h2></header><ol class="dd-solution-architecture__steps">{% for block in section.blocks %}<li {{ block.shopify_attributes }}><span>{{ forloop.index | prepend: '0' }}</span><small>{% if forloop.index <= 2 %}Input{% elsif forloop.index == 3 %}System Process{% else %}Output{% endif %}</small><strong>{{ block.settings.title }}</strong><p>{{ block.settings.description }}</p></li>{% endfor %}</ol></div></section>
{% stylesheet %}.dd-solution-architecture{background:#0f1115;color:#fff;font-family:'Archivo Narrow',sans-serif}.dd-solution-architecture__frame{width:min(100% - 64px,1240px);margin:auto;padding:112px 0}.dd-solution-architecture header{display:grid;grid-template-columns:1fr 2fr;gap:32px 64px;padding-bottom:54px}.dd-solution-architecture header p{margin:0;color:#00a3ad;font-size:11px;font-weight:700;letter-spacing:.22em;text-transform:uppercase}.dd-solution-architecture h2{margin:0;font-size:clamp(38px,4.5vw,62px);line-height:1;text-transform:uppercase}.dd-solution-architecture__steps{display:grid;grid-template-columns:repeat(4,1fr);margin:0;padding:0;border-top:1px solid rgba(255,255,255,.2);border-bottom:1px solid rgba(255,255,255,.2);list-style:none}.dd-solution-architecture__steps li{min-height:210px;padding:28px 20px;border-right:1px solid rgba(255,255,255,.14)}.dd-solution-architecture__steps li:last-child{border:0}.dd-solution-architecture__steps span{display:block;color:#00a3ad;font-size:28px}.dd-solution-architecture__steps small{display:block;margin-top:34px;color:rgba(255,255,255,.42);font-size:9px;font-weight:700;letter-spacing:.17em;text-transform:uppercase}.dd-solution-architecture__steps strong{display:block;margin-top:10px;font-size:17px;line-height:1.2;text-transform:uppercase}.dd-solution-architecture__steps p{margin:14px 0 0;color:rgba(255,255,255,.7);font-size:14px;line-height:1.5}@media(max-width:760px){.dd-solution-architecture__frame{width:min(100% - 40px,1240px);padding:80px 0}.dd-solution-architecture header{grid-template-columns:1fr}.dd-solution-architecture__steps{grid-template-columns:1fr}.dd-solution-architecture__steps li{display:grid;grid-template-columns:56px 1fr;align-items:start;min-height:0;padding:22px 0;border-right:0;border-bottom:1px solid rgba(255,255,255,.14)}.dd-solution-architecture__steps small,.dd-solution-architecture__steps strong,.dd-solution-architecture__steps p{grid-column:2;margin-top:0}.dd-solution-architecture__steps strong{margin-top:7px}.dd-solution-architecture__steps p{margin-top:10px}}{% endstylesheet %}
{% schema %}{"name":"DD Solution Architecture","max_blocks":4,"settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"PROCESS ARCHITECTURE / 02"},{"type":"text","id":"heading","label":"Heading","default":"From Digital File to Finished Component"}],"blocks":[{"type":"step","name":"Architecture stage","settings":[{"type":"text","id":"title","label":"Title"},{"type":"textarea","id":"description","label":"Supporting meaning"}]}],"presets":[{"name":"DD Solution Architecture"}]}{% endschema %}
