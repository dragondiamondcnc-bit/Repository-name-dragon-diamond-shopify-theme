      <div class="dd-caseview__fields"><div><label for="CaseviewName-{{ section.id }}">Name *</label><input id="CaseviewName-{{ section.id }}" name="contact[name]" autocomplete="name" value="{{ form.name | escape }}" required></div><div><label for="CaseviewEmail-{{ section.id }}">Email *</label><input id="CaseviewEmail-{{ section.id }}" name="contact[email]" type="email" autocomplete="email" value="{{ form.email | escape }}" required></div><div><label for="CaseviewCompany-{{ section.id }}">Company</label><input id="CaseviewCompany-{{ section.id }}" name="contact[Company]" autocomplete="organization" value="{{ form.Company | escape }}"></div><div><label for="CaseviewWA-{{ section.id }}">WhatsApp</label><input id="CaseviewWA-{{ section.id }}" name="contact[WhatsApp]" type="tel" autocomplete="tel" value="{{ form.WhatsApp | escape }}"></div></div>
      <label for="CaseviewProduct-{{ section.id }}">Product Interested</label><select id="CaseviewProduct-{{ section.id }}" name="contact[Product Interested]"><option>Similar project / need advice</option>{% for name in machine_names %}<option>{{ name }}</option>{% endfor %}<option>Other production requirements</option></select>
      <label for="CaseviewMessage-{{ section.id }}">Message *</label><textarea id="CaseviewMessage-{{ section.id }}" name="contact[body]" rows="5" placeholder="Material, part size, application, equipment requirements and destination country..." required>{{ form.body | escape }}</textarea><button type="submit" class="dd-caseview__button">Send Inquiry</button>
    {% endform %}
  </div></section></div>
