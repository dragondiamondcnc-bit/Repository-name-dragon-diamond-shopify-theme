<section class="dd-solution-requirements" aria-labelledby="DDSolutionRequirements-{{ section.id }}"><div class="dd-solution-requirements__frame"><header><p>{{ section.settings.eyebrow }}</p><h2 id="DDSolutionRequirements-{{ section.id }}">{{ section.settings.heading }}</h2></header><div class="dd-solution-requirements__grid">{% for block in section.blocks %}<article {{ block.shopify_attributes }}><strong>{{ forloop.index | prepend: '0' }}</strong><h3>{{ block.settings.title }}</h3><p>{{ block.settings.description }}</p></article>{% endfor %}</div></div></section>
{% stylesheet %}.dd-solution-requirements{background:#f1f2f2;color:#101317;font-family:'Archivo Narrow',sans-serif}.dd-solution-requirements__frame{width:min(100% - 64px,1240px);margin:auto;padding:110px 0}.dd-solution-requirements header{display:grid;grid-template-columns:1fr 2fr;gap:32px 64px;padding-bottom:52px}.dd-solution-requirements header p{margin:0;color:#007f88;font-size:11px;font-weight:700;letter-spacing:.22em;text-transform:uppercase}.dd-solution-requirements h2{max-width:18ch;margin:0;font-size:clamp(38px,4.5vw,62px);line-height:1;text-transform:uppercase}.dd-solution-requirements__grid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid #aeb2b4}.dd-solution-requirements article{min-width:0;padding:30px 24px 10px;border-right:1px solid #c8cbcc}.dd-solution-requirements article:first-child{padding-left:0}.dd-solution-requirements article:last-child{border:0}.dd-solution-requirements article>strong{color:#00a3ad;font-size:30px}.dd-solution-requirements h3{margin:44px 0 14px;font-size:21px;line-height:1.1;text-transform:uppercase}.dd-solution-requirements article p{margin:0;color:#545b60;font-family:Arial,sans-serif;font-size:14px;line-height:1.6}@media(max-width:760px){.dd-solution-requirements__frame{width:min(100% - 40px,1240px);padding:80px 0}.dd-solution-requirements header{grid-template-columns:1fr}.dd-solution-requirements__grid{grid-template-columns:1fr}.dd-solution-requirements article,.dd-solution-requirements article:first-child{padding:24px 0;border-right:0;border-bottom:1px solid #c8cbcc}.dd-solution-requirements h3{margin:20px 0 10px}}{% endstylesheet %}
{% schema %}{"name":"DD Solution Requirements","max_blocks":4,"settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"PRODUCTION REQUIREMENTS / 01"},{"type":"text","id":"heading","label":"Heading","default":"Built Around Real Fabrication Requirements"}],"blocks":[{"type":"requirement","name":"Requirement","settings":[{"type":"text","id":"title","label":"Title"},{"type":"textarea","id":"description","label":"Description"}]}],"presets":[{"name":"DD Solution Requirements"}]}{% endschema %}
