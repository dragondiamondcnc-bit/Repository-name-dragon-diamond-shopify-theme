<section class="dd-solution-workflow" aria-labelledby="DDSolutionWorkflow-{{ section.id }}"><div class="dd-solution-workflow__frame"><header><p>{{ section.settings.eyebrow }}</p><h2 id="DDSolutionWorkflow-{{ section.id }}">{{ section.settings.heading }}</h2></header>{% if section.settings.image != blank %}<div class="dd-solution-workflow__media">{{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '750, 1100, 1500, 1800', sizes: '(min-width: 761px) 60vw, 100vw', alt: section.settings.image_alt }}</div>{% endif %}<ol>{% for block in section.blocks %}<li {{ block.shopify_attributes }}><span>{{ forloop.index | prepend: '0' }}</span><div><h3>{{ block.settings.title }}</h3><p>{{ block.settings.description }}</p></div></li>{% endfor %}</ol></div></section>
{% stylesheet %}.dd-solution-workflow{background:#0f1115;color:#fff;font-family:'Archivo Narrow',sans-serif}.dd-solution-workflow__frame{width:min(100% - 64px,1240px);margin:auto;padding:112px 0}.dd-solution-workflow header{display:grid;grid-template-columns:1fr 2fr;gap:32px 64px;padding-bottom:52px}.dd-solution-workflow header p{margin:0;color:#00a3ad;font-size:11px;font-weight:700;letter-spacing:.22em;text-transform:uppercase}.dd-solution-workflow h2{margin:0;font-size:clamp(38px,4.5vw,62px);line-height:1;text-transform:uppercase}.dd-solution-workflow__media{aspect-ratio:21/8;margin-bottom:44px;overflow:hidden;background:#15191e}.dd-solution-workflow__media img{width:100%;height:100%;object-fit:cover}.dd-solution-workflow ol{display:grid;grid-template-columns:repeat(5,1fr);margin:0;padding:0;border-top:1px solid rgba(255,255,255,.18);list-style:none}.dd-solution-workflow li{padding:27px 18px;border-right:1px solid rgba(255,255,255,.13)}.dd-solution-workflow li:last-child{border:0}.dd-solution-workflow li>span{color:#00a3ad;font-size:25px}.dd-solution-workflow h3{margin:42px 0 10px;font-size:16px;text-transform:uppercase}.dd-solution-workflow li p{margin:0;color:rgba(255,255,255,.62);font-size:14px;line-height:1.5}@media(max-width:760px){.dd-solution-workflow__frame{width:min(100% - 40px,1240px);padding:80px 0}.dd-solution-workflow header{grid-template-columns:1fr}.dd-solution-workflow__media{aspect-ratio:16/10}.dd-solution-workflow ol{grid-template-columns:1fr}.dd-solution-workflow li{display:grid;grid-template-columns:52px 1fr;padding:22px 0;border-right:0;border-bottom:1px solid rgba(255,255,255,.13)}.dd-solution-workflow h3{margin:0 0 7px}}{% endstylesheet %}
{% schema %}{"name":"DD Solution Workflow","max_blocks":5,"settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"WORKFLOW INTEGRATION / 05"},{"type":"text","id":"heading","label":"Heading","default":"How CO₂ Laser Cutting Fits Into Production"},{"type":"image_picker","id":"image","label":"Production workflow image"},{"type":"text","id":"image_alt","label":"Image alt text","default":"CO₂ laser production workflow"}],"blocks":[{"type":"step","name":"Workflow step","settings":[{"type":"text","id":"title","label":"Title"},{"type":"text","id":"description","label":"Description"}]}],"presets":[{"name":"DD Solution Workflow"}]}{% endschema %}
