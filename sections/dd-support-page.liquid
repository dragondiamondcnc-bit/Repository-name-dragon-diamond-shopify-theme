      <label for="SupportMessage-{{ section.id }}">{{ 'dd_support.text_13' | t }}</label><textarea id="SupportMessage-{{ section.id }}" name="contact[body]" rows="5" placeholder="{{ 'dd_support.text_15' | t }}" required>{{ form.body | escape }}</textarea><button type="submit" class="dd-help__button">{{ 'dd_support.text_14' | t }}</button>
    {% endform %}</div></div></section></div><script type="application/ld+json">{"@context":"https://schema.org","@type":"WebPage","name":{{ 'dd_support.title' | t | json }},"url":{{ canonical_url | json }}}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":{{ request.origin | json }}},{"@type":"ListItem","position":2,"name":{{ 'dd_support.title' | t | json }},"item":{{ canonical_url | json }}}]}</script>{% stylesheet %}.dd-help{color:#17343b;font:17px/1.7 Arial,sans-serif}.dd-help *{box-sizing:border-box}.dd-help__wrap{max-width:1240px;margin:auto;padding:0 24px}.dd-help__hero{padding:150px 0 56px;background:#15383d;color:white}.dd-help h1{font-size:clamp(34px,4vw,54px);line-height:1.12;margin:12px 0 22px}.dd-help h2{font-size:32px;line-height:1.2;margin:0 0 22px}.dd-help h3{font-size:22px;line-height:1.35}.dd-help p{margin:0 0 20px}.dd-help a{color:#087c83;text-underline-offset:4px}.dd-help__hero a{color:#7bdfd6}.dd-help__eyebrow{font-size:13px;font-weight:bold;letter-spacing:2px;color:#087c83}.dd-help__hero .dd-help__eyebrow{color:#7bdfd6}.dd-help__lead{max-width:850px;font-size:20px}.dd-help__section{padding:60px 0}.dd-help__tint{background:#eef5f4}.dd-help__split{display:grid;grid-template-columns:1fr 1.2fr;gap:54px}.dd-help__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}.dd-help__panel{border:1px solid #d2e1df;padding:24px;border-radius:9px}.dd-help__button{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:12px 22px;background:#087c83;color:white!important;border:0;border-radius:5px;font:700 16px Arial;cursor:pointer;text-decoration:none}.dd-help__actions,.help-jump{display:flex;flex-wrap:wrap;gap:14px 24px;align-items:center}.help-jump{padding:25px 0}.help-jump a{padding:8px 0;font-weight:bold}.help-faq{max-width:950px}.help-faq details{border-bottom:1px solid #cbdcd9}.help-faq summary{padding:20px 5px;cursor:pointer;font-weight:bold}.help-faq summary{display:flex;justify-content:space-between;gap:20px}.help-faq summary::after{content:"+";font-size:22px;color:#087c83}.help-faq details[open] summary::after{content:"−"}.help-faq details p{padding:0 5px 15px}.dd-help [id]{scroll-margin-top:110px}.dd-help__note{font-size:14px;color:#4c666b}.dd-help form label{display:block;font-size:14px;font-weight:bold;margin:16px 0 6px}.dd-help input,.dd-help select,.dd-help textarea{width:100%;padding:12px;border:1px solid #9db6b6;border-radius:4px;background:white;font:16px Arial;color:#17343b}.dd-help textarea{resize:vertical}.dd-help__fields{display:grid;grid-template-columns:1fr 1fr;gap:0 18px}.dd-help form button{margin-top:20px}.dd-help__success{padding:22px;background:#e1f4ea;border:1px solid #32825c;margin-bottom:22px}.dd-help dialog{max-width:520px;width:calc(100% - 40px);padding:30px;border:0;border-radius:12px;color:#17343b}.dd-help dialog::backdrop{background:#10272daa}.dd-help a:focus-visible,.dd-help button:focus-visible,.dd-help summary:focus-visible{outline:3px solid #dca038;outline-offset:4px}.dd-help__panel a{overflow-wrap:anywhere}@media(max-width:749px){.dd-help__hero{padding-top:125px}.dd-help__section{padding:40px 0}.dd-help__split,.dd-help__grid{grid-template-columns:1fr;gap:28px}.dd-help h2{font-size:28px}.dd-help__wrap{padding:0 22px}.dd-help__fields{grid-template-columns:1fr}.dd-help__lead{font-size:18px}}.dd-help li{margin:0 0 14px}.dd-help ol,.dd-help ul{padding-left:24px}.dd-help__panel h3{margin-top:0}{% endstylesheet %}{% javascript %}
function initCaseviewFeedback(){document.querySelectorAll('[data-help-dialog]').forEach(dialog=>{if(dialog.dataset.ready)return;dialog.dataset.ready='true';const status=dialog.closest('form').querySelector('[data-help-success]');dialog.querySelector('[data-help-close]').addEventListener('click',()=>dialog.close());dialog.addEventListener('close',()=>status.focus());if(typeof dialog.showModal==='function')dialog.showModal();else status.focus();});}
initCaseviewFeedback();document.addEventListener('shopify:section:load',initCaseviewFeedback);
