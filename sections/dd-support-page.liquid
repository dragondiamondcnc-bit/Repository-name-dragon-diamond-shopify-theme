      <input type="hidden" name="contact[Source]" value="Technical support page">
      {% if form.posted_successfully? %}<div class="dd-help__success" role="status" tabindex="-1" data-help-success><strong>{{ 'dd_support.text_1' | t }}</strong><p>{{ 'dd_support.text_2' | t }}</p></div><dialog data-help-dialog aria-labelledby="SupportSuccessTitle"><h2 id="SupportSuccessTitle">{{ 'dd_support.text_3' | t }}</h2><p>{{ 'dd_support.text_4' | t }}</p><button type="button" class="dd-help__button" data-help-close>{{ 'dd_support.text_5' | t }}</button></dialog>{% endif %}
