{% liquid
  assign form_id = 'SignageInquiry-' | append: section.id
  assign machine_handles = 'lz-1390-industrial-co2-laser-cutting-machine,lz-1325-cnc-router,lz-6090uv-uv-flatbed-printer' | split: ','
  assign machine_names = 'LZ-1390 CO2 Laser Cutter,LZ-1325 CNC Router,LZ-6090UV Flatbed Printer' | split: ','
  assign machine_images = 'lz-1390-cutout-v1.png,lz-1325-standard-cutout-v1.png,lz-6090uv-cutout-v2.png' | split: ','
%}
<div class="dd-signage" id="Signage-{{ section.id }}">
  <section class="dd-signage__hero">
    <div class="dd-signage__wrap">
      <nav class="dd-signage__crumb" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a><span>/</span><a href="{{ routes.root_url }}#HomeIndustries">Industries</a><span>/</span><span>Signage &amp; Advertising</span></nav>
      <div class="dd-signage__split">
        <div><p class="dd-signage__eyebrow">SIGNAGE &amp; ADVERTISING PRODUCTION</p><h1>Laser Cutting, CNC Routing &amp; UV Printing for Sign Makers</h1><p class="dd-signage__lead">Build a production setup around the signs you make. We help you select equipment for acrylic letters, routed sign panels and printed acrylic graphics—with sample testing before you confirm the solution.</p><div class="dd-signage__actions"><a class="dd-signage__button" href="#SignageContact">Get a Signage Solution</a><a href="#SignageSamples">Explore Processing Samples →</a></div><p class="dd-signage__note">CO2 &amp; CNC manufacturing · Equipment selection · Training &amp; technical support</p></div>
        <figure>{{ images['laser-sample-acrylic-letters.jpg'] | image_url: width: 1200 | image_tag: widths: '480,720,960,1200', sizes: '(min-width: 900px) 46vw, 100vw', loading: 'eager', fetchpriority: 'high', alt: 'Clear acrylic letters cut with a CO2 laser for sign making' }}<figcaption>Real acrylic cutting samples from our equipment demonstrations.</figcaption></figure>
      </div>
    </div>
  </section>
  <section class="dd-signage__section" id="SignageSamples"><div class="dd-signage__wrap">
    <p class="dd-signage__eyebrow">START WITH YOUR FINISHED PRODUCT</p><h2>What does your sign shop produce?</h2><p class="dd-signage__intro">Choose the process around your material, artwork and required finish. These are processing samples; customer projects are shown separately below.</p>
    <div class="dd-signage__grid">
      <article class="dd-signage__card"><figure>{{ images['laser-sample-acrylic-letters.jpg'] | image_url: width: 800 | image_tag: widths: '360,600,800', sizes: '(min-width: 900px) 30vw, 100vw', loading: 'lazy', alt: 'Transparent acrylic G letters showing laser-cut contours' }}</figure><div class="dd-signage__body"><h3>Acrylic letters &amp; logos</h3><p>Cut shapes and lettering from acrylic sheet. Review the edge finish and detail on your actual material before selecting the laser configuration.</p><a href="#SignageEquipment">Explore CO2 laser cutting →</a></div></article>
      <article class="dd-signage__card"><figure>{{ images['laser-sample-uv-acrylic-camera.jpg'] | image_url: width: 800 | image_tag: widths: '360,600,800', sizes: '(min-width: 900px) 30vw, 100vw', loading: 'lazy', alt: 'Camera-equipped CO2 laser processing acrylic printed with Dragon Diamond logos' }}</figure><div class="dd-signage__body"><h3>Printed acrylic graphics</h3><p>Combine UV flatbed printing with laser contour cutting. The demonstrated workflow requires the optional camera system on the laser cutter.</p><a href="#SignageWorkflow">See the print-and-cut workflow →</a></div></article>
      <article class="dd-signage__card"><figure>{{ images['cnc-sample-decorative-panel.png'] | image_url: width: 800 | image_tag: widths: '360,600,800', sizes: '(min-width: 900px) 30vw, 100vw', loading: 'lazy', alt: 'CNC-routed decorative wooden panel with intricate cut-out details' }}</figure><div class="dd-signage__body"><h3>Routed panels &amp; decorative parts</h3><p>Use CNC routing for profile cutting and engraved details in suitable sign and display boards. Match the cutter and workholding to the job.</p><a href="#SignageEquipment">Explore CNC routing →</a></div></article>
    </div>
  </div></section>
  <section class="dd-signage__section dd-signage__tint" id="SignageEquipment"><div class="dd-signage__wrap"><p class="dd-signage__eyebrow">SELECT EQUIPMENT BY PROCESS</p><h2>Three machines, different production roles</h2><p class="dd-signage__intro">Start with the process you need today. Add complementary equipment when your work requires it; you do not need all three machines for every sign.</p><div class="dd-signage__grid">
    {% for handle in machine_handles %}{% assign i = forloop.index0 %}{% assign machine_image = images[machine_images[i]] %}<article class="dd-signage__card dd-signage__machine"><a href="{{ routes.root_url }}products/{{ handle }}" aria-label="View {{ machine_names[i] | escape }}">{{ machine_image | image_url: width: 800 | image_tag: widths: '360,600,800', sizes: '(min-width: 900px) 30vw, 100vw', loading: 'lazy', alt: machine_names[i] }}</a><div class="dd-signage__body"><h3>{{ machine_names[i] }}</h3>{% case forloop.index %}{% when 1 %}<p>For acrylic profile cutting and suitable non-metal sign components.</p><ul><li>150W laser power</li><li>S&amp;A CW5200 chiller and blade table</li><li>Optional camera for printed-material contour cutting</li></ul>{% when 2 %}<p>For routed lettering, panels and decorative components.</p><ul><li>3.0 kW water-cooled spindle</li><li>Aluminum profile + PVC worktable</li><li>Optional vacuum table + vacuum pump</li></ul>{% when 3 %}<p>For applying graphics to suitable flat substrates before finishing or cutting.</p><ul><li>600 × 900 mm printing area</li><li>XP600 / I1600 / I3200 printhead options</li><li>Ink adhesion and final configuration confirmed by application</li></ul>{% endcase %}<a class="dd-signage__button" href="{{ routes.root_url }}products/{{ handle }}">View Machine &amp; Get a Quote</a></div></article>{% endfor %}
    </div><p class="dd-signage__note">Producing metal signs? Explore the <a href="{{ routes.root_url }}products/1530-fiber-laser-cutting-machine">LZ-1530F fiber laser cutter</a> for sheet metal and <a href="{{ routes.root_url }}products/lz-f-3-in-1-handheld-laser-welding-machine">handheld laser welding</a> for suitable joining tasks. Share your material and design for configuration advice.</p>
  </div></section>
  <section class="dd-signage__section" id="SignageWorkflow"><div class="dd-signage__wrap dd-signage__split"><div><p class="dd-signage__eyebrow">PRINT + CONTOUR CUT</p><h2>Turn printed acrylic into shaped sign components</h2><p>The UV printer applies the graphic. A CO2 laser with the optional camera then supports cutting around the printed design. These are separate machines with complementary roles.</p><p>We review artwork, print registration, sheet size and material thickness before recommending the equipment combination.</p><a class="dd-signage__button" href="#SignageContact">Request a Free Sample Test</a></div><ol class="dd-signage__steps"><li><h3>01 · Send your artwork and material details</h3><p>Include the finished dimensions, material thickness, printed design and expected output.</p></li><li><h3>02 · Confirm printing and camera configuration</h3><p>Check the printer setup and optional camera workflow against your job.</p></li><li><h3>03 · Test printing and contour cutting</h3><p>Review the printed appearance, alignment and cut finish on a sample.</p></li><li><h3>04 · Approve the result and equipment proposal</h3><p>Confirm the configuration and quotation after reviewing the sample result.</p></li></ol></div></section>
  <section class="dd-signage__section dd-signage__tint"><div class="dd-signage__wrap"><h2>What we check before recommending a machine</h2><div class="dd-signage__grid"><article class="dd-signage__panel"><h3>Material &amp; finish</h3><p>Exact material, thickness, surface coating, edge finish and whether the job needs cutting, engraving or printing.</p></article><article class="dd-signage__panel"><h3>Part size &amp; production needs</h3><p>Sheet size, largest finished part, batch quantities, design details and your existing equipment.</p></article><article class="dd-signage__panel"><h3>Configuration &amp; support</h3><p>Camera registration, workholding, utilities and operator training. Final equipment and delivery timing are agreed for the order.</p></article></div><p class="dd-signage__note">For PVC sign boards, discuss CNC routing with us. PVC must not be processed with a CO2 laser. Other materials and coatings also require suitability checks.</p></div></section>
  <section class="dd-signage__section"><div class="dd-signage__wrap"><p class="dd-signage__eyebrow">CUSTOMER PROJECTS</p><h2>See how other advertising businesses work with us</h2><div class="dd-signage__two">
    <article class="dd-signage__card"><img src="https://cdn.shopify.com/s/files/1/0824/6319/5356/files/dd-section04-uganda-signage-output.webp" alt="Signage output from the Uganda customer project" width="800" height="533" loading="lazy"><div class="dd-signage__body"><h3>Uganda · Sign Manufacturing</h3><p>An LZ-1390 CO2 laser project for acrylic signs and advertising components, with factory consultation and customer production examples.</p><a href="{{ routes.root_url }}pages/case-uganda-sign-factory">Read the Uganda project →</a></div></article>
    <article class="dd-signage__card"><img src="https://cdn.shopify.com/s/files/1/0824/6319/5356/files/dd-section04-ethiopia-machine-testing.webp" alt="Machine testing for the Ethiopia advertising production project" width="800" height="533" loading="lazy"><div class="dd-signage__body"><h3>Ethiopia · Equipment Evaluation &amp; Training</h3><p>A laser and CNC equipment project for an advertising business, covering equipment evaluation, training and delivery.</p><a href="{{ routes.root_url }}pages/case-study-ethiopia">Read the Ethiopia project →</a></div></article>
    </div><p class="dd-signage__note">These projects show customer-specific configurations. Your proposal will be based on your own production requirements.</p></div></section>
  <section class="dd-signage__section dd-signage__tint"><div class="dd-signage__wrap dd-signage__split"><div><p class="dd-signage__eyebrow">FROM SAMPLE TO PRODUCTION</p><h2>Equipment advice backed by practical support</h2><p>Guangzhou Dragon Diamond Technology Co., Ltd. was established in 2012. We manufacture CO2 laser cutters and CNC routers in Guangzhou and coordinate complementary equipment for your production needs.</p><p>Support includes English manuals and videos, remote installation training, technical assistance and equipment-specific spare parts. On-site training and support can be arranged according to the project.</p><a href="{{ routes.root_url }}#HomeFactory">Explore Our Factory &amp; Team →</a></div><div class="dd-signage__faq"><h2>Sign-making equipment FAQ</h2>
    <details><summary>Should I choose a CO2 laser or a CNC router?</summary><p>Choose by material and process. A CO2 laser is an option for acrylic contour cutting; a CNC router handles suitable board cutting and routed details. Send your artwork and material specifications so we can test the required finish.</p></details>
    <details><summary>Do I need a camera to cut plain acrylic letters?</summary><p>The camera option is intended for workflows such as aligning cuts to printed graphics. Plain acrylic shapes cut from a vector design do not use that printed-registration workflow. We will confirm the configuration for your application.</p></details>
    <details><summary>Can I print and cut using one machine?</summary><p>The setup shown here uses a UV flatbed printer for printing and a separate camera-equipped CO2 laser for cutting. We can help coordinate the two stages and test your sample.</p></details>
    <details><summary>Can you test my material before I order?</summary><p>Yes. Request a free sample test and send your artwork, material, thickness and desired result. Our team will confirm the test arrangements; any sample shipping arrangements are agreed separately.</p></details>
    <details><summary>What information do you need for a quotation?</summary><p>Send your material and thickness, largest part or sheet size, artwork or sample photos, production needs and destination country. Include any machines you already use.</p></details>
    </div></div></section>
  <section class="dd-signage__section" id="SignageContact"><div class="dd-signage__wrap dd-signage__split"><div><p class="dd-signage__eyebrow">TELL US WHAT YOU WANT TO MAKE</p><h2>Get an equipment proposal for your sign shop</h2><p>Share your material, thickness, finished size and production requirements. We will help you plan the equipment and a free sample test.</p><p><a href="mailto:info@gzcnc-laser.com">info@gzcnc-laser.com</a><br><a href="https://wa.me/8618988946615">WhatsApp: +86 189 8894 6615</a></p><p class="dd-signage__note">Need to share artwork or photos? Send them by email or WhatsApp. Name, email and message are required.</p></div>
    {% form 'contact', id: form_id %}
      <input type="hidden" name="contact[Source]" value="Signage and advertising industry page">
      {% if form.posted_successfully? %}<div class="dd-signage__success" role="status" tabindex="-1" data-signage-success><strong>Thank you — your inquiry has been sent.</strong><p>Our team will review your requirements and contact you by email. You do not need to submit the same inquiry again.</p></div><dialog data-signage-dialog aria-labelledby="SignageSuccessTitle"><h2 id="SignageSuccessTitle">Inquiry sent successfully</h2><p>Thank you for contacting Dragon Diamond. Our team will review your requirements and contact you by email.</p><button type="button" class="dd-signage__button" data-signage-close>Got it</button></dialog>{% endif %}
      {% if form.errors %}<div role="alert">{{ form.errors | default_errors }}</div>{% endif %}
      <div class="dd-signage__fields"><div><label for="SignName-{{ section.id }}">Name *</label><input id="SignName-{{ section.id }}" name="contact[name]" autocomplete="name" value="{{ form.name | escape }}" required></div><div><label for="SignEmail-{{ section.id }}">Email *</label><input id="SignEmail-{{ section.id }}" name="contact[email]" type="email" autocomplete="email" value="{{ form.email | escape }}" required></div><div><label for="SignCompany-{{ section.id }}">Company</label><input id="SignCompany-{{ section.id }}" name="contact[Company]" autocomplete="organization" value="{{ form.Company | escape }}"></div><div><label for="SignWA-{{ section.id }}">WhatsApp</label><input id="SignWA-{{ section.id }}" name="contact[WhatsApp]" type="tel" autocomplete="tel" value="{{ form.WhatsApp | escape }}"></div></div>
      <label for="SignProduct-{{ section.id }}">Product Interested</label><select id="SignProduct-{{ section.id }}" name="contact[Product Interested]"><option>Signage equipment combination / need advice</option>{% for name in machine_names %}<option>{{ name }}</option>{% endfor %}<option>Metal sign production equipment</option></select>
      <label for="SignMessage-{{ section.id }}">Message *</label><textarea id="SignMessage-{{ section.id }}" name="contact[body]" rows="5" placeholder="Material, thickness, finished size, production needs and destination country..." required>{{ form.body | escape }}</textarea><button type="submit" class="dd-signage__button">Send Inquiry</button>
    {% endform %}
  </div></section>
</div>
<script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":{{ request.origin | append: routes.root_url | json }}},{"@type":"ListItem","position":2,"name":"Signage & Advertising","item":{{ canonical_url | json }}}]}</script>
{% stylesheet %}
.dd-signage{color:#163237;background:#fff;font-family:Arial,sans-serif;font-size:17px;line-height:1.65}.dd-signage *{box-sizing:border-box}.dd-signage__wrap{max-width:1280px;margin:auto;padding:0 32px}.dd-signage__section{padding:76px 0}.dd-signage__tint{background:#eff5f4}.dd-signage__hero{background:#14373b;color:#fff;padding:135px 0 64px}.dd-signage__crumb{display:flex;gap:12px;flex-wrap:wrap;font-size:13px;margin-bottom:44px}.dd-signage .dd-signage__hero a{color:#80e0d7}.dd-signage__split{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:start}.dd-signage__hero .dd-signage__split{align-items:center}.dd-signage h1,.dd-signage h2,.dd-signage h3{font-family:var(--font-heading--family,Arial,sans-serif);color:inherit;letter-spacing:-.025em;line-height:1.16;margin:0 0 20px}.dd-signage h1{font-size:clamp(36px,3.4vw,54px)}.dd-signage h2{font-size:clamp(28px,2.6vw,38px)}.dd-signage h3{font-size:23px;margin-bottom:14px}.dd-signage p{margin:0 0 20px}.dd-signage__eyebrow{font-size:12px;font-weight:700;letter-spacing:2px;color:#087d83}.dd-signage__hero .dd-signage__eyebrow{color:#80e0d7}.dd-signage__lead{font-size:19px}.dd-signage__intro{max-width:800px}.dd-signage__actions{display:flex;align-items:center;gap:22px;flex-wrap:wrap;margin:28px 0}.dd-signage a{color:#08777b;text-underline-offset:4px}.dd-signage__button{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:13px 20px;background:#087c80;color:#fff!important;border:0;border-radius:4px;font:700 15px/1.4 Arial,sans-serif;text-decoration:none;cursor:pointer;text-align:center}.dd-signage__hero .dd-signage__button{background:#74dfd3;color:#10383b!important}.dd-signage figure{margin:0}.dd-signage img{display:block;width:100%;height:auto}.dd-signage__hero img{aspect-ratio:4/3;object-fit:cover;border-radius:10px}.dd-signage figcaption,.dd-signage__note{font-size:14px;margin-top:18px!important}.dd-signage__hero figcaption{color:#c4dcde}.dd-signage__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;margin-top:30px}.dd-signage__two{display:grid;grid-template-columns:1fr 1fr;gap:26px;margin-top:30px}.dd-signage__card{border:1px solid #d6e2e2;border-radius:8px;overflow:hidden;background:#fff;display:flex;flex-direction:column}.dd-signage__card img{aspect-ratio:16/10;object-fit:cover}.dd-signage__body{padding:24px;flex:1;display:flex;flex-direction:column}.dd-signage__body>a:last-child{margin-top:auto}.dd-signage__body ul{padding-left:20px;margin:0 0 24px;font-size:15px}.dd-signage__machine>a{background:#e8f0ef}.dd-signage__machine img{object-fit:contain;padding:18px;aspect-ratio:4/3}.dd-signage__panel{padding:26px;background:#fff;border-radius:8px;border-top:3px solid #087f82}.dd-signage__panel p{margin:0}.dd-signage__steps{list-style:none;margin:0;padding:0;border-left:2px solid #83c9c5}.dd-signage__steps li{padding:0 0 20px 26px}.dd-signage__steps li:last-child{padding-bottom:0}.dd-signage__steps h3{font-size:21px}.dd-signage__faq details{border-bottom:1px solid #b9cecc}.dd-signage__faq summary{padding:18px 0;min-height:48px;cursor:pointer;font-weight:700}.dd-signage__faq details p{padding:0 0 16px}.dd-signage__fields{display:grid;grid-template-columns:1fr 1fr;gap:0 18px}.dd-signage label{display:block;margin-bottom:6px;font-size:15px;font-weight:700}.dd-signage input,.dd-signage textarea,.dd-signage select{display:block;width:100%;max-width:100%;min-height:48px;padding:12px;border:1px solid #a8c0c0;border-radius:4px;background:#fff;color:#163237;font:16px/1.4 Arial,sans-serif;margin-bottom:18px}.dd-signage textarea{resize:vertical}.dd-signage [id]{scroll-margin-top:125px}.dd-signage :focus-visible{outline:3px solid #d18b24;outline-offset:4px}.dd-signage__success{padding:20px;background:#e0f5ee;border:2px solid #087c80;margin-bottom:24px;border-radius:6px}.dd-signage dialog{max-width:520px;width:calc(100% - 32px);padding:30px;border:0;border-radius:10px;color:#163237}.dd-signage dialog::backdrop{background:#082429b3}.dd-signage__two img{object-fit:contain;background:#edf3f2}.dd-signage a{overflow-wrap:anywhere}@media(max-width:899px){.dd-signage__wrap{padding:0 22px}.dd-signage__split{grid-template-columns:1fr;gap:32px}.dd-signage__grid{grid-template-columns:1fr}.dd-signage__section{padding:48px 0}.dd-signage__hero{padding-top:105px}.dd-signage__crumb{margin-bottom:28px}.dd-signage__hero img{aspect-ratio:16/10}.dd-signage__machine img{max-height:310px}.dd-signage__two{grid-template-columns:1fr}.dd-signage__body{padding:22px}.dd-signage__actions{align-items:flex-start;flex-direction:column}.dd-signage__fields{grid-template-columns:1fr}}
{% endstylesheet %}
{% javascript %}
function initSignageFeedback(){document.querySelectorAll('[data-signage-dialog]').forEach(dialog=>{if(dialog.dataset.ready)return;dialog.dataset.ready='true';const status=dialog.closest('form').querySelector('[data-signage-success]');dialog.querySelector('[data-signage-close]').addEventListener('click',()=>dialog.close());dialog.addEventListener('close',()=>status.focus());if(typeof dialog.showModal==='function')dialog.showModal();else status.focus();});}
initSignageFeedback();document.addEventListener('shopify:section:load',initSignageFeedback);
{% endjavascript %}
