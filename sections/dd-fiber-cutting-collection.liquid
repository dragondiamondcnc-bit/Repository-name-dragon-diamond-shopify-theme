{% javascript %}
function initFibselectFeedback(){document.querySelectorAll('[data-fibselect-dialog]').forEach(dialog=>{if(dialog.dataset.ready)return;dialog.dataset.ready='true';const status=dialog.closest('form').querySelector('[data-fibselect-success]');dialog.querySelector('[data-fibselect-close]').addEventListener('click',()=>dialog.close());dialog.addEventListener('close',()=>status.focus());if(typeof dialog.showModal==='function')dialog.showModal();else status.focus();});}
initFibselectFeedback();document.addEventListener('shopify:section:load',initFibselectFeedback);
{% endjavascript %}
