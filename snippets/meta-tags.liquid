{% liquid
  assign dd_inquiry_product = false
  if product.tags contains 'b2b-inquiry'
    assign dd_inquiry_product = true
  endif
%}
{% doc %}
  Renders all meta tags for the page including Open Graph, Twitter Cards, and SEO tags.

  @param {object} [product] - The product object, available on product pages for price meta tags.
{% enddoc %}

<meta charset="utf-8">
<meta
  http-equiv="X-UA-Compatible"
  content="IE=edge"
>
<meta
  name="viewport"
  content="width=device-width,initial-scale=1"
>
<meta
  name="view-transition"
  content="same-origin"
>
<meta
  name="theme-color"
  content=""
>

{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name
  assign seo_description = page_description
  if request.page_type == 'page' and seo_description == blank
    case page.handle
      when 'case-studies'
        assign seo_description = 'Explore laser cutting and CNC router customer projects in signage, event decoration and furniture. See factory visits, applications and delivery records.'
      when 'case-study-ethiopia'
        assign seo_description = 'Explore an Ethiopia customer factory visit and equipment training at Dragon Diamond. Discuss your production needs, sample testing and technical support.'
      when 'case-study-georgia'
        assign seo_description = 'Explore a Georgia furniture manufacturing customer project with Dragon Diamond. Review CNC equipment planning and discuss your own woodworking requirements.'
    endcase
    if seo_description != blank
      assign og_description = seo_description
    endif
  endif
  if request.page_type == 'index'
    assign og_title = 'dd_home.seo_title' | t
    assign og_description = 'dd_home.seo_description' | t
    assign seo_description = og_description
  endif
  if request.page_type == 'page' and template.suffix == 'industry-signage'
    assign og_title = 'Sign Making Machines: Laser, CNC & UV Printing'
    assign og_description = 'Explore CO2 laser cutters, CNC routers and UV printers for acrylic signs and printed graphics. Get equipment advice and a free sample test from Dragon Diamond.'
    assign seo_description = og_description
  endif
  if request.page_type == 'page' and template.suffix == 'industry-display'
    assign og_title = 'CNC & Laser Machines for Displays and Event Decor'
    assign og_description = 'Plan CNC routing, laser cutting and UV printing for display panels and event decor. Explore a real Israel customer project and request a free sample test.'
    assign seo_description = og_description
  endif
  if request.page_type == 'page' and template.suffix == 'industry-furniture'
    assign og_title = 'CNC Routers for Furniture Parts & Woodworking'
    assign og_description = 'Explore CNC routing for furniture parts and decorative panels. Compare workholding options, see a Georgia customer project and request a free sample test.'
    assign seo_description = og_description
  endif
  if request.page_type == 'page' and template.suffix == 'industry-crafts'
    assign og_title = 'Laser Marking & Cutting Machines for Crafts and Gifts'
    assign og_description = 'Compare fiber, CO2 and UV laser marking for personalized gifts and laser cutting for acrylic and wood crafts. Explore samples and request a free sample test.'
    assign seo_description = og_description
  endif
  if request.page_type == 'page' and template.suffix == 'industry-textile'
    assign og_title = 'Vision Laser Cutting for Printed Fabrics & Textiles'
    assign og_description = 'Explore panoramic vision fabric cutting with the LZ-1816L. Compare standard conveyor and optional roll feeding, see samples and request a free sample test.'
    assign seo_description = og_description
  endif
  if request.page_type == 'page' and template.suffix == 'factory'
    assign og_title = 'Laser & CNC Equipment Factory in Guangzhou'
    assign og_description = 'Explore Dragon Diamond workshop, team, customer visits, exhibitions and container loading. Established in 2012 in Guangzhou. Arrange a visit or free sample test.'
    assign seo_description = og_description
  endif
  assign six_model = ''
  if request.page_type == 'product'
    if template.suffix == 'lz-1390-six' and product.handle == 'lz-1390-industrial-co2-laser-cutting-machine'
      assign six_model = 'laser'
    elsif template.suffix == 'lz-1325-six' and product.handle == 'lz-1325-cnc-router'
      assign six_model = 'router'
    endif
  endif
  if six_model != blank
    assign seo_prefix = 'dd_product.' | append: six_model
    assign seo_title_key = seo_prefix | append: '.title'
    assign seo_description_key = seo_prefix | append: '.intro'
    assign og_title = seo_title_key | t
    assign og_description = seo_description_key | t
    assign seo_description = og_description
  endif

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta
  property="og:site_name"
  content="{{ shop.name }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape_once }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape_once }}"
>

{%- if page_image -%}
  <meta
    property="og:image"
    content="http:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:width"
    content="{{ page_image.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ page_image.height }}"
  >
{%- endif -%}

{%- if request.page_type == 'product' and product.handle != 'lz-1325-cnc-router' and six_model == blank and dd_inquiry_product == false -%}
  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta
    name="twitter:site"
    content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}"
  >
{%- endif -%}
<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape_once }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape_once }}"
>

<title>
  {{ og_title | escape_once }}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
  {%- assign normalized_seo_title = og_title | downcase -%}
  {%- assign normalized_shop_name = shop.name | downcase -%}
  {%- unless normalized_seo_title contains 'dragon diamond' or normalized_seo_title contains normalized_shop_name %} &ndash; {{ shop.name }}{% endunless -%}
</title>

<link
  rel="canonical"
  href="{{ canonical_url }}"
>

{% if seo_description %}
  <meta
    name="description"
    content="{{ seo_description | escape_once }}"
  >
{% endif %}
