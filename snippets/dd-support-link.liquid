{% doc %}Renders the equipment technical support entry point.{% enddoc %}<aside class="dd-support-entry"><p>{{ 'dd_support.intro' | t }}</p><a href="{{ routes.root_url }}pages/support">{{ 'dd_support.link' | t }}</a></aside>{% stylesheet %}.dd-support-entry{max-width:1240px;margin:24px auto;padding:24px;color:#17343b;font:17px/1.6 Arial,sans-serif}.dd-support-entry p{margin:0 0 8px}.dd-support-entry a{color:#087c83;font-weight:bold;text-underline-offset:4px}.dd-support-entry a:focus-visible{outline:3px solid #dca038;outline-offset:4px}{% endstylesheet %}