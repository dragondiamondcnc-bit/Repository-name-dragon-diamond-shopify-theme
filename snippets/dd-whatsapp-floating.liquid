{% doc %}
  Renders the temporary Dragon Diamond floating WhatsApp engineering support link.
{% enddoc %}

<a
  class="dd-whatsapp-floating"
  href="https://wa.me/YOUR_NUMBER"
  target="_blank"
  rel="noopener noreferrer"
  aria-label="WhatsApp - Discuss Your Project"
  data-button-position="floating"
>
  <span class="dd-whatsapp-floating__icon" aria-hidden="true">
    <svg viewBox="0 0 20 20" width="20" height="20" focusable="false">
      {% render 'icon', icon: 'whatsapp' %}
    </svg>
  </span>
  <span class="dd-whatsapp-floating__copy">
    <span class="dd-whatsapp-floating__channel">WhatsApp</span>
    <span class="dd-whatsapp-floating__support">Discuss Your Project</span>
  </span>
</a>

{% stylesheet %}
  .dd-whatsapp-floating {
    position: fixed;
    right: 32px;
    bottom: 40px;
    z-index: 50;
    display: grid;
    min-width: 180px;
    grid-template-columns: 20px minmax(0, 1fr);
    gap: 10px;
    align-items: center;
    padding: 10px 14px 10px 12px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-left: 2px solid #00a3ad;
    background: #0f1115;
    color: #ffffff;
    font-family: 'Archivo Narrow', 'Arial Narrow', Arial, sans-serif;
    line-height: 1.2;
    text-align: left;
    text-decoration: none;
  }

  .dd-whatsapp-floating:hover {
    border-color: rgba(255, 255, 255, 0.32);
    border-left-color: #00a3ad;
    background: #15191e;
    color: #ffffff;
  }

  .dd-whatsapp-floating:focus-visible {
    outline: 2px solid #00a3ad;
    outline-offset: 3px;
  }

  .dd-whatsapp-floating__icon {
    display: flex;
    width: 20px;
    height: 20px;
    align-items: center;
    justify-content: center;
    color: #25d366;
  }

  .dd-whatsapp-floating__icon svg {
    display: block;
    width: 20px;
    height: 20px;
    fill: currentcolor;
  }

  .dd-whatsapp-floating__copy {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .dd-whatsapp-floating__channel {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .dd-whatsapp-floating__support {
    color: rgba(255, 255, 255, 0.72);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  @media (max-width: 640px) {
    .dd-whatsapp-floating {
      right: 16px;
      bottom: 24px;
      min-width: 168px;
      grid-template-columns: 18px minmax(0, 1fr);
      gap: 9px;
      padding: 9px 12px 9px 10px;
    }

    .dd-whatsapp-floating__icon,
    .dd-whatsapp-floating__icon svg {
      width: 18px;
      height: 18px;
    }

    .dd-whatsapp-floating__support {
      font-size: 10px;
    }
  }
{% endstylesheet %}
